{
  "name": "atomes",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/astro/bin/astro.mjs dev --host 127.0.0.1",
    "build": "astro build && bun build src/lib/backup/cli.ts --target=node --outfile=dist/backup.mjs",
    "preview": "astro preview",
    "phone": "node --env-file=.env.phone scripts/check-settings.ts && astro build && HOST=127.0.0.1 PORT=4321 node --env-file=.env.phone dist/server/entry.mjs",
    "check": "astro check",
    "test": "vitest run",
    "lint": "eslint .",
    "astro": "astro",
    "reset": "bun scripts/reset-env.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/preact": "^6.1.2",
    "@atproto/lexicon": "^0.7.19",
    "@atproto/oauth-client-node": "^0.5.16",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@lucide/astro": "^1.68.0",
    "astro": "^7.4.5",
    "barcode-detector": "3.2.3",
    "preact": "^11.2.0",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@atproto/syntax": "^0.7.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
