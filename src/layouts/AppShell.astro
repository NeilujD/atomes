---
// The app frame. Desktop: sidebar and view header form an inverted L around one
// content panel. Phone: large title on top, tab bar under the thumb.
// Behaviour rules: docs/design/ui-direction.md.
import '@fontsource-variable/schibsted-grotesk';
import '../styles/theme.css';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icons';

type Section = 'home' | 'library' | 'new' | 'to-buy' | 'check' | 'settings';

interface Props {
  title: string;
  current: Section;
}

const { title, current } = Astro.props;

const sidebarItems: { key: Section; href: string; label: string; icon: IconName }[] = [
  { key: 'home', href: '/', label: 'Home', icon: 'house' },
  { key: 'library', href: '/library', label: 'Library', icon: 'library' },
  { key: 'new', href: '/new', label: 'New & upcoming', icon: 'bell' },
  { key: 'to-buy', href: '/to-buy', label: 'To Buy', icon: 'shopping-bag' },
];

const tabItems: { key: Section; href: string; label: string; icon: IconName }[] = [
  { key: 'home', href: '/', label: 'Home', icon: 'house' },
  { key: 'library', href: '/library', label: 'Library', icon: 'library' },
  { key: 'check', href: '/check', label: 'Check', icon: 'scan-barcode' },
  { key: 'to-buy', href: '/to-buy', label: 'To Buy', icon: 'shopping-bag' },
  { key: 'settings', href: '/settings', label: 'You', icon: 'user' },
];

const ariaCurrent = (key: Section) => (key === current ? 'page' : undefined);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f6f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121317" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Atomes</title>
  </head>
  <body>
    <div class="app">
      <nav class="sidebar" aria-label="Main">
        <div class="sidebar-top">
          <a class="brand" href="/" aria-label="Atomes, Home">
            <svg class="mark" viewBox="220 236 584 552" aria-hidden="true">
              <rect x="236" y="252" width="96" height="520" rx="14" fill="currentColor"></rect>
              <rect x="388" y="252" width="96" height="520" rx="14" fill="currentColor"></rect>
              <rect
                x="551"
                y="263"
                width="74"
                height="498"
                rx="14"
                fill="none"
                stroke="currentColor"
                stroke-width="22"
                stroke-dasharray="52 34"
                stroke-linecap="round"></rect>
              <rect x="692" y="252" width="96" height="520" rx="14" fill="var(--accent)"></rect>
            </svg>
            <span>Atomes</span>
          </a>
          <a class="icon-button" href="/library" aria-label="Search the Library">
            <Icon name="search" />
          </a>
        </div>

        <a class="check-button" href="/check" aria-current={ariaCurrent('check')}>
          <Icon name="scan-barcode" />
          <span>Check a book</span>
        </a>

        <ul class="nav-list">
          {
            sidebarItems.map((item) => (
              <li>
                <a class="nav-item" href={item.href} aria-current={ariaCurrent(item.key)}>
                  <Icon name={item.icon} />
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="sidebar-bottom">
          <a class="nav-item" href="/settings" aria-current={ariaCurrent('settings')}>
            <Icon name="settings" />
            <span>Settings</span>
          </a>
          <p class="privacy">
            <Icon name="lock" size={14} />
            <span>Private by default</span>
          </p>
        </div>
      </nav>

      <main class="panel">
        <header class="view-header">
          <h1 class="view-title">{title}</h1>
          <slot name="actions" />
        </header>
        <div class="view-body">
          <slot />
        </div>
      </main>

      <nav class="tabbar" aria-label="Main">
        {
          tabItems.map((item) => (
            <a
              class:list={['tab', { 'tab-check': item.key === 'check' }]}
              href={item.href}
              aria-current={ariaCurrent(item.key)}
            >
              <span class="tab-icon">
                <Icon name={item.icon} size={22} />
              </span>
              <span class:list={{ 'visually-hidden': item.key === 'check' }}>{item.label}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </body>
</html>

<style>
  /* Phone first: no sidebar, large title, tab bar. */
  .sidebar {
    display: none;
  }

  .view-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 28px 20px 24px;
    padding-top: max(28px, env(safe-area-inset-top));
  }

  .view-title {
    font-size: 28px;
    letter-spacing: -0.03em;
  }

  .view-body {
    padding: 0 20px calc(96px + env(safe-area-inset-bottom));
  }

  .tabbar {
    position: fixed;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    padding: 6px 8px calc(6px + env(safe-area-inset-bottom));
    background: var(--surface);
    border-top: 1px solid var(--line);
  }

  .tab {
    flex: 1;
    min-height: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    color: var(--secondary);
    font-size: 11px;
    font-weight: 500;
    text-decoration: none;
  }

  .tab[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  /* Shelf Check is the one action used standing in a shop: biggest target, under the thumb. */
  .tab-check .tab-icon {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--surface);
  }

  /* Desktop: inverted L (sidebar + view header) around one panel. */
  @media (min-width: 960px) {
    .app {
      display: grid;
      grid-template-columns: 232px minmax(0, 1fr);
      height: 100dvh;
    }

    .tabbar {
      display: none;
    }

    .sidebar {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 10px 8px 12px 12px;
      overflow-y: auto;
    }

    .panel {
      margin: 8px 8px 8px 0;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-panel);
      overflow-y: auto;
    }

    .view-header {
      position: sticky;
      top: 0;
      z-index: 1;
      min-height: 48px;
      padding: 0 24px;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
    }

    .view-title {
      font-size: 15px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .view-body {
      padding: 24px;
    }
  }

  .sidebar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--row);
    padding-left: 8px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .mark {
    width: 18px;
    height: 18px;
  }

  .icon-button {
    width: var(--row);
    height: var(--row);
    display: grid;
    place-items: center;
    border-radius: var(--radius-control);
    color: var(--secondary);
  }

  .check-button {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--row);
    padding: 0 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--surface);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--row);
    padding: 0 8px;
    border-radius: var(--radius-control);
    color: var(--secondary);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .nav-item[aria-current='page'] {
    background: var(--soft);
    color: var(--ink);
  }

  .nav-item:hover,
  .icon-button:hover,
  .check-button:hover {
    background: var(--soft);
    color: var(--ink);
  }

  .sidebar-bottom {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .privacy {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 8px;
    color: var(--secondary);
    font-size: 12px;
  }
</style>
