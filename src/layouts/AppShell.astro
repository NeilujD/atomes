---
// The app frame. Desktop: sidebar and view header form an inverted L around one
// content panel. Phone: large title on top, tab bar under the thumb.
// Behaviour rules: docs/design/ui-direction.md.
import '@fontsource-variable/schibsted-grotesk';
import '../styles/theme.css';
import '../styles/page-transitions.css';
import ConnectionStatus from '../components/ConnectionStatus.astro';
import EnvironmentBadge from '../components/EnvironmentBadge.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import PageHead from '../components/PageHead.astro';
import type { IconName } from '../components/icons';
import { bootScript } from '../lib/appearance';
import { gateBootScript } from '../lib/auth/gate-boot';
import { pageTransitionScript } from '../lib/page-transition';
import { requestLanguage, translator } from '../lib/i18n/i18n';
import { landingPage } from '../lib/server/settings';

type Section = 'home' | 'library' | 'new' | 'to-buy' | 'statistics' | 'check' | 'settings';

interface Props {
  title: string;
  // The navigation item to mark as current; none for a page outside the navigation.
  current?: Section;
  // Detail page (Book, Series): the content has its own large title, so the
  // phone does not show the view title above it.
  detail?: boolean;
  // Flow screen (sign-in): no sidebar, no tab bar, the content centred. The
  // page brings its own heading (ui-direction: Flow).
  flow?: boolean;
}

const { title, current, detail = false, flow = false } = Astro.props;
// <html lang> tells the page scripts which language to use (src/lib/i18n).
const language = requestLanguage(Astro.request);
const t = translator(language);
// Before first paint: the forced theme, on every screen but the sign-in screen
// the screen hidden until the gate answers (src/lib/auth/gate-boot.ts), and the
// page transitions (src/lib/page-transition.ts). Flow screens need them too:
// they keep the previous page right for the next transition.
const boot = (flow ? bootScript : bootScript + gateBootScript) + pageTransitionScript;

// New & upcoming stays out until its screen exists (CORE-68): no link to a missing page.
const sidebarItems: { key: Section; href: string; label: string; icon: IconName }[] = [
  { key: 'home', href: '/', label: t('nav.home'), icon: 'house' },
  { key: 'library', href: '/library', label: t('nav.library'), icon: 'library' },
  { key: 'to-buy', href: '/to-buy', label: t('nav.to-buy'), icon: 'shopping-bag' },
  { key: 'statistics', href: '/statistics', label: t('nav.statistics'), icon: 'chart-column' },
];

// The Check tab and "Check a book" open the camera at once (CORE-97): in a shop,
// the scanner is what the reader wants. src/pages/check.astro reads `scan=1`.
const checkHref = '/check?scan=1';

const tabItems: { key: Section; href: string; label: string; icon: IconName }[] = [
  { key: 'home', href: '/', label: t('nav.home'), icon: 'house' },
  { key: 'library', href: '/library', label: t('nav.library'), icon: 'library' },
  { key: 'check', href: checkHref, label: t('nav.check'), icon: 'scan-barcode' },
  { key: 'to-buy', href: '/to-buy', label: t('nav.to-buy'), icon: 'shopping-bag' },
  { key: 'settings', href: '/settings', label: t('nav.you'), icon: 'user' },
];

// The gate sends a visitor with no session from Home to the Landing page, when the instance has it (M12).
const landing = landingPage(process.env) ? 'on' : undefined;
const ariaCurrent = (key: Section) => (key === current ? 'page' : undefined);
// The tab bar keeps five entries (ui-direction): Statistics is reached from
// You, so You shows as the place the reader is in.
const tabCurrent = (key: Section) => ariaCurrent(key) ?? (key === 'settings' && current === 'statistics' ? 'true' : undefined);
---

<html lang={language} data-landing={landing}>
  <head>
    <PageHead title={`${title} · Atomes`} boot={boot}>
      <link rel="manifest" href="/manifest.webmanifest" />
      <!-- The new page of a transition shows only once its body is parsed (src/lib/page-transition.ts). -->
      <link rel="expect" href="#page-end" blocking="render" />
    </PageHead>
  </head>
  <body>
    {
      !flow && (
        <div class="gate-wait" data-state="working" role="status">
          <Mark size={48} animated />
          <span class="visually-hidden">{t('gate.waiting')}</span>
        </div>
      )
    }
    <div class="app">
      {
        flow ? (
          <main class="flow">
            <EnvironmentBadge place="flow" />
            <div class="flow-content">
              <slot />
            </div>
          </main>
        ) : (
          <>
          <nav class="sidebar" data-frame="sidebar" aria-label={t('nav.main')}>
            <div class="sidebar-top">
              <a class="brand" href="/" aria-label={t('nav.brand')}>
                <Mark size={18} />
                <span>Atomes</span>
              </a>
              <EnvironmentBadge place="sidebar" />
              <a class="frame-icon" href="/library" aria-label={t('nav.search')}>
                <Icon name="search" />
              </a>
            </div>

            <a class="check-button" href={checkHref} aria-current={ariaCurrent('check')}>
              <Icon name="scan-barcode" />
              <span>{t('nav.check-book')}</span>
            </a>

            <ul class="nav-list">
              {
                sidebarItems.map((item) => (
                  <li>
                    <a class="nav-item" href={item.href} aria-current={ariaCurrent(item.key)}>
                      <Icon name={item.icon} />
                      <span>{item.label}</span>
                    </a>
                  </li>
                ))
              }
            </ul>

            <div class="sidebar-bottom">
              <ConnectionStatus place="sidebar" />
              <a class="nav-item" href="/settings" aria-current={ariaCurrent('settings')}>
                <Icon name="settings" />
                <span>{t('nav.settings')}</span>
              </a>
              <button class="nav-item" type="button" data-nav-sign-out>
                <Icon name="log-out" />
                <span>{t('settings.sign-out')}</span>
              </button>
              <p class="privacy">
                <Icon name="lock" size={14} />
                <span>{t('nav.private')}</span>
              </p>
            </div>
          </nav>

          <main class="panel" data-frame="panel">
            <EnvironmentBadge place="top" />
            <header class:list={['view-header', { detail }]}>
              <div class="view-heading">
                {
                  detail && (
                    <a class="frame-icon back" href="/library" aria-label={t('nav.back')} data-back>
                      <Icon name="arrow-left" />
                    </a>
                  )
                }
                <h1 class="view-title" data-view-title>{title}</h1>
              </div>
              <slot name="actions" />
            </header>
            <div class="view-body">
              <slot />
            </div>
          </main>

          <div class="bottom" data-frame="bottom">
            <ConnectionStatus place="bar" />
            <nav class="tabbar" aria-label={t('nav.main')}>
              {
                tabItems.map((item) => (
                  <a
                    class:list={['tab', { 'tab-check': item.key === 'check' }]}
                    href={item.href}
                    aria-current={tabCurrent(item.key)}
                  >
                    <span class="tab-icon">
                      <Icon name={item.icon} size={22} />
                    </span>
                    <span class:list={{ 'visually-hidden': item.key === 'check' }}>{item.label}</span>
                  </a>
                ))
              }
            </nav>
          </div>
          </>
        )
      }

      <!-- Asked before every sign-out (src/lib/auth/confirm-sign-out.ts). -->
      <dialog class="confirm" data-sign-out-dialog aria-labelledby="sign-out-title" aria-describedby="sign-out-text">
        <form method="dialog">
          <h2 class="confirm-title" id="sign-out-title">{t('signout.title')}</h2>
          <p class="confirm-text" id="sign-out-text">{t('signout.text')}</p>
          <div class="confirm-actions">
            <button class="button" value="cancel">{t('signout.cancel')}</button>
            <button class="button button-main" value="confirm">{t('settings.sign-out')}</button>
          </div>
        </form>
      </dialog>

      <!-- Toasts (src/lib/toast.ts): results over the page, so the content does not move. -->
      <div class="toasts" data-toasts role="status" aria-live="polite"></div>
      <template data-toast-template>
        <div class="toast" data-toast>
          <p class="toast-text" data-toast-text></p>
          <button class="toast-action" type="button" data-toast-action hidden></button>
          <button class="toast-close" type="button" aria-label={t('common.close')} data-toast-close>
            <Icon name="x" />
          </button>
        </div>
      </template>
    </div>
    <span id="page-end" hidden />
  </body>
</html>

<script>
  import { applyAppearance, applyContrast, readAppearance, readContrast } from '../lib/appearance';
  import { openPaths } from '../lib/auth/return-to';
  import { confirmSignOut } from '../lib/auth/confirm-sign-out';
  import { gateScreen, signOutHere } from '../lib/auth/server-client';
  import { startBackArrow } from '../lib/back';
  import { startConnectionStatus } from '../lib/connection';
  import { toast } from '../lib/toast';

  // Every screen but the sign-in screen and the privacy notice needs a
  // signed-in reader (ADR 0013, amendment 2026-11-12). Checked here, not on
  // the server: see gate() in src/lib/auth/session.ts.
  if (!openPaths.includes(location.pathname)) void gateScreen();

  // Sidebar Sign out (desktop; on the phone it is in Settings). A message that
  // must be read first stays as an error toast; else the sign-in screen opens.
  const signOutButton = document.querySelector<HTMLButtonElement>('[data-nav-sign-out]');
  signOutButton?.addEventListener('click', () => {
    void confirmSignOut().then(async (confirmed) => {
      if (!confirmed) return;
      signOutButton.disabled = true;
      const message = await signOutHere();
      if (message) toast(message, { error: true });
    });
  });

  startConnectionStatus();
  startBackArrow();

  // Keep the theme-color metas right, follow the system while open, and follow
  // a change of Appearance or contrast made in Settings in another tab.
  const systemDark = matchMedia('(prefers-color-scheme: dark)');
  const sync = () => {
    applyAppearance(document, readAppearance(), systemDark.matches);
    applyContrast(document, readContrast());
  };
  sync();
  systemDark.addEventListener('change', sync);
  addEventListener('storage', sync);

  // Dev serves unbundled modules that change on every edit: cache only a build.
  if (import.meta.env.PROD && 'serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js').catch((error: unknown) => {
      console.error('Service worker registration failed', error);
    });
  } else if ('serviceWorker' in navigator) {
    // A build run earlier on this origin (`bun run phone`) left its worker. Offline,
    // it would serve the page without the dev modules, so no script runs.
    void navigator.serviceWorker.getRegistrations().then((workers) => workers.forEach((worker) => void worker.unregister()));
  }
</script>

<style>
  /* Hidden until the gate answers (src/lib/auth/gate-boot.ts): a signed-out
     visitor goes to the sign-in screen without seeing this one. */
  :global(:root[data-gate='pending']) .app {
    visibility: hidden;
  }

  /* The mark working in its place. It fades in only after 500 ms, so a fast
     answer never flickers. */
  .gate-wait {
    display: none;
  }

  :global(:root[data-gate='pending']) .gate-wait {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    animation: gate-wait-in 200ms ease-out 500ms both;
  }

  @keyframes gate-wait-in {
    from {
      opacity: 0;
    }
  }

  /* Flow (sign-in, Series Onboarding): no chrome; the content in the middle of
     the window. The environment badge, outside production, takes the first
     row and scrolls away with the page; with no badge the row is empty. */
  .flow {
    grid-column: 1 / -1;
    min-height: 100dvh;
    display: grid;
    /* minmax(0, …): the column never grows past the screen to fit its content. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    padding: max(24px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom));
  }

  .flow-content {
    grid-row: 2;
    display: grid;
    place-items: center;
  }

  /* Phone first: no sidebar, large title, tab bar. */
  .sidebar {
    display: none;
  }

  /* Phone: the panel is at least as high as the window, so a short page covers
     the screen in a page transition. The height comes from the window (100 %),
     never from viewport units: on an Android phone 100dvh can be taller than
     the window, and a page with almost nothing on it then scrolls. */
  @media (max-width: 959.98px) {
    :global(html),
    :global(body) {
      height: 100%;
    }

    .app {
      display: flex;
      flex-direction: column;
      min-height: 100%;
    }

    .panel {
      flex: 1 0 auto;
    }
  }

  .view-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 28px 20px 24px;
    padding-top: max(28px, env(safe-area-inset-top));
  }

  .view-heading {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }

  /* Detail pages: before the title, and still there on the phone, where the
     title is hidden. The arrow, not its hit area, lines up with the content. */
  .back {
    margin-left: calc((16px - var(--row)) / 2);
  }

  .view-title {
    font-size: 28px;
    letter-spacing: -0.03em;
  }

  /* Phone: the back arrow sticks at the top while the page scrolls, a round
     button on the ground so it reads over a cover. Taps around it pass through
     to the page, since the rest of the header is empty. */
  @media (max-width: 959.98px) {
    .view-header.detail {
      position: sticky;
      top: 0;
      z-index: 3;
      padding-bottom: 8px;
      pointer-events: none;
    }

    .view-header.detail .back {
      margin-left: 0;
      border: var(--hairline) solid var(--line-control);
      border-radius: var(--radius-pill);
      background: var(--surface);
      color: var(--ink);
      pointer-events: auto;
    }

    .view-header.detail .view-title {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .view-body {
    padding: 0 20px calc(96px + env(safe-area-inset-bottom));
  }

  /* Phone: the environment pill already takes the safe area. */
  @media (max-width: 959.98px) {
    :global(.environment.top) + .view-header {
      padding-top: 12px;
    }
  }

  /* Phone: the connection strip (when offline) and the tab bar, fixed under the thumb. */
  .bottom {
    position: fixed;
    inset: auto 0 0;
    z-index: 5;
  }

  .tabbar {
    display: flex;
    align-items: center;
    padding: 6px 8px calc(6px + env(safe-area-inset-bottom));
    background: var(--surface);
    border-top: 1px solid var(--line);
  }

  .tab {
    flex: 1;
    min-height: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    color: var(--secondary);
    font-size: 11px;
    font-weight: 500;
    text-decoration: none;
  }

  .tab[aria-current] {
    color: var(--ink);
    font-weight: 600;
  }

  /* Shelf Check is the one action used standing in a shop: biggest target, under the thumb. */
  .tab-check .tab-icon {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--surface);
  }

  /* Desktop: inverted L (sidebar + view header) around one panel. */
  @media (min-width: 960px) {
    .app {
      display: grid;
      grid-template-columns: 232px minmax(0, 1fr);
      height: 100dvh;
    }

    .bottom {
      display: none;
    }

    .sidebar {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 10px 8px 12px 12px;
      overflow-y: auto;
    }

    .panel {
      margin: 8px 8px 8px 0;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-panel);
      overflow-y: auto;
    }

    .view-header {
      position: sticky;
      top: 0;
      z-index: 1;
      min-height: 48px;
      padding: 0 24px;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
    }

    .view-title {
      font-size: 15px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .view-body {
      padding: 24px;
    }
  }

  .sidebar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--row);
    padding-left: 8px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .frame-icon {
    width: var(--row);
    height: var(--row);
    display: grid;
    place-items: center;
    border-radius: var(--radius-control);
    color: var(--secondary);
  }

  .check-button {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--row);
    padding: 0 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--surface);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--row);
    padding: 0 8px;
    border-radius: var(--radius-control);
    color: var(--secondary);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  button.nav-item {
    width: 100%;
    border: 0;
    background: transparent;
    font-family: inherit;
    cursor: pointer;
  }

  .nav-item[aria-current='page'] {
    background: var(--soft);
    color: var(--ink);
  }

  .nav-item:hover,
  .frame-icon:hover,
  .check-button:hover {
    background: var(--soft);
    color: var(--ink);
  }

  .sidebar-bottom {
    position: relative;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .privacy {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 8px;
    color: var(--secondary);
    font-size: 12px;
  }

  /* Phone: centred above the tab bar. Desktop: bottom right of the panel. */
  .toasts {
    position: fixed;
    inset: auto 16px calc(80px + env(safe-area-inset-bottom));
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    pointer-events: none;
  }

  @media (min-width: 960px) {
    .toasts {
      inset: auto 24px 24px auto;
      align-items: flex-end;
    }
  }

  .toast {
    width: min(100%, 400px);
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 10px 6px 10px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--surface);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 8px 24px rgb(0 0 0 / 0.14);
    font-size: 14px;
    pointer-events: auto;
    animation: toast-in 180ms ease-out;
  }

  /* An error stands out by its weight and stays; --danger is for actions that destroy, not errors (ui-direction: colour roles). */
  .toast[data-error] {
    border-color: var(--ink);
    font-weight: 500;
  }

  .toast-text {
    flex: 1;
    min-width: 0;
    padding-top: 2px;
  }

  .toast-text :global(a) {
    color: var(--accent);
    font-weight: 600;
  }

  /* Undo and the like: a text button, the one action of the toast. */
  .toast-action {
    flex: none;
    align-self: center;
    min-height: var(--row);
    margin: -6px 0;
    padding: 0 8px;
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .toast-action:hover {
    background: var(--soft);
  }

  .toast-close {
    flex: none;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--secondary);
    cursor: pointer;
  }

  .toast-close:hover {
    background: var(--soft);
    color: var(--ink);
  }

  /* While the phone strip shows, the content and the toasts stay above it. */
  @media (max-width: 959.98px) {
    .app:has(.bottom :global([data-connection-body]:not([hidden]))) .view-body {
      padding-bottom: calc(96px + var(--row) + env(safe-area-inset-bottom));
    }

    .app:has(.bottom :global([data-connection-body]:not([hidden]))) .toasts {
      bottom: calc(80px + var(--row) + env(safe-area-inset-bottom));
    }
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toast {
      animation: none;
    }
  }
</style>
