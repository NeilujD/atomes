---
// Throwaway page (CORE-17): save a short text in the reader's private Space and
// read it back. The browser talks to the PDS directly; this server only sends
// the empty page.
import AppShell from '../../layouts/AppShell.astro';
---

<AppShell title="Space test" current="settings">
  <div class="probe">
    <section class="group">
      <h2 class="group-title">Private Space test</h2>
      <p class="hint" data-probe-status aria-live="polite">Checking your session…</p>
      <a href="/settings" data-probe-sign-in hidden>Sign in on Settings</a>
      <form class="save" data-probe-form hidden>
        <label class="visually-hidden" for="probe-text">Text to save</label>
        <input class="field" id="probe-text" name="text" type="text" maxlength="300" required pattern=".*\S.*" />
        <button class="button" type="submit">Save</button>
      </form>
      <p class="error" data-probe-error role="alert" hidden></p>
    </section>

    <section class="group" data-probe-records hidden>
      <h2 class="group-title">Saved records</h2>
      <p class="hint" data-probe-offline role="status" hidden>
        Offline. This is the copy on this device, from the last time it loaded. It may be out of date.
      </p>
      <p class="hint" data-probe-empty hidden>Nothing saved yet.</p>
      <ul class="records" data-probe-list></ul>
    </section>
  </div>
</AppShell>

<script>
  import { openOwnSpace } from '../../lib/auth/browser-client';
  import { freshListing } from '../../lib/space/fresh-listing';
  import { spaceErrorMessage } from '../../lib/space/space';
  import { listTestItems, saveTestItem, type TestItem } from '../../lib/space/test-item';

  const status = document.querySelector<HTMLElement>('[data-probe-status]')!;
  const signInLink = document.querySelector<HTMLElement>('[data-probe-sign-in]')!;
  const form = document.querySelector<HTMLFormElement>('[data-probe-form]')!;
  const input = form.querySelector<HTMLInputElement>('input[name="text"]')!;
  const error = document.querySelector<HTMLElement>('[data-probe-error]')!;
  const records = document.querySelector<HTMLElement>('[data-probe-records]')!;
  const offline = document.querySelector<HTMLElement>('[data-probe-offline]')!;
  const empty = document.querySelector<HTMLElement>('[data-probe-empty]')!;
  const list = document.querySelector<HTMLElement>('[data-probe-list]')!;

  function showError(cause?: unknown, prefix = '') {
    error.textContent = cause === undefined ? '' : prefix + spaceErrorMessage(cause);
    error.hidden = !error.textContent;
  }

  function render({ items, stale }: { items: TestItem[]; stale: boolean }) {
    offline.hidden = !stale;
    // Fresh records: an earlier "Not saved" from offline no longer applies.
    if (!stale) showError();
    list.replaceChildren(
      ...items.map((item) => {
        const row = document.createElement('li');
        const time = document.createElement('time');
        time.dateTime = item.createdAt;
        time.textContent = new Date(item.createdAt).toLocaleString();
        row.append(item.text, ' ', time);
        return row;
      }),
    );
    empty.hidden = items.length > 0;
    records.hidden = false;
  }

  void openOwnSpace().then(
    async (opened) => {
      if (!opened) {
        status.textContent = 'Sign in first.';
        signInLink.hidden = false;
        return;
      }
      const { account, space } = opened;
      status.textContent = `Signed in as @${account.handle}. Records go to your private Space, not to your public repo.`;
      form.hidden = false;
      // Back online: replaces the local copy with the records on the PDS.
      const listing = freshListing(() => listTestItems(space), render, showError);
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const button = form.querySelector('button')!;
        button.disabled = true;
        showError();
        void saveTestItem(space, input.value)
          .then(() => {
            input.value = '';
            return listing.refresh();
          })
          // Offline saves fail here; nothing is queued.
          .catch((cause: unknown) => showError(cause, 'Not saved. '))
          .finally(() => (button.disabled = false));
      });
      await listing.refresh();
    },
    (cause: unknown) => {
      status.textContent = 'Could not open your session.';
      showError(cause);
    },
  );
</script>

<style>
  .probe {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .group-title {
    font-size: 18px;
  }

  .hint {
    color: var(--secondary);
    font-size: 13px;
  }

  .error {
    color: var(--ink);
    font-size: 13px;
  }

  .save {
    display: flex;
    gap: 8px;
    width: 100%;
    max-width: 480px;
  }

  .field {
    flex: 1;
    min-width: 0;
    min-height: var(--row);
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
  }

  .button {
    min-height: var(--row);
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .button:hover:not(:disabled) {
    background: var(--soft);
  }

  .button:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .records {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0;
    list-style: none;
  }

  .records :global(li) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--row);
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }

  .records :global(time) {
    color: var(--secondary);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 960px) {
    .group-title {
      display: flex;
      align-items: center;
      align-self: stretch;
      min-height: var(--row);
      border-bottom: 1px solid var(--line);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0;
    }
  }
</style>
