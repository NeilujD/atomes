---
// The privacy notice (ADR 0012, ADR 0016, CORE-55): what the instance keeps,
// who can read it, and how to export and delete. Linked from the sign-in
// screen, Settings and the Landing page. In the language of the request
// (cookie, then the browser), French or English.
// Text approved by the owner on 2026-11-19 (`privacy.*` in src/lib/i18n, CORE-162).
// The Admin role and the admin panel (ADR 0020, CORE-167): `privacy.admins*`,
// `privacy.stores-activity`, the mail of an added Account in `privacy.processor-mail`
// and the new date are a draft until the owner approves them in the pull request of M13.
import Notice from '../components/Notice.astro';
import AppShell from '../layouts/AppShell.astro';
import { requestLanguage, translator } from '../lib/i18n/i18n';
import { notGiven } from '../lib/notice';
import { legalFacts, privacyFacts, rybbit } from '../lib/server/settings';

const t = translator(requestLanguage(Astro.request));
// The operator is the publisher of the Legal notice: settings of this instance (LEGAL_*).
const { publisher: operator, contact } = legalFacts(process.env);
// Who helps: settings too (PRIVACY_*); backups only where the instance has them.
const { mailProcessor, backups, backupProcessor } = privacyFacts(process.env);
// Audience measurement, only where the instance has it (RYBBIT_*): named by its host.
const analytics = rybbit(process.env);
const backupText = backupProcessor ? t('privacy.processor-backups', backupProcessor) : notGiven(t, 'PRIVACY_BACKUP_PROCESSOR');

const sections = [
  {
    heading: t('privacy.operator-heading'),
    texts: [operator && contact ? t('privacy.operator', operator, contact) : notGiven(t, !operator && 'LEGAL_PUBLISHER', !contact && 'LEGAL_CONTACT')],
  },
  { heading: t('privacy.stores-heading'), texts: [t('privacy.stores'), t('privacy.stores-activity'), t('privacy.not-kept')] },
  { heading: t('privacy.readers-heading'), texts: [t('privacy.readers')] },
  {
    heading: t('privacy.admins-heading'),
    texts: [t('privacy.admins'), t('privacy.admins-panel'), t('privacy.admins-identity'), t('privacy.admins-log')],
  },
  {
    heading: t('privacy.processors-heading'),
    texts: [
      mailProcessor ? t('privacy.processor-mail', mailProcessor) : notGiven(t, 'PRIVACY_MAIL_PROCESSOR'),
      backups ? backupText : t('privacy.no-backups'),
      ...(analytics ? [t('privacy.processor-analytics', new URL(analytics.origin).host)] : []),
    ],
  },
  { heading: t('privacy.shared-heading'), texts: [t('privacy.shared')] },
  { heading: t('privacy.basis-heading'), texts: [t('privacy.basis')] },
  { heading: t('privacy.rights-heading'), texts: [t('privacy.rights'), ...(backups ? [t('privacy.rights-backups')] : []), t('privacy.requests')] },
];
---

<AppShell title={t('privacy.title')} flow>
  <Notice title={t('privacy.title')} intro={t('privacy.intro')} sections={sections} updated={t('privacy.updated')} />
</AppShell>
