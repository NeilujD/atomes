---
// The Landing page (M12, CORE-157): what Atomes does, why it is built on the
// AT Protocol, who it is built on, and the way in. Public: no session needed.
// Draft English text for the owner's review; CORE-159 moves it to t() with
// French. Spec: "Spec: M12 · Landing page" (Linear).
import '../styles/glow.css';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icons';
import LandingShot from '../components/LandingShot.astro';
import Mark from '../components/Mark.astro';
import Landing from '../layouts/Landing.astro';

const sourceUrl = 'https://github.com/NeilujD/atomes';

const features: { icon: IconName; title: string; text: string }[] = [
  { icon: 'library', title: 'Your Library', text: 'Every book and manga you own or read, in a grid, a list or a cover flow. Search, sort and filter by author, Series, status or Label.' },
  { icon: 'layers', title: 'Series and Edition Lines', text: 'Each Series shows every Volume: owned, read or missing. Each printing of a Series keeps its own line.' },
  { icon: 'scan-barcode', title: 'Quick Add', text: 'Scan the barcode or type the ISBN. Add the earlier Volumes of a Series in one go.' },
  { icon: 'check', title: 'Shelf Check', text: 'In the shop, scan a book: orange, it is on your shelf; green, it is not. It works with no signal.' },
  { icon: 'shopping-bag', title: 'To Buy', text: 'The Missing Volumes of the Series you follow, and the books you note by hand, in one list.' },
  { icon: 'book-open', title: 'Reading Status', text: 'Not yet, Reading, Read or Abandoned, with the day you started and finished.' },
  { icon: 'chart-column', title: 'Statistics', text: 'Books read and added by month, your most read Series and authors, and a picture to share.' },
  { icon: 'handshake', title: 'Loans', text: 'Note who has your book, and since when.' },
  { icon: 'tag', title: 'Labels', text: 'Sort your books your own way: on one book or on a whole Series.' },
  { icon: 'lock', title: 'Private by default', text: 'Only you see your Library. Share by category, with exceptions per book, when you want.' },
  { icon: 'wifi-off', title: 'Works offline', text: 'Add Atomes to your home screen. Your Library and Shelf Check open with no network.' },
  { icon: 'database', title: 'An open Catalog', text: 'Book facts come from open libraries. Readers correct a Series when the sources are wrong.' },
  { icon: 'download', title: 'Your data, always', text: 'Export your whole Library as open records. Delete your Account in one step.' },
  { icon: 'languages', title: 'Your language, your light', text: 'English and French. Light, dark and high contrast.' },
];

const principles: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'user',
    title: 'An account of your choice',
    text: 'Start with an email address: no password, a code each time. Link a Bluesky or other AT Protocol account only if you want to share.',
  },
  {
    icon: 'lock',
    title: 'Private by default',
    text: 'Nothing you add is public. You choose what to share, by category, and you can keep any single book apart.',
  },
  {
    icon: 'server',
    title: 'What you share stays yours',
    text: 'Shared records go to your own Personal Data Server, in open lexicons under the MIT license. Any app can read them; you can leave with them.',
  },
  {
    icon: 'heart',
    title: 'No feed, no ads, no tracking',
    text: 'No timeline, no recommendation engine, no analytics. Atomes does one job: your shelves.',
  },
];

const credits: { name: string; role: string; by: string; href: string }[] = [
  { name: 'Astro', role: 'Web framework', by: 'The Astro team and contributors', href: 'https://astro.build' },
  { name: 'Preact', role: 'Interactive screens', by: 'Jason Miller and contributors', href: 'https://preactjs.com' },
  { name: 'AT Protocol', role: 'Accounts, records, lexicons', by: 'Bluesky Social and contributors', href: 'https://atproto.com' },
  { name: 'Lucide', role: 'Icons', by: 'The Lucide community, from Feather by Cole Bemis', href: 'https://lucide.dev' },
  { name: 'Schibsted Grotesk', role: 'Typeface', by: 'Schibsted, packaged by Fontsource', href: 'https://fontsource.org/fonts/schibsted-grotesk' },
  { name: 'zxing-wasm and barcode-detector', role: 'Barcode reading', by: 'Ze-Zheng Wu (Sec-ant), on ZXing C++', href: 'https://github.com/Sec-ant/zxing-wasm' },
  { name: 'Node.js and SQLite', role: 'Server and storage', by: 'The OpenJS Foundation; D. Richard Hipp and the SQLite team', href: 'https://nodejs.org' },
  { name: 'Nodemailer', role: 'Sign-in Code mails', by: 'Andris Reinman', href: 'https://nodemailer.com' },
  { name: 'Playwright and Vitest', role: 'Tests', by: 'Microsoft; the Vitest team', href: 'https://playwright.dev' },
  { name: 'Coolify', role: 'Self-hosting', by: 'Andras Bacsai and contributors', href: 'https://coolify.io' },
  { name: 'Linear', role: 'The idea of the app frame', by: 'From "How we redesigned the Linear UI"', href: 'https://linear.app/now/how-we-redesigned-the-linear-ui' },
];

const sources: { name: string; by: string; href: string }[] = [
  { name: 'BnF', by: 'Bibliothèque nationale de France, Licence Ouverte', href: 'https://catalogue.bnf.fr' },
  { name: 'SUDOC', by: 'ABES, Licence Ouverte', href: 'https://www.sudoc.abes.fr' },
  { name: 'Inventaire', by: 'The Inventaire community', href: 'https://inventaire.io' },
  { name: 'Open Library', by: 'Internet Archive', href: 'https://openlibrary.org' },
  { name: 'Wikidata', by: 'Wikimedia community', href: 'https://www.wikidata.org' },
];
---

<Landing
  title="Atomes · Your books and manga, on your own terms"
  description="Atomes keeps your Library of books and manga: every Volume you own, read or miss. Scan a book in the shop to know if it is on your shelf. Private by default, open source, built on the AT Protocol."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="glow hero-glow" aria-hidden="true">
      <div class="glow-blob glow-b1 hero-b1"></div>
      <div class="glow-blob glow-b2 hero-b2"></div>
      <div class="glow-blob glow-b3 hero-b3"></div>
    </div>
    <div class="column hero-inner">
      <div class="hero-text">
        <p class="eyebrow"><span class="chip">Books and manga</span><span class="chip">Private by default</span><span class="chip">Open source</span></p>
        <h1 id="hero-title">Know your shelves, even in the shop.</h1>
        <p class="lead">
          Atomes keeps your Library of books and manga: every Volume you own, read or still miss. Scan a book in the shop and see at once if it is on your
          shelf. Your Library stays yours, on the AT Protocol.
        </p>
        <div class="actions">
          <a class="button button-main button-big" href="/sign-in" data-cta>Sign in</a>
          <a class="button button-big" href="#open-source">Run your own<Icon name="arrow-right" /></a>
        </div>
        <p class="fine">Invite-only for now · Free · No ads, no tracking</p>
      </div>
      <div class="hero-shots">
        <div class="hero-desktop">
          <LandingShot view="library" device="desktop" alt="The Library on a desktop: a grid of covers, with filters and Labels." eager />
        </div>
        <div class="hero-phone">
          <LandingShot view="check-owned" device="phone" alt="Shelf Check on a phone: One Piece Volume 56 is in your Library, in orange." eager />
        </div>
      </div>
    </div>
  </section>

  <section class="section shelf" aria-labelledby="shelf-title">
    <div class="glow shelf-glow" aria-hidden="true">
      <div class="glow-blob glow-b1 shelf-green"></div>
      <div class="glow-blob glow-b2 shelf-orange"></div>
    </div>
    <div class="column shelf-inner">
      <div class="shelf-text">
        <p class="kicker">Shelf Check</p>
        <h2 id="shelf-title">In the shop: do I have this one?</h2>
        <ol class="steps">
          <li><span class="step-number">1</span><span><strong>Scan the barcode</strong> with your phone, or type the ISBN.</span></li>
          <li>
            <span class="step-number">2</span>
            <span>
              <strong>Read the answer in one look.</strong>{' '}
              <span class="owned">Orange</span>: it is on your shelf. <span class="not-owned">Green</span>: it is not, and it shows where it fits in your
              Series.
            </span>
          </li>
          <li><span class="step-number">3</span><span><strong>Add it in one tap</strong>, read or not. No signal in the shop? It still works.</span></li>
        </ol>
      </div>
      <div class="shelf-shots">
        <LandingShot view="check-not-owned" device="phone" alt="Shelf Check: One Piece Volume 112 is not in your Library, in green, with your Series below." />
        <LandingShot view="check-owned" device="phone" alt="Shelf Check: One Piece Volume 56 is in your Library, in orange." />
      </div>
    </div>
  </section>

  <section class="section" id="features" aria-labelledby="features-title">
    <div class="column">
      <p class="kicker">Features</p>
      <h2 id="features-title">Everything your shelves need. Nothing they do not.</h2>
      <div class="gallery">
        <figure>
          <LandingShot view="series" device="phone" alt="A Series page: Kaamelott, 7 Volumes owned, 2 missing." />
          <figcaption>Series</figcaption>
        </figure>
        <figure>
          <LandingShot view="statistics" device="phone" alt="Statistics: books read and added by month in 2026." />
          <figcaption>Statistics</figcaption>
        </figure>
        <figure>
          <LandingShot view="to-buy" device="phone" alt="To Buy: the Missing Volumes of the Series you follow." />
          <figcaption>To Buy</figcaption>
        </figure>
      </div>
      <ul class="features">
        {
          features.map((feature) => (
            <li class="card feature">
              <span class="feature-icon">
                <Icon name={feature.icon} size={20} />
              </span>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="philosophy" aria-labelledby="philosophy-title">
    <div class="column">
      <p class="kicker">Philosophy</p>
      <h2 id="philosophy-title">Your Library belongs to you.</h2>
      <p class="lead">
        Atomes is built on the <a href="https://atproto.com">AT Protocol</a>, the open network behind Bluesky. On it, your account and what you share are
        not locked in one app: they live on your own Personal Data Server, and any app can read the open records you choose to publish.
      </p>
      <div class="diagram" aria-hidden="true">
        <span class="node">You</span>
        <span class="link"></span>
        <span class="node node-strong"><Icon name="server" />Your Personal Data Server</span>
        <span class="link"></span>
        <span class="node-group"><span class="node"><Mark size={14} />Atomes</span><span class="node">Other apps</span></span>
      </div>
      <ul class="principles">
        {
          principles.map((principle) => (
            <li class="card principle">
              <span class="feature-icon">
                <Icon name={principle.icon} size={20} />
              </span>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </li>
          ))
        }
      </ul>
      <aside class="card honest" aria-labelledby="honest-title">
        <h3 id="honest-title">An honest note</h3>
        <p>
          Today, your private records live on the Atomes instance you use, not on your Personal Data Server: the AT Protocol has no private records yet.
          The person who runs the instance could read them. If that matters to you, run your own instance. The Catalog only ever learns which ISBNs are
          looked up, never who owns them.
        </p>
      </aside>
    </div>
  </section>

  <section class="section" id="open-source" aria-labelledby="open-source-title">
    <div class="column open">
      <div>
        <p class="kicker">Open source</p>
        <h2 id="open-source-title">Read the code. Run your own.</h2>
        <ul class="facts">
          <li><Icon name="scale" /><span><strong>AGPL-3.0</strong> for the app and the Catalog: improvements stay open.</span></li>
          <li><Icon name="code-xml" /><span><strong>MIT</strong> for the <code>app.atomes.*</code> lexicons: any app can use them.</span></li>
          <li><Icon name="server" /><span><strong>One Docker image</strong>, Node.js and SQLite. A small server is enough.</span></li>
          <li><Icon name="download" /><span><strong>Off-host backups</strong> to any S3-compatible storage.</span></li>
        </ul>
        <div class="actions">
          <a class="button" href={sourceUrl}><Icon name="code-xml" />Source code</a>
          <a class="button" href={`${sourceUrl}#run-with-docker`}>Self-host guide<Icon name="arrow-right" /></a>
        </div>
      </div>
      <pre
        class="code"
        aria-label="Example: run Atomes with Docker"><code>docker build -t atomes .
docker run -d -p 4321:4321 -v atomes-data:/data \
  -e PUBLIC_APP_ORIGIN=https://books.example.org \
  -e SESSION_ENCRYPTION_KEY=… \
  -e SMTP_URL=smtps://…  -e MAIL_FROM=… \
  atomes</code></pre>
    </div>
  </section>

  <section class="section" id="credits" aria-labelledby="credits-title">
    <div class="column">
      <p class="kicker">Built on</p>
      <h2 id="credits-title">Built on the work of others. Thank you.</h2>
      <p class="lead">Atomes stands on open-source projects and open book data. Their authors made this possible.</p>
      <ul class="credits">
        {
          credits.map((credit) => (
            <li>
              <a class="card credit" href={credit.href}>
                <span class="credit-name">{credit.name}</span>
                <span class="credit-role">{credit.role}</span>
                <span class="credit-by">{credit.by}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <h3 class="small-heading sources-title">Book data</h3>
      <ul class="sources">
        {
          sources.map((source) => (
            <li>
              <a class="chip source" href={source.href}>
                <strong>{source.name}</strong>
                <span>{source.by}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section final" aria-labelledby="final-title">
    <div class="glow final-glow" aria-hidden="true">
      <div class="glow-blob glow-b1 final-b1"></div>
      <div class="glow-blob glow-b2 final-b2"></div>
    </div>
    <div class="column final-inner">
      <Mark size={56} />
      <h2 id="final-title">Start your Library.</h2>
      <p class="lead">Invite-only for now: ask a friend who reads with Atomes for an Invite, or run your own instance.</p>
      <div class="actions">
        <a class="button button-main button-big" href="/sign-in" data-cta>Sign in</a>
        <a class="button button-big" href={sourceUrl}><Icon name="code-xml" />Source code</a>
      </div>
    </div>
  </section>
</Landing>

<style>
  /*
   * Sizes of the Landing page, named once (ui-direction, "The one look"):
   * larger type and more room than an app screen. Phone first.
   */
  .hero,
  .section {
    --landing-h1: 40px;
    --landing-h2: 30px;
    --landing-lead: 17px;
    --landing-section: 72px;
    --landing-phone: 240px;
    --landing-text: 560px;
    --landing-feature: 150px;
    --landing-credit: 220px;
    position: relative;
    isolation: isolate;
  }

  @media (min-width: 960px) {
    .hero,
    .section {
      --landing-h1: 64px;
      --landing-h2: 44px;
      --landing-lead: 19px;
      --landing-section: 120px;
      --landing-phone: 260px;
      --landing-feature: 240px;
    }
  }

  .column {
    width: min(100%, var(--landing-width));
    margin: 0 auto;
    padding: 0 var(--landing-gutter);
  }

  .section {
    padding: var(--landing-section) 0 0;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  h1 {
    font-size: var(--landing-h1);
    line-height: 1.05;
  }

  h2 {
    max-width: var(--landing-text);
    font-size: var(--landing-h2);
    line-height: 1.1;
  }

  h3 {
    font-size: var(--type-heading);
  }

  p {
    margin: 0;
  }

  .lead {
    max-width: var(--landing-text);
    margin-top: var(--space-20);
    color: var(--text-quiet);
    font-size: var(--landing-lead);
    text-wrap: pretty;
  }

  .lead a {
    color: var(--ink);
    text-decoration-color: var(--line-link);
    text-underline-offset: var(--space-4);
  }

  .kicker {
    margin-bottom: var(--space-12);
    color: var(--accent);
    font-size: var(--type-small);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    margin-top: var(--space-28);
  }

  .button-big {
    min-height: var(--button-height-large);
    padding: 0 var(--space-24);
    font-size: var(--type-button-large);
  }

  .fine {
    margin-top: var(--space-16);
    color: var(--text-quiet);
    font-size: var(--type-small);
  }

  /* Hero: text, then the app on a desktop and a phone. */
  .hero {
    padding: var(--landing-section) 0 0;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-28) var(--landing-section);
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-bottom: var(--space-20);
  }

  .hero-shots {
    position: relative;
    padding-bottom: var(--space-28);
  }

  /* Phone: the phone picture only; the desktop window would be too small to read. */
  .hero-desktop {
    display: none;
  }

  .hero-phone {
    width: var(--landing-phone);
    margin: 0 auto;
  }

  @media (min-width: 960px) {
    .hero-desktop {
      display: block;
    }

    .hero-phone {
      position: absolute;
      bottom: 0;
      margin: 0;
    }

    .hero-inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
    }

    .hero-desktop {
      width: 130%;
    }

    .hero-phone {
      right: calc(var(--landing-gutter) * -1);
      width: calc(var(--landing-phone) * 0.8);
    }
  }

  /* The glows (glow.css): cobalt behind the hero and the end; green and orange only where Shelf Check answers ownership. */
  .hero-glow,
  .final-glow {
    --tone: var(--accent-fill);
    --tone-deep: var(--accent);
    z-index: -1;
    inset: 0;
    overflow: hidden;
    mask-image: linear-gradient(var(--ink) var(--glow-stop-3), transparent);
  }

  .hero-b1 {
    left: calc(var(--glow-unit) * -12);
    top: calc(var(--glow-unit) * -10);
    width: calc(var(--glow-unit) * 60);
    height: calc(var(--glow-unit) * 60);
  }

  .hero-b2 {
    right: calc(var(--glow-unit) * -14);
    top: calc(var(--glow-unit) * 6);
    width: calc(var(--glow-unit) * 54);
    height: calc(var(--glow-unit) * 54);
  }

  .hero-b3 {
    left: 40%;
    top: calc(var(--glow-unit) * 24);
    width: calc(var(--glow-unit) * 40);
    height: calc(var(--glow-unit) * 40);
  }

  /* Shelf Check: the answer colours. */
  .shelf-glow {
    --tone: var(--not-owned);
    --tone-deep: var(--not-owned-deep);
    z-index: -1;
    inset: 0;
    overflow: hidden;
  }

  .shelf-green {
    left: 30%;
    top: calc(var(--glow-unit) * 10);
    width: calc(var(--glow-unit) * 50);
    height: calc(var(--glow-unit) * 50);
  }

  .shelf-orange {
    --blob: var(--owned);
    right: calc(var(--glow-unit) * -10);
    top: calc(var(--glow-unit) * 20);
    width: calc(var(--glow-unit) * 50);
    height: calc(var(--glow-unit) * 50);
  }

  .shelf-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-28) var(--landing-section);
  }

  @media (min-width: 960px) {
    .shelf-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  .steps {
    display: grid;
    gap: var(--space-20);
    margin: var(--space-28) 0 0;
    padding: 0;
    list-style: none;
    color: var(--text-quiet);
    font-size: var(--landing-lead);
  }

  .steps li {
    display: flex;
    gap: var(--space-16);
  }

  .steps strong {
    color: var(--ink);
  }

  .step-number {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--icon-button);
    height: var(--icon-button);
    border: var(--hairline) solid var(--line-control);
    border-radius: var(--radius-pill);
    background: var(--fill-veil);
    color: var(--ink);
    font-weight: 600;
  }

  .owned {
    color: var(--owned-text);
    font-weight: 600;
  }

  .not-owned {
    color: var(--not-owned-text);
    font-weight: 600;
  }

  .shelf-shots {
    display: flex;
    justify-content: center;
    gap: var(--space-20);
  }

  .shelf-shots > :global(*) {
    flex: 1 1 0;
    min-width: 0;
    max-width: var(--landing-phone);
  }

  .shelf-shots > :global(:last-child) {
    margin-top: var(--landing-section);
  }

  /* Features: three screens, then a card per feature. */
  .gallery {
    display: flex;
    gap: var(--space-20);
    margin: var(--space-28) calc(var(--landing-gutter) * -1) 0;
    padding: var(--space-8) var(--landing-gutter) var(--space-28);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .gallery figure {
    flex: none;
    width: var(--landing-phone);
    margin: 0;
    scroll-snap-align: center;
  }

  .gallery figcaption {
    margin-top: var(--space-12);
    color: var(--text-quiet);
    font-size: var(--type-small);
    text-align: center;
  }

  @media (min-width: 960px) {
    .gallery {
      justify-content: center;
      overflow: visible;
    }
  }

  .features,
  .principles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--landing-feature)), 1fr));
    gap: var(--space-16);
    margin: var(--space-28) 0 0;
    padding: 0;
    list-style: none;
  }

  .feature,
  .principle {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-14);
  }

  /* Phone: two cards a row, so the list stays short. */
  @media (max-width: 959px) {
    .feature h3,
    .principle h3 {
      font-size: var(--type-body);
    }

    .feature p,
    .principle p {
      font-size: var(--type-small);
    }
  }

  @media (min-width: 960px) {
    .feature,
    .principle {
      padding: var(--space-20);
    }
  }

  .feature p,
  .principle p {
    color: var(--text-quiet);
    text-wrap: pretty;
  }

  .feature-icon {
    display: grid;
    place-items: center;
    width: var(--icon-button);
    height: var(--icon-button);
