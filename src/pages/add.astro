---
// Quick Add by ISBN: scan the barcode or type the ISBN, check the book, say if
// it is read, add it. The barcode is read on the device (ADR 0003). The Copy
// and the Reading Status go to the reader's Space from the browser; the Atomes
// server only gets the ISBN to look up (ADR 0001).
import Icon from '../components/Icon.astro';
import AppShell from '../layouts/AppShell.astro';

const answers = [
  { value: 'unread', label: 'Not yet' },
  { value: 'reading', label: 'Reading' },
  { value: 'read', label: 'Read' },
];
---

<AppShell title="Add to your Library">
  <div class="quick-add">
    <!-- Shown only where the browser can open a camera (HTTPS or loopback). -->
    <button class="button button-primary scan" type="button" data-scan hidden>
      <Icon name="scan-barcode" />
      <span>Scan the barcode</span>
    </button>

    <!-- data-state: starting | looking | wrong | found (set by the script, styled below). -->
    <dialog class="camera" data-camera data-state="starting" aria-label="Scan the barcode">
      <video class="camera-video" data-video muted playsinline></video>
      <div class="viewfinder" aria-hidden="true">
        <span class="scan-line"></span>
        <span class="found-mark"><Icon name="check" size={32} /></span>
      </div>
      <button class="camera-close" type="button" aria-label="Close" data-camera-close>
        <Icon name="x" size={22} />
      </button>
      <div class="camera-bottom">
        <p class="camera-text" data-camera-text aria-live="polite">Starting the camera…</p>
        <button class="camera-type" type="button" data-camera-close>
          <Icon name="keyboard" />
          <span>Type the ISBN</span>
        </button>
      </div>
    </dialog>

    <form class="isbn-form" data-isbn-form>
      <label class="label" for="isbn">ISBN</label>
      <div class="isbn-row">
        <input
          class="field"
          id="isbn"
          name="isbn"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          placeholder="978 2 7234 7899 1"
          aria-describedby="isbn-hint"
        />
        <button class="button" type="submit">Look up</button>
      </div>
      <!-- The hint line also says what is wrong with the ISBN: the page does not move. -->
      <p class="hint" id="isbn-hint" data-hint aria-live="polite">
        The 13 digits under the barcode, on the back cover.
      </p>
    </form>

    <div class="book" data-skeleton hidden aria-hidden="true">
      <div class="cover skeleton"></div>
      <div class="book-text skeleton-text">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-line"></div>
        <div class="skeleton skeleton-line short"></div>
      </div>
    </div>

    <form class="preview" data-add-form hidden>
      <div class="book" data-preview>
        <div class="cover" data-cover></div>
        <div class="book-text">
          <h2 class="book-title" data-title>Book</h2>
          <p class="book-line" data-authors></p>
          <p class="book-line" data-series></p>
          <p class="book-meta" data-edition></p>
        </div>
      </div>

      <!-- A book the Catalog does not know: the reader types it. Disabled (so not
           required) while a Catalog book is shown. maxlength keeps each field
           inside the Copy lexicon (bookDetails). -->
      <fieldset class="details" data-details hidden disabled>
        <legend class="details-title">Type the book</legend>
        <p class="hint" data-details-isbn></p>
        <label class="details-field">
          <span class="label">Title</span>
          <input class="field" name="title" type="text" maxlength="300" autocomplete="off" required />
        </label>
        <label class="details-field">
          <span class="label">Authors</span>
          <input class="field" name="authors" type="text" maxlength="1300" autocomplete="off" aria-describedby="authors-hint" />
          <span class="hint" id="authors-hint">Separate several authors with commas.</span>
        </label>
        <div class="details-row">
          <label class="details-field">
            <span class="label">Series</span>
            <input class="field" name="series" type="text" maxlength="300" autocomplete="off" />
          </label>
          <label class="details-field volume">
            <span class="label">Volume</span>
            <input class="field" name="volume" type="text" maxlength="16" autocomplete="off" />
          </label>
        </div>
        <p class="hint" data-details-problem data-error aria-live="polite"></p>
      </fieldset>

      <fieldset class="question">
        <legend class="label">Have you read it?</legend>
        <div class="segmented">
          {
            answers.map((answer) => (
              <label class="segment">
                <input type="radio" name="status" value={answer.value} checked={answer.value === 'unread'} />
                <span>{answer.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="private">
        <Icon name="lock" size={18} />
        <div>
          <p class="private-title">Private</p>
          <p class="hint">Only you can see this book. It is saved in your own Space, on your PDS.</p>
        </div>
      </div>

      <button class="button button-primary add" type="submit">
        <Icon name="book-plus" />
        <span>Add to Library</span>
      </button>
    </form>
  </div>
</AppShell>

<script>
  import { openOwnSpace } from '../lib/auth/browser-client';
  import type { Edition } from '../lib/catalog/catalog';
  import { coverUrl, lookupEdition } from '../lib/catalog/client';
  import { saveCopy, typedDetails, type BookDetails, type TypedFields } from '../lib/library/copy';
  import { editionWork, isbnProblemText, readIsbn } from '../lib/library/ids';
  import { cameraProblem, cameraProblemText, loadReader, openCamera, watchBarcodes } from '../lib/scan/barcode';
  import { reportNetwork, reportWaiting } from '../lib/connection';
  import { loadLibrary, savedMessage, sendWhenOnline, waitingCount } from '../lib/library/library';
  import { bookPage, currentStatus, editionLabel, statusChange, type Library } from '../lib/library/model';
  import { saveReadingStatus, statuses } from '../lib/library/reading-status';
  import { isNetworkFailure } from '../lib/network';
  import { spaceErrorMessage, type Space, type WriteState } from '../lib/space/space';
  import { toast } from '../lib/toast';

  const isbnForm = document.querySelector<HTMLFormElement>('[data-isbn-form]')!;
  const isbnInput = isbnForm.querySelector<HTMLInputElement>('input[name="isbn"]')!;
  const lookUpButton = isbnForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const hint = isbnForm.querySelector<HTMLElement>('[data-hint]')!;
  const defaultHint = hint.textContent.trim();
  const skeleton = document.querySelector<HTMLElement>('[data-skeleton]')!;
  const addForm = document.querySelector<HTMLFormElement>('[data-add-form]')!;
  const addButton = addForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const radios = addForm.querySelectorAll<HTMLInputElement>('input[name="status"]');
  const preview = addForm.querySelector<HTMLElement>('[data-preview]')!;
  const details = addForm.querySelector<HTMLFieldSetElement>('[data-details]')!;
  const detailsProblem = details.querySelector<HTMLElement>('[data-details-problem]')!;
  const detail = (name: keyof TypedFields) => details.querySelector<HTMLInputElement>(`input[name="${name}"]`)!;

  // The Space opens once; undefined when signed out.
  const own = openOwnSpace();
  // The book on the form: a Catalog Edition, or an ISBN the Catalog does not
  // know, which the reader types (its Work is then `isbn:<isbn>`, ADR 0010).
  interface Book {
    isbn: string;
    work: string;
    edition?: Edition;
  }
  let book: Book | undefined;
  let library: Library = { copies: [], readingStatuses: [] };
  let sending = false;

  // A problem, in the hint line; no argument puts the hint back. Only a wrong
  // ISBN marks the field invalid, not a camera that did not open.
  function problem(text?: string, fieldIsWrong = Boolean(text)) {
    hint.textContent = text ?? defaultHint;
    hint.toggleAttribute('data-error', Boolean(text));
    isbnInput.toggleAttribute('aria-invalid', fieldIsWrong);
  }

  function busy(button: HTMLButtonElement, on: boolean) {
    button.disabled = on;
    if (on) button.setAttribute('aria-busy', 'true');
    else button.removeAttribute('aria-busy');
  }

  const bookHref = (work: string) => `/book?work=${encodeURIComponent(work)}`;

  async function lookUp() {
    const read = readIsbn(isbnInput.value);
    addForm.hidden = true;
    book = undefined;
    if ('problem' in read) return problem(isbnProblemText[read.problem]);
    const { isbn } = read;
    problem();
    busy(lookUpButton, true);
    skeleton.hidden = false;
    // Undefined: no book source knows this ISBN, so the reader types the book.
    let found: Edition | undefined;
    try {
      const answer = await lookupEdition(isbn);
      if ('unavailable' in answer) return problem('The book sources do not answer. Try again later.');
      if ('found' in answer) found = answer.found;
      reportNetwork(true);
    } catch (error) {
      if (isNetworkFailure(error)) reportNetwork(false);
      return problem(
        isNetworkFailure(error)
          ? 'Could not reach Atomes to look up the book. Check your connection and try again.'
          : 'Could not look up this ISBN. Try again.',
      );
    } finally {
      busy(lookUpButton, false);
      skeleton.hidden = true;
    }
    await (found ? show(found) : showUnknown(isbn));
  }

  async function show(found: Edition) {
    const cover = addForm.querySelector<HTMLElement>('[data-cover]')!;
    cover.replaceChildren();
    const src = coverUrl(found);
    if (src) {
      const image = document.createElement('img');
      image.src = src;
      image.alt = '';
      cover.append(image);
    }
    addForm.querySelector('[data-title]')!.textContent = found.title;
    addForm.querySelector('[data-authors]')!.textContent = found.authors.join(', ');
    addForm.querySelector('[data-series]')!.textContent = [
      found.series && found.series.title !== found.title ? found.series.title : '',
      found.volume !== null ? `Volume ${found.volume}` : '',
      found.volumeTitle ?? '',
    ]
      .filter(Boolean)
      .join(' · ');
    addForm.querySelector('[data-edition]')!.textContent = [editionLabel(found), `ISBN ${found.isbn}`]
      .filter(Boolean)
      .join(' · ');
    await ready({ isbn: found.isbn, work: found.work.id, edition: found });
  }

  async function showUnknown(isbn: string) {
    details.querySelector('[data-details-isbn]')!.textContent =
      `ISBN ${isbn}. No book source knows it yet: type what is on the cover.`;
    fillDetails({ title: '' });
    await ready({ isbn, work: editionWork(isbn) });
  }

  function fillDetails(typed: BookDetails) {
    detail('title').value = typed.title;
    detail('authors').value = typed.authors?.join(', ') ?? '';
    detail('series').value = typed.series ?? '';
    detail('volume').value = typed.volume ?? '';
    detailsProblem.textContent = '';
  }

  // Shows the form for this book, then starts from what the Library already has.
  async function ready(next: Book) {
    book = next;
    const typing = !next.edition;
    preview.hidden = typing;
    details.hidden = !typing;
    details.disabled = !typing;
    for (const radio of radios) radio.checked = radio.value === 'unread';
    addForm.hidden = false;
    (typing ? detail('title') : addButton).focus();

    // Already in the Library: start from its Reading Status, and say so.
    const space = await openSpaceOrSay();
    if (!space) return;
    try {
      const loaded = await loadLibrary(space);
      library = loaded.library;
      reportNetwork(!loaded.stale);
      reportWaiting(await waitingCount(space));
    } catch {
      // No copy on this device and no network: the status starts at "Not yet".
      library = { copies: [], readingStatuses: [] };
    }
    if (book !== next) return;
    // Abandoned is not an answer here: no choice keeps it.
    const status = currentStatus(next.work, library);
    for (const radio of radios) radio.checked = radio.value === status;
    // Another Copy of a book typed before: start from what the reader typed then.
    const before = library.copies.find(({ value }) => value.isbn === next.isbn && value.details)?.value.details;
    if (typing && before && !detail('title').value) fillDetails(before);
    if (bookPage(next.work, library, new Map())) {
      toast('You already have this book. Adding it again adds another Copy.', {
        link: { href: bookHref(next.work), label: 'Open its Book page' },
      });
    }
  }

  async function openSpaceOrSay(): Promise<Space | undefined> {
    try {
      const opened = await own;
      if (opened) return opened.space;
      toast('Sign in to add books to your Library.', { link: { href: '/settings', label: 'Go to Settings' } });
    } catch (error) {
      toast(spaceErrorMessage(error), { error: true });
    }
    return undefined;
  }

  async function add() {
    const current = book;
    if (!current) return;
    const typed = current.edition
      ? undefined
      : typedDetails({
          title: detail('title').value,
          authors: detail('authors').value,
          series: detail('series').value,
          volume: detail('volume').value,
        });
    if (typed && 'problem' in typed) {
      detailsProblem.textContent = typed.problem;
      return;
    }
    const typedBook = typed?.details;
    const title = current.edition?.title ?? typedBook?.title ?? `ISBN ${current.isbn}`;
    const checked = [...radios].find((radio) => radio.checked)?.value;
    const chosen = statuses.find((status) => status === checked);
    const space = await openSpaceOrSay();
    if (!space) return;
    busy(addButton, true);
    try {
      const now = new Date();
      const { isbn, work } = current;
      const copy = { isbn, works: [work], ...(typedBook && { details: typedBook }), createdAt: now.toISOString() };
      const states: WriteState[] = [];
      states.push((await saveCopy(space, copy)).state);
      const change = chosen && statusChange(work, isbn, chosen, library, now);
      if (change) states.push(await saveReadingStatus(space, change));
      const state = states.find((each) => each === 'refused') ?? states.find((each) => each === 'waiting') ?? 'sent';
      if (state !== 'refused') reportNetwork(state === 'sent');
      reportWaiting(await waitingCount(space));

      addForm.hidden = true;
      book = undefined;
      isbnInput.value = '';
      const link = { href: bookHref(work), label: 'Open its Book page' };
      const close = toast(`${title} is in your Library. ${savedMessage[state]}`, {
        link,
        error: state === 'refused',
      });
      if (state === 'waiting' && !sending) {
        sending = true;
        sendWhenOnline(
          space,
          () => {
            sending = false;
            reportNetwork(true);
            reportWaiting(0);
            close();
            toast(`${title} is in your Library. ${savedMessage.sent}`, { link });
          },
          (error) => toast(spaceErrorMessage(error), { error: true }),
        );
      }
      isbnInput.focus();
    } catch (error) {
      toast(spaceErrorMessage(error), { error: true });
    } finally {
      busy(addButton, false);
    }
  }

  const scanButton = document.querySelector<HTMLButtonElement>('[data-scan]')!;
  const camera = document.querySelector<HTMLDialogElement>('[data-camera]')!;
  const video = camera.querySelector<HTMLVideoElement>('[data-video]')!;
  const cameraText = camera.querySelector<HTMLElement>('[data-camera-text]')!;
  // Aborted when the camera view closes, for any reason (Close, Escape, a book found).
  let scanning = new AbortController();
  let later: ReturnType<typeof setTimeout> | undefined;

  type ScanState = 'starting' | 'looking' | 'wrong' | 'found';
  const lookingText = 'Point at the barcode on the back cover.';
  // A detector returns only barcodes it could decode, so "nothing yet" is all
  // the reader knows. After a while, say what usually helps.
  const stuckText = 'Nothing read yet. Hold the book 20 to 40 cm away, in good light, the barcode inside the frame.';

  // What the camera view shows: the frame (styled by data-state) and one line.
  // `then` runs after `delay` unless the view shows something else first.
  function showScan(state: ScanState, text: string, then?: () => void, delay = 0) {
    clearTimeout(later);
    camera.dataset.state = state;
    if (cameraText.textContent !== text) cameraText.textContent = text; // no repeat for screen readers
    if (then) later = setTimeout(then, delay);
  }

  const looking = () => showScan('looking', lookingText, () => showScan('looking', stuckText), 8000);

  // The camera view over the whole screen; the first good ISBN fills the field
  // and looks the book up. Any failure goes back to typing, with the reason.
  async function scan() {
    problem();
    showScan('starting', 'Starting the camera…');
    scanning = new AbortController();
    const { signal } = scanning;
    camera.showModal();
    let stream: MediaStream;
    try {
      stream = await openCamera();
    } catch (error) {
      camera.close();
      return typeInstead(cameraProblemText[cameraProblem(error)]);
    }
    const stop = () => stream.getTracks().forEach((track) => track.stop());
    if (signal.aborted) return stop(); // closed while the permission prompt was open
    signal.addEventListener('abort', stop);
    video.srcObject = stream;
    try {
      await video.play();
      await loadReader();
      if (signal.aborted) return;
      looking();
      await watchBarcodes(video, found, signal);
    } catch {
      if (signal.aborted) return;
      camera.close();
      typeInstead('Could not read barcodes on this device. Type the ISBN.');
    }
  }

  function found(text: string): boolean {
    const read = readIsbn(text);
    if ('isbn' in read) {
      // Show the read before the view goes away: the reader sees it worked.
      showScan('found', `ISBN ${read.isbn}`);
      navigator.vibrate?.(40);
      const { signal } = scanning;
      setTimeout(() => {
        if (signal.aborted) return; // closed by hand in the meantime
        camera.close();
        isbnInput.value = read.isbn;
        void lookUp();
      }, 600);
      return true;
    }
    // A wrong check digit is a misread: keep reading without a word. While the
    // wrong barcode stays in view the state stays (no new shake); 2.5 s after
    // it leaves, back to looking.
    if (read.problem !== 'check-digit') showScan('wrong', isbnProblemText[read.problem], looking, 2500);
    return false;
  }

  function typeInstead(reason?: string) {
    if (reason) problem(reason, false);
    isbnInput.focus();
  }

  // `mediaDevices` exists only in a secure context (HTTPS or loopback).
  if ('mediaDevices' in navigator) scanButton.hidden = false;
  scanButton.addEventListener('click', () => void scan());
  for (const button of camera.querySelectorAll('[data-camera-close]')) {
    button.addEventListener('click', () => {
      camera.close();
      typeInstead();
    });
  }
  camera.addEventListener('close', () => {
    clearTimeout(later);
    scanning.abort();
    video.srcObject = null;
  });

  isbnForm.addEventListener('submit', (event) => {
    event.preventDefault();
    void lookUp();
  });
  isbnInput.addEventListener('input', () => {
    if (hint.hasAttribute('data-error')) problem();
  });
  details.addEventListener('input', () => {
    detailsProblem.textContent = '';
  });
  addForm.addEventListener('submit', (event) => {
    event.preventDefault();
    void add();
  });

  // From the Book page ("Add another Copy"): the ISBN is already known.
  const given = new URLSearchParams(location.search).get('isbn');
  if (given) {
    isbnInput.value = given;
    void lookUp();
  }
</script>

<style>
  .quick-add {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .scan {
    width: 100%;
  }

  /* Camera (ui-direction: Camera): the whole screen on the phone, over the tab
     bar (a modal dialog is in the top layer); colours not themed. */
  .camera {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: var(--camera);
    color: var(--camera-ink);
  }

  .camera[open] {
    display: grid;
  }

  .camera::backdrop {
    background: var(--scrim);
  }

  .camera > * {
    grid-area: 1 / 1;
  }

  /* Explicit layers: with a live camera, Chromium on macOS can draw the video
     on its own layer, over siblings that only rely on paint order. */
  .camera > :not(video) {
    position: relative;
    z-index: 1;
  }

  .camera-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A barcode is wide: a wide frame tells where to hold it. */
  .viewfinder {
    place-self: center;
    width: min(76%, 320px);
    aspect-ratio: 2 / 1;
    border: 3px solid var(--camera-ink);
    border-radius: var(--radius-panel);
    box-shadow: 0 0 0 100vmax rgb(0 0 0 / 0.35);
    overflow: hidden;
    display: grid;
    place-items: center;
    transition:
      border-color 150ms,
      background-color 150ms;
  }

  .scan-line,
  .found-mark {
    display: none;
  }

  /* Starting: the camera or the reader is not ready yet. */
  .camera[data-state='starting'] .viewfinder {
    border-color: rgb(255 255 255 / 0.4);
  }

  /* Looking: a line sweeps the frame while the reader works on each picture. */
  .camera[data-state='looking'] .scan-line {
    display: block;
    position: absolute;
    inset: 0 8px auto;
    height: 2px;
    border-radius: 1px;
    background: var(--camera-ink);
    box-shadow: 0 0 8px var(--camera-ink);
    animation: sweep 1.6s ease-in-out infinite alternate;
  }

  /* Wrong: a barcode that is not a book's; the frame shakes once. */
  .camera[data-state='wrong'] .viewfinder {
    border-style: dashed;
    animation: shake 300ms ease-in-out;
  }

  /* Found: the frame fills and shows a check before the view closes. */
  .camera[data-state='found'] .viewfinder {
    background: rgb(255 255 255 / 0.2);
  }

  .camera[data-state='found'] .found-mark {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 28px;
    background: var(--camera-ink);
    color: var(--camera);
    animation: pop 200ms ease-out;
  }

  @keyframes sweep {
    from {
      top: 8%;
    }
    to {
      top: 90%;
    }
  }

  @keyframes shake {
    25% {
      translate: -6px 0;
    }
    75% {
      translate: 6px 0;
    }
  }

  @keyframes pop {
    from {
      scale: 0.6;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .camera[data-state='looking'] .scan-line {
      top: 50%;
      animation: none;
    }

    .camera[data-state='wrong'] .viewfinder,
    .camera[data-state='found'] .found-mark {
      animation: none;
    }
  }

  .camera-close,
  .camera-type {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 0;
    background: var(--camera-control);
    color: var(--camera-ink);
    cursor: pointer;
  }

  .camera-close {
    place-self: start end;
    width: 44px;
    height: 44px;
    margin: max(12px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) 0 0;
    padding: 0;
    border-radius: 22px;
  }

  .camera-bottom {
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 0 20px max(24px, env(safe-area-inset-bottom));
    text-align: center;
  }

  .camera-text {
    font-size: 15px;
    font-weight: 600;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.6);
  }

  .camera-type {
    min-height: 44px;
    padding: 0 16px;
    border-radius: 22px;
    font-size: 15px;
    font-weight: 600;
  }

  .isbn-form {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .label {
    padding: 0;
    font-size: 14px;
    font-weight: 600;
  }

  .isbn-row {
    display: flex;
    gap: 8px;
  }

  .isbn-row .field {
    flex: 1;
    font-variant-numeric: tabular-nums;
  }

  .hint,
  .book-meta {
    color: var(--secondary);
    font-size: 13px;
  }

  /* No danger colour in the palette (ui-direction: colour roles): ink and weight. */
  .hint[data-error] {
    color: var(--ink);
    font-weight: 600;
  }

