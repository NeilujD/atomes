---
// Quick Add by ISBN: type the ISBN, check the book, say if it is read, add it.
// The Copy and the Reading Status go to the reader's Space from the browser;
// the Atomes server only gets the ISBN to look up (ADR 0001).
import Icon from '../components/Icon.astro';
import AppShell from '../layouts/AppShell.astro';

const answers = [
  { value: 'unread', label: 'Not yet' },
  { value: 'reading', label: 'Reading' },
  { value: 'read', label: 'Read' },
];
---

<AppShell title="Add to your Library">
  <div class="quick-add">
    <form class="isbn-form" data-isbn-form>
      <label class="label" for="isbn">ISBN</label>
      <div class="isbn-row">
        <input
          class="field"
          id="isbn"
          name="isbn"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          placeholder="978 2 7234 7899 1"
          aria-describedby="isbn-hint"
        />
        <button class="button" type="submit">Look up</button>
      </div>
      <!-- The hint line also says what is wrong with the ISBN: the page does not move. -->
      <p class="hint" id="isbn-hint" data-hint aria-live="polite">
        The 13 digits under the barcode, on the back cover.
      </p>
    </form>

    <div class="book" data-skeleton hidden aria-hidden="true">
      <div class="cover skeleton"></div>
      <div class="book-text skeleton-text">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-line"></div>
        <div class="skeleton skeleton-line short"></div>
      </div>
    </div>

    <form class="preview" data-add-form hidden>
      <div class="book">
        <div class="cover" data-cover></div>
        <div class="book-text">
          <h2 class="book-title" data-title>Book</h2>
          <p class="book-line" data-authors></p>
          <p class="book-line" data-series></p>
          <p class="book-meta" data-edition></p>
        </div>
      </div>

      <fieldset class="question">
        <legend class="label">Have you read it?</legend>
        <div class="segmented">
          {
            answers.map((answer) => (
              <label class="segment">
                <input type="radio" name="status" value={answer.value} checked={answer.value === 'unread'} />
                <span>{answer.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="private">
        <Icon name="lock" size={18} />
        <div>
          <p class="private-title">Private</p>
          <p class="hint">Only you can see this book. It is saved in your own Space, on your PDS.</p>
        </div>
      </div>

      <button class="button button-primary add" type="submit">
        <Icon name="book-plus" />
        <span>Add to Library</span>
      </button>
    </form>
  </div>
</AppShell>

<script>
  import { openOwnSpace } from '../lib/auth/browser-client';
  import type { Edition } from '../lib/catalog/catalog';
  import { coverUrl, lookupEdition } from '../lib/catalog/client';
  import { saveCopy } from '../lib/library/copy';
  import { isIsbn13 } from '../lib/library/ids';
  import { reportNetwork, reportWaiting } from '../lib/connection';
  import { loadLibrary, savedMessage, sendWhenOnline, waitingCount } from '../lib/library/library';
  import { bookPage, currentStatus, editionLabel, statusChange, type Library } from '../lib/library/model';
  import { saveReadingStatus, statuses } from '../lib/library/reading-status';
  import { isNetworkFailure } from '../lib/network';
  import { spaceErrorMessage, type Space, type WriteState } from '../lib/space/space';
  import { toast } from '../lib/toast';

  const isbnForm = document.querySelector<HTMLFormElement>('[data-isbn-form]')!;
  const isbnInput = isbnForm.querySelector<HTMLInputElement>('input[name="isbn"]')!;
  const lookUpButton = isbnForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const hint = isbnForm.querySelector<HTMLElement>('[data-hint]')!;
  const defaultHint = hint.textContent.trim();
  const skeleton = document.querySelector<HTMLElement>('[data-skeleton]')!;
  const addForm = document.querySelector<HTMLFormElement>('[data-add-form]')!;
  const addButton = addForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const radios = addForm.querySelectorAll<HTMLInputElement>('input[name="status"]');

  // The Space opens once; undefined when signed out.
  const own = openOwnSpace();
  let edition: Edition | undefined;
  let library: Library = { copies: [], readingStatuses: [] };
  let sending = false;

  // A problem with the ISBN, in the hint line; no argument puts the hint back.
  function problem(text?: string) {
    hint.textContent = text ?? defaultHint;
    hint.toggleAttribute('data-error', Boolean(text));
    isbnInput.toggleAttribute('aria-invalid', Boolean(text));
  }

  function busy(button: HTMLButtonElement, on: boolean) {
    button.disabled = on;
    if (on) button.setAttribute('aria-busy', 'true');
    else button.removeAttribute('aria-busy');
  }

  const bookHref = (work: string) => `/book?work=${encodeURIComponent(work)}`;

  async function lookUp() {
    const isbn = isbnInput.value.replace(/[\s-]/g, '');
    addForm.hidden = true;
    edition = undefined;
    if (!isIsbn13(isbn)) return problem('This is not an ISBN-13. Type the 13 digits that start with 978 or 979.');
    problem();
    busy(lookUpButton, true);
    skeleton.hidden = false;
    let found: Edition;
    try {
      const answer = await lookupEdition(isbn);
      if ('notFound' in answer) return problem('No book source knows this ISBN yet.');
      if ('unavailable' in answer) return problem('The book sources do not answer. Try again later.');
      found = answer.found;
      reportNetwork(true);
    } catch (error) {
      if (isNetworkFailure(error)) reportNetwork(false);
      return problem(
        isNetworkFailure(error)
          ? 'Could not reach Atomes to look up the book. Check your connection and try again.'
          : 'Could not look up this ISBN. Try again.',
      );
    } finally {
      busy(lookUpButton, false);
      skeleton.hidden = true;
    }
    edition = found;
    await show(found);
  }

  async function show(found: Edition) {
    const cover = addForm.querySelector<HTMLElement>('[data-cover]')!;
    cover.replaceChildren();
    const src = coverUrl(found);
    if (src) {
      const image = document.createElement('img');
      image.src = src;
      image.alt = '';
      cover.append(image);
    }
    addForm.querySelector('[data-title]')!.textContent = found.title;
    addForm.querySelector('[data-authors]')!.textContent = found.authors.join(', ');
    addForm.querySelector('[data-series]')!.textContent = [
      found.series && found.series.title !== found.title ? found.series.title : '',
      found.volume !== null ? `Volume ${found.volume}` : '',
      found.volumeTitle ?? '',
    ]
      .filter(Boolean)
      .join(' · ');
    addForm.querySelector('[data-edition]')!.textContent = [editionLabel(found), `ISBN ${found.isbn}`]
      .filter(Boolean)
      .join(' · ');
    for (const radio of radios) radio.checked = radio.value === 'unread';
    addForm.hidden = false;
    addButton.focus();

    // Already in the Library: start from its Reading Status, and say so.
    const space = await openSpaceOrSay();
    if (!space) return;
    try {
      const loaded = await loadLibrary(space);
      library = loaded.library;
      reportNetwork(!loaded.stale);
      reportWaiting(await waitingCount(space));
    } catch {
      // No copy on this device and no network: the status starts at "Not yet".
      library = { copies: [], readingStatuses: [] };
    }
    if (edition !== found) return;
    // Abandoned is not an answer here: no choice keeps it.
    const status = currentStatus(found.work.id, library);
    for (const radio of radios) radio.checked = radio.value === status;
    if (bookPage(found.work.id, library, new Map())) {
      toast('You already have this book. Adding it again adds another Copy.', {
        link: { href: bookHref(found.work.id), label: 'Open its Book page' },
      });
    }
  }

  async function openSpaceOrSay(): Promise<Space | undefined> {
    try {
      const opened = await own;
      if (opened) return opened.space;
      toast('Sign in to add books to your Library.', { link: { href: '/settings', label: 'Go to Settings' } });
    } catch (error) {
      toast(spaceErrorMessage(error), { error: true });
    }
    return undefined;
  }

  async function add() {
    const found = edition;
    if (!found) return;
    const checked = [...radios].find((radio) => radio.checked)?.value;
    const chosen = statuses.find((status) => status === checked);
    const space = await openSpaceOrSay();
    if (!space) return;
    busy(addButton, true);
    try {
      const now = new Date();
      const work = found.work.id;
      const states: WriteState[] = [];
      states.push((await saveCopy(space, { isbn: found.isbn, works: [work], createdAt: now.toISOString() })).state);
      const change = chosen && statusChange(work, found.isbn, chosen, library, now);
      if (change) states.push(await saveReadingStatus(space, change));
      const state = states.find((each) => each === 'refused') ?? states.find((each) => each === 'waiting') ?? 'sent';
      if (state !== 'refused') reportNetwork(state === 'sent');
      reportWaiting(await waitingCount(space));

      addForm.hidden = true;
      edition = undefined;
      isbnInput.value = '';
      const link = { href: bookHref(work), label: 'Open its Book page' };
      const close = toast(`${found.title} is in your Library. ${savedMessage[state]}`, {
        link,
        error: state === 'refused',
      });
      if (state === 'waiting' && !sending) {
        sending = true;
        sendWhenOnline(
          space,
          () => {
            sending = false;
            reportNetwork(true);
            reportWaiting(0);
            close();
            toast(`${found.title} is in your Library. ${savedMessage.sent}`, { link });
          },
          (error) => toast(spaceErrorMessage(error), { error: true }),
        );
      }
      isbnInput.focus();
    } catch (error) {
      toast(spaceErrorMessage(error), { error: true });
    } finally {
      busy(addButton, false);
    }
  }

  isbnForm.addEventListener('submit', (event) => {
    event.preventDefault();
    void lookUp();
  });
  isbnInput.addEventListener('input', () => {
    if (hint.hasAttribute('data-error')) problem();
  });
  addForm.addEventListener('submit', (event) => {
    event.preventDefault();
    void add();
  });

  // From the Book page ("Add another Copy"): the ISBN is already known.
  const given = new URLSearchParams(location.search).get('isbn');
  if (given) {
    isbnInput.value = given;
    void lookUp();
  }
</script>

<style>
  .quick-add {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .isbn-form {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .label {
    padding: 0;
    font-size: 14px;
    font-weight: 600;
  }

  .isbn-row {
    display: flex;
    gap: 8px;
  }

  .isbn-row .field {
    flex: 1;
    font-variant-numeric: tabular-nums;
  }

  .hint,
  .book-meta {
    color: var(--secondary);
    font-size: 13px;
  }

  /* No danger colour in the palette (ui-direction: colour roles): ink and weight. */
  .hint[data-error] {
    color: var(--ink);
    font-weight: 600;
  }

  .field[aria-invalid] {
    border-color: var(--ink);
  }

  .skeleton-text {
    flex: 1;
    gap: 10px;
    padding-top: 4px;
  }

  .skeleton-title {
    width: 70%;
    height: 22px;
  }

  .skeleton-line {
    width: 50%;
    height: 14px;
  }

  .skeleton-line.short {
    width: 35%;
  }

  .preview {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .book {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .cover {
    flex: none;
    width: 88px;
    align-self: flex-start;
    overflow: hidden;
    border-radius: var(--radius-cover);
    box-shadow: 0 0 0 1px var(--cover-edge);
  }

  /* No cover: a book-shaped placeholder. */
  .cover:empty {
    aspect-ratio: 2 / 3;
    background: var(--soft);
  }

  /* The whole cover, at its own ratio: covers are not all 2:3. */
  .cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .book-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .book-title {
    font-size: 22px;
  }

  .book-line {
    font-size: 14px;
  }

  .book-line:empty {
    display: none;
  }

  .question {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .question legend {
    margin-bottom: 8px;
  }

  .private {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    border-radius: var(--radius-panel);
    background: var(--soft);
  }

  .private-title {
    font-size: 15px;
    font-weight: 600;
  }

  .add {
    width: 100%;
  }

  /* Desktop: one narrow column in the middle of the panel. */
  @media (min-width: 960px) {
    .quick-add {
      margin: 32px auto 0;
    }

    .cover {
      width: 104px;
    }
  }
</style>
