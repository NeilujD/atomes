---
// Book page: one Work of the Library, from the reader's records and the
// Catalog (src/lib/library/model.ts). `?work=<Catalog identifier>`.
import Icon from '../components/Icon.astro';
import BookLabels from '../islands/BookLabels';
import WorkPrivacy from '../islands/WorkPrivacy';
import AppShell from '../layouts/AppShell.astro';
import '../styles/correction.css';
// The glow, halo and rings (ADR 0018, Q9): the parts of the Shelf Check result, in this page's tone.
import '../styles/glow.css';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));

const choices = [
  { value: 'unread', label: t('status.unread') },
  { value: 'reading', label: t('status.reading') },
  { value: 'read', label: t('status.read') },
  { value: 'abandoned', label: t('status.abandoned') },
];
---

<AppShell title={t('book.title')} current="library" detail>
  <div class="book-page glow-arrive" data-page aria-busy="true">
    <!-- Behind the top of the page, once the book shows: green when the reader owns no Copy, orange when they own one (Q8, Q9). -->
    <div class="glow book-glow" aria-hidden="true">
      <span class="glow-blob glow-b1 book-b1"></span>
      <span class="glow-blob glow-b2 book-b2"></span>
      <span class="glow-blob glow-b3 book-b3"></span>
    </div>

    <!-- Only when there is no book to show (not signed in, not in the Library); results of a change are toasts. -->
    <p class="message" data-message role="status" hidden></p>

    <!-- No Copy and no Reading Status for this Work, or no Work in the link. -->
    <section class="not-found" data-not-found aria-labelledby="not-found-title" hidden>
      <div class="not-found-cover" aria-hidden="true">
        <Icon name="book-plus" size={24} />
      </div>
      <h2 class="not-found-title" id="not-found-title" data-not-found-title>{t('book.not-in-library')}</h2>
      <p class="not-found-text" data-not-found-text>{t('book.not-in-library-text')}</p>
      <div class="not-found-actions">
        <a class="button button-main" href="/check" data-not-found-add>
          <Icon name="plus" />
          <span data-not-found-add-label>{t('book.add-a-book')}</span>
        </a>
        <a class="button button-quiet" href="/">{t('link.home')}</a>
      </div>
    </section>

    <!-- One cover for the skeleton and the book: render() moves its stage into the book.
         The cover that flies from the Library lands on it, and must not hide halfway (src/lib/page-transition.ts).
         The halo and rings show once the book does. -->
    <div class="book" data-skeleton aria-hidden="true">
      <div class="stage" data-book-stage>
        <span class="glow-ring glow-r1" aria-hidden="true"></span>
        <span class="glow-ring glow-r2" aria-hidden="true"></span>
        <span class="glow-ring glow-r3" aria-hidden="true"></span>
        <span class="glow-halo" aria-hidden="true"></span>
        <div class="cover book-cover skeleton" data-book-cover></div>
      </div>
      <div class="content">
        <div class="head-text skeleton-text">
          <div class="skeleton skeleton-title"></div>
          <div class="skeleton skeleton-line"></div>
          <div class="skeleton skeleton-line short"></div>
        </div>
      </div>
    </div>

    <article class="book" data-book hidden>
      <div class="content">
        <div class="head-text">
          <p class="title" data-title aria-hidden="true"></p>
          <p class="line" data-volume-title></p>
          <p class="line strong" data-authors></p>
          <!-- "Series: X · Volume N · Change" (Series Correction, src/islands/SeriesCorrection.tsx). -->
          <div class="line series-line" data-series-line>
            <span data-series></span><span data-series-correction></span>
          </div>
        </div>

        <section class="group card" aria-labelledby="status-title">
          <h2 class="small-heading" id="status-title">{t('book.reading-status')}</h2>
          <span class="status-chip">
            <select aria-labelledby="status-title" data-status>
              {choices.map((choice) => <option value={choice.value}>{choice.label}</option>)}
            </select>
            <Icon name="chevron-down" />
          </span>
          <div class="finished" data-started hidden>
            <label class="label" for="started-at">{t('book.started-on')}</label>
            <input class="field" id="started-at" type="date" data-started-at />
            <span class="hint">{t('book.optional')}</span>
          </div>
          <div class="finished" data-finished hidden>
            <label class="label" for="finished-at">{t('book.finished-on')}</label>
            <input class="field" id="finished-at" type="date" data-finished-at />
            <span class="hint">{t('book.optional')}</span>
          </div>
        </section>

        <!-- Labels of this Work (src/islands/BookLabels.tsx). -->
        <section class="group card" aria-labelledby="labels-title">
          <h2 class="small-heading" id="labels-title">{t('labels.title')}</h2>
          <BookLabels client:only="preact" />
        </section>

        <!-- Keep this Work Private inside a Shared category (src/islands/WorkPrivacy.tsx). -->
        <WorkPrivacy client:only="preact" />

        <section class="group card" aria-labelledby="copies-title">
          <h2 class="small-heading" id="copies-title">{t('book.copies')}</h2>
          <p class="hint" data-no-copies hidden>{t('book.no-copies')}</p>
          <ul class="copies" data-copies></ul>
          <!-- The main action of the page (Q7): "Add a Copy" while the reader has none (render()). -->
          <a class="button button-main" href="/check" data-add-copy>
            <Icon name="plus" />
            <span data-add-copy-label>{t('book.add-copy')}</span>
          </a>
        </section>
      </div>
    </article>
  </div>

  <template data-copy-template>
    <li class="copy">
      <div class="copy-head">
        <div class="copy-text">
          <p class="strong" data-edition></p>
          <p class="hint" data-isbn></p>
        </div>
        <!-- Lend opens the Lend form; "…" opens the menu with Remove, which destroys (Undo in its toast). -->
        <div class="copy-actions">
          <button class="button button-quiet" type="button" data-lend-open>
            <Icon name="handshake" />
            <span>{t('book.lend')}</span>
          </button>
          <button class="button button-quiet icon-only" type="button" data-more>
            <Icon name="ellipsis" />
          </button>
          <div class="copy-menu" popover data-menu>
            <button class="button button-quiet button-danger copy-menu-item" type="button" data-remove>
              <Icon name="trash" />
              <span>{t('book.remove')}</span>
            </button>
          </div>
        </div>
      </div>
      <!-- The day the reader got this Copy (ADR 0019): they change it, or empty the field to remove it. -->
      <label class="got-on">
        <span class="label">{t('book.got-on')}</span>
        <input class="field" type="date" data-got-on />
        <span class="hint">{t('book.optional')}</span>
      </label>
      <!-- An open Loan: who has the Copy, since when. -->
      <div class="loan" data-loan hidden>
        <p class="loan-text">
          <Icon name="handshake" />
          <span data-loan-text></span>
        </p>
        <button class="button" type="button" data-return>
          <Icon name="check" />
          <span>{t('book.mark-returned')}</span>
        </button>
      </div>
      <form class="lend" data-lend hidden>
        <label class="lend-field">
          <span class="label">{t('book.lend-to')}</span>
          <input
            class="field"
            name="borrower"
            type="text"
            required
            maxlength="64"
            autocomplete="off"
            placeholder={t('book.borrower-placeholder')}
          />
        </label>
        <button class="button" type="submit" data-lend-button>{t('book.lend')}</button>
        <button class="button button-quiet icon-only" type="button" aria-label={t('book.lend-cancel')} data-lend-cancel>
          <Icon name="x" />
        </button>
      </form>
      <details class="past-loans" data-past-loans hidden>
        <summary class="hint" data-past-loans-title></summary>
        <ul class="past-loan-list" data-past-loan-list></ul>
      </details>
    </li>
  </template>
</AppShell>

<script>
  import { h, render as renderIsland } from 'preact';
  import { SeriesCorrection } from '../islands/SeriesCorrection';
  import { openOwnSpace } from '../lib/auth/server-client';
  import type { Edition } from '../lib/catalog/catalog';
  import { lookupEditions, refreshCorrected } from '../lib/catalog/client';
  import { showCover } from '../lib/cover';
  import { isEditionWork, isWorkId } from '../lib/library/ids';
  import { reportNetwork, reportWaiting } from '../lib/connection';
  import { gotOn, saveCopy } from '../lib/library/copy';
  import { saveFollow } from '../lib/library/follow';
  import { pageLanguage, t } from '../lib/i18n/i18n';
  import { loadLibrary, savedText, sendWhenOnline, waitingCount, worstState } from '../lib/library/library';
  import { saveLoan } from '../lib/library/loan';
  import { bookIsbns, bookPage, dayCorrection, lend, returnLoans, statusChange, type BookPage, type Library } from '../lib/library/model';
  import { followOnRead } from '../lib/library/onboarding';
  import { removeCopy, type Removed } from '../lib/library/remove-copy';
  import { saveReadingStatus, statuses, type ReadingStatus } from '../lib/library/reading-status';
  import { seriesHref, suggestsDrop } from '../lib/library/series';
  import { isNetworkFailure } from '../lib/network';
  import { freshListing } from '../lib/space/fresh-listing';
  import { spaceErrorMessage, type Space, type WriteState } from '../lib/space/queued-store';
  import { toast, type ToastAction } from '../lib/toast';

  const pageBox = document.querySelector<HTMLElement>('[data-page]')!;
  const message = document.querySelector<HTMLElement>('[data-message]')!;
  const notFound = document.querySelector<HTMLElement>('[data-not-found]')!;
  const skeleton = document.querySelector<HTMLElement>('[data-skeleton]')!;
  const article = document.querySelector<HTMLElement>('[data-book]')!;
  const stage = document.querySelector<HTMLElement>('[data-book-stage]')!;
  const cover = stage.querySelector<HTMLElement>('[data-book-cover]')!;
  const statusSelect = article.querySelector<HTMLSelectElement>('[data-status]')!;
  const finished = article.querySelector<HTMLElement>('[data-finished]')!;
  const finishedAt = article.querySelector<HTMLInputElement>('[data-finished-at]')!;
  const started = article.querySelector<HTMLElement>('[data-started]')!;
  const startedAt = article.querySelector<HTMLInputElement>('[data-started-at]')!;
  const copyList = article.querySelector<HTMLUListElement>('[data-copies]')!;
  const copyTemplate = document.querySelector<HTMLTemplateElement>('[data-copy-template]')!;

  const work = new URLSearchParams(location.search).get('work') ?? '';
  // Catalog answers kept for this visit, so an offline reload of the records keeps the titles.
  const editions = new Map<string, Edition>();
  let library: Library = { copies: [], readingStatuses: [], follows: [], loans: [], toBuy: [] };
  let page: BookPage | undefined;
  let renderedCopies = '';
  let sending = false;

  function loaded() {
    skeleton.hidden = true;
    pageBox.removeAttribute('aria-busy');
    // No glow until render() shows a book, and none with no book to show.
    delete pageBox.dataset.tone;
  }

  // The page has no book to show: say why, in place of the book.
  function say(text: string, link?: { href: string; label: string }) {
    loaded();
    article.hidden = true;
    notFound.hidden = true;
    message.hidden = false;
    message.replaceChildren(text);
    if (link) {
      const anchor = document.createElement('a');
      anchor.href = link.href;
      anchor.textContent = link.label;
      message.append(' ', anchor);
    }
  }

  // No book to show for this link. With a known ISBN (a book just removed,
  // or a book the Catalog did not know), Quick Add opens on that ISBN.
  function showNotFound(isbn: string | undefined, why = { title: t('book.not-in-library'), text: t('book.not-in-library-text') }) {
    loaded();
    article.hidden = true;
    message.hidden = true;
    notFound.hidden = false;
    document.title = `${why.title} · Atomes`;
    notFound.querySelector('[data-not-found-title]')!.textContent = why.title;
    notFound.querySelector('[data-not-found-text]')!.textContent = why.text;
    const add = notFound.querySelector<HTMLAnchorElement>('[data-not-found-add]')!;
    add.href = isbn ? `/check?isbn=${isbn}` : '/check';
    notFound.querySelector('[data-not-found-add-label]')!.textContent = t(isbn ? 'book.add-this-book' : 'book.add-a-book');
  }

  // No network: the connection status says it, and the listing tries again.
  // Another problem while the book or the Not found screen is shown goes in a
  // toast; before, in place of the book.
  function fail(error: unknown) {
    const network = isNetworkFailure(error);
    if (network) reportNetwork(false);
    if (article.hidden && notFound.hidden) say(spaceErrorMessage(error));
    else if (!network) toast(spaceErrorMessage(error), { error: true });
  }

  function render() {
    const shown = page;
    page = bookPage(work, library, editions);
    if (!page) {
      showNotFound(shown?.isbn ?? (isEditionWork(work) ? work.slice('isbn:'.length) : undefined));
      return;
    }
    loaded();
    message.hidden = true;
    notFound.hidden = true;
    if (stage.parentElement !== article) {
      cover.classList.remove('skeleton');
      article.prepend(stage);
    }
    article.hidden = false;
    pageBox.dataset.tone = page.copies.length > 0 ? 'owned' : 'not-owned';

    document.title = `${page.title} · Atomes`;
    document.querySelector('[data-view-title]')!.textContent = page.title;
    const volume = page.volumes.length > 0 ? t('book.volumes', page.volumes) : page.volume ? t('book.volume', page.volume) : '';
    showCover(cover, {
      src: page.cover,
      title: page.title,
      series: page.series,
      volumeTitle: page.volumeTitle,
      volume,
    });
    article.querySelector('[data-title]')!.textContent = page.title;
    article.querySelector('[data-volume-title]')!.textContent = page.volumeTitle ?? '';
    article.querySelector('[data-authors]')!.textContent = page.authors.join(', ');
    // The Series name opens the Series page, when the Catalog knows the Series.
    // A book the Catalog knows ends the line with "Change" (Series Correction).
    const seriesLine = article.querySelector<HTMLElement>('[data-series]')!;
    const seriesName = page.series && page.series !== page.title ? page.series : '';
    const known = editions.get(page.isbn);
    const seriesPage = known?.series ? seriesHref(page.isbn) : undefined;
    const parts = [
      seriesPage ? Object.assign(document.createElement('a'), { href: seriesPage, textContent: page.series ?? '' }) : seriesName,
      volume,
    ].filter(Boolean);
    seriesLine.replaceChildren(...parts.flatMap((part, index) => (index === 0 ? [part] : [' · ', part])), ...(known && parts.length ? [' · '] : []));
    article.querySelector<HTMLElement>('[data-series-line]')!.hidden = !known && parts.length === 0;
    renderIsland(
      known
        ? h(SeriesCorrection, {
            // A new answer starts the sheet again from it.
            key: `${known.series?.id}|${known.volume}|${known.corrected}`,
            editions: [known],
            onCorrected: ([edition], text) => corrected(edition, text),
          })
        : null,
      article.querySelector<HTMLElement>('[data-series-correction]')!,
    );

    statusSelect.value = page.status;
    started.hidden = page.status === 'unread';
    startedAt.value = page.startedAt?.slice(0, 10) ?? '';
    finished.hidden = page.status !== 'read';
    finishedAt.value = page.finishedAt?.slice(0, 10) ?? '';
    // Finished cannot be before Started: the date pickers say so too (dayCorrection).
    startedAt.max = finishedAt.value;
    finishedAt.min = startedAt.value;

    article.querySelector<HTMLElement>('[data-no-copies]')!.hidden = page.copies.length > 0;
    // Rebuilt only when they change: a reload while offline must not clear a name being typed.
    const copies = JSON.stringify(page.copies.map((copy) => ({ ...copy, acquiredAt: undefined })));
    if (copies !== renderedCopies) {
      renderedCopies = copies;
      copyList.replaceChildren(...page.copies.map(copyRow));
    }
    // The day of each Copy, in place: a rebuild would take the focus from a day being typed.
    page.copies.forEach(({ acquiredAt }, index) => {
      copyList.children[index].querySelector<HTMLInputElement>('[data-got-on]')!.value = acquiredAt?.slice(0, 10) ?? '';
    });
    const addCopy = article.querySelector<HTMLAnchorElement>('[data-add-copy]')!;
    addCopy.href = `/check?isbn=${page.isbn}`;
    addCopy.querySelector('[data-add-copy-label]')!.textContent = t(page.copies.length > 0 ? 'book.add-copy' : 'book.add-first-copy');
  }

  // The Catalog gives the Edition a Series Correction made or deleted: this
  // page and this device show it at once.
  function corrected(edition: Edition, text: string) {
    editions.set(edition.isbn, edition);
    void refreshCorrected(edition.isbn);
    toast(text);
    render();
  }

  function copyRow(copy: BookPage['copies'][number]): HTMLLIElement {
    const row = copyTemplate.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
    row.querySelector('[data-edition]')!.textContent = copy.edition || t('book.edition-unknown');
    row.querySelector('[data-isbn]')!.textContent = t('book.isbn', copy.isbn);
    // Lent: who has it and Mark returned. Not lent: Lend, which opens the Lend form.
    const loan = row.querySelector<HTMLElement>('[data-loan]')!;
    const lendForm = row.querySelector<HTMLFormElement>('[data-lend]')!;
    const lendOpen = row.querySelector<HTMLButtonElement>('[data-lend-open]')!;
    loan.hidden = !copy.loan;
    lendOpen.hidden = !!copy.loan;
    lendOpen.setAttribute('aria-label', t('book.lend-copy', copy.isbn));
    if (copy.loan) {
      loan.querySelector('[data-loan-text]')!.textContent = t('book.lent', copy.loan.borrower, shortDate(copy.loan.lentAt));
      const back = loan.querySelector<HTMLButtonElement>('[data-return]')!;
      back.setAttribute('aria-label', t('book.mark-returned-copy', copy.isbn));
      back.addEventListener('click', () => void save(() => markReturned(copy.rkey), back));
    }
    const day = row.querySelector<HTMLInputElement>('[data-got-on]')!;
    day.setAttribute('aria-label', t('book.got-on-copy', copy.isbn));
    day.addEventListener('change', () => {
      const saved = library.copies.find(({ rkey }) => rkey === copy.rkey);
      if (saved) void save(async () => (await saveCopy(space, gotOn(saved.value, day.value), copy.rkey)).state);
    });

    const input = lendForm.querySelector<HTMLInputElement>('input[name="borrower"]')!;
    lendForm.querySelector('[data-lend-button]')!.setAttribute('aria-label', t('book.lend-copy', copy.isbn));
    // The form takes the place of Lend while it is open, so one button only is named "Lend the Copy…".
    const showLend = (open: boolean) => {
      lendForm.hidden = !open;
      lendOpen.hidden = open;
      (open ? input : lendOpen).focus();
    };
    lendOpen.addEventListener('click', () => showLend(true));
    lendForm.querySelector('[data-lend-cancel]')!.addEventListener('click', () => showLend(false));
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') showLend(false);
    });
    lendForm.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!input.value.trim()) {
        input.focus();
        return;
      }
      void save(
        async () => (await saveLoan(space, lend(copy.rkey, input.value, new Date()))).state,
        lendForm.querySelector('button'),
      );
    });

    const past = row.querySelector<HTMLDetailsElement>('[data-past-loans]')!;
    past.hidden = copy.pastLoans.length === 0;
    past.querySelector('[data-past-loans-title]')!.textContent = t('book.past-loans', copy.pastLoans.length);
    past.querySelector('[data-past-loan-list]')!.replaceChildren(
      ...copy.pastLoans.map(({ borrower, lentAt, returnedAt }) => {
        const item = document.createElement('li');
        item.textContent = t('book.past-loan', borrower, shortDate(lentAt), shortDate(returnedAt));
        return item;
      }),
    );

    // "…": a menu under the button (over it in the lower half of the screen,
    // clear of the tab bar), closed by a tap outside or Escape. It follows the
    // button when the page or the panel scrolls.
    const more = row.querySelector<HTMLButtonElement>('[data-more]')!;
    const menu = row.querySelector<HTMLElement>('[data-menu]')!;
    more.setAttribute('aria-label', t('book.copy-more', copy.isbn));
    more.popoverTargetElement = menu;
    const place = () => {
      const box = more.getBoundingClientRect();
      const above = box.bottom > innerHeight / 2;
      menu.style.top = above ? 'auto' : `${box.bottom + 4}px`;
      menu.style.bottom = above ? `${innerHeight - box.top + 4}px` : 'auto';
      menu.style.right = `${document.documentElement.clientWidth - box.right}px`;
    };
    menu.addEventListener('beforetoggle', (event) => {
      if ((event as ToggleEvent).newState === 'open') {
        place();
        addEventListener('scroll', place, { capture: true, passive: true });
      } else removeEventListener('scroll', place, { capture: true });
    });
    const remove = row.querySelector<HTMLButtonElement>('[data-remove]')!;
    remove.setAttribute('aria-label', t('book.remove-copy', copy.isbn));
    remove.addEventListener('click', () => {
      menu.hidePopover();
      void removeWithUndo(copy.rkey, more);
    });
    return row;
  }

  function shortDate(iso: string): string {
    return new Intl.DateTimeFormat(pageLanguage(), { dateStyle: 'medium' }).format(new Date(iso));
  }

  // Set by start(): the open Space and its listing.
  let space: Space;
  let listing: { refresh: () => Promise<void> };
  // The toast of a change still waiting for the network; replaced when it is sent.
  let closeWaiting: () => void = () => undefined;

  // One change at a time: the book is inert while it saves (no dimming), and
  // the button that started it, if any, shows a spinner.
  // `then` gives the toast of a sent change its own text, and an action unless the change is refused.
  async function save(
    change: (space: Space) => Promise<WriteState | undefined>,
    button?: HTMLButtonElement | null,
    then: { sent?: string; action?: ToastAction } = {},
  ) {
    const focused = document.activeElement instanceof HTMLElement ? document.activeElement : undefined;
    article.inert = true;
    button?.setAttribute('aria-busy', 'true');
    try {
      const state = await change(space);
      if (state) {
        closeWaiting();
        const text = state === 'sent' && then.sent ? then.sent : await savedText(space, state);
        const close = toast(text, { error: state === 'refused', action: state === 'refused' ? undefined : then.action });
        if (state === 'waiting') {
          closeWaiting = close;
          sendLater();
        }
      }
    } catch (error) {
      toast(spaceErrorMessage(error), { error: true });
    } finally {
      button?.removeAttribute('aria-busy');
      article.inert = false;
      // Shows what is saved now, also after a refused change.
      await listing.refresh();
      if (focused?.isConnected) focused.focus();
    }
  }

  function sendLater() {
    if (sending) return;
    sending = true;
    sendWhenOnline(
      space,
      () => {
        sending = false;
        reportNetwork(true);
        reportWaiting(0);
        closeWaiting();
        toast(t('saved.sent'));
      },
      (error) => toast(spaceErrorMessage(error), { error: true }),
    );
  }

  async function markReturned(copy: string) {
    const states = await Promise.all(returnLoans(copy, library, new Date()).map(async ({ rkey, value }) => (await saveLoan(space, value, rkey)).state));
    return worstState(states);
  }

  // Remove asks nothing first: its toast offers Undo, which puts back the same Copy and its Loans.
  async function removeWithUndo(copy: string, button: HTMLButtonElement) {
    let undo: Removed['undo'] | undefined;
    await save(
      async (own) => {
        const removed = await removeCopy(own, copy, library);
        undo = removed.undo;
        return removed.state;
      },
      button,
      { sent: t('book.copy-removed'), action: { label: t('common.undo'), run: () => undo && void save(undo) } },
    );
  }

  function readingStatus(): ReadingStatus | undefined {
    return library.readingStatuses.find(({ rkey }) => rkey === work)?.value;
  }

  statusSelect.addEventListener('change', () => {
    const chosen = statuses.find((status) => status === statusSelect.value);
    if (!page || !chosen) return;
    const now = new Date();
    const change = statusChange(work, page.isbn, chosen, library, now, { dated: true });
    if (!change) return;
    // Back to "not yet" removes both days (ADR 0019): Undo puts the record back.
    const before = readingStatus();
    const undo = chosen === 'unread' && before ? { label: t('common.undo'), run: () => void save(() => saveReadingStatus(space, before)) } : undefined;
    // Marking a Volume read follows its Series (glossary: Followed Series).
    const edition = editions.get(page.isbn);
    const follow = followOnRead(edition, chosen, library, now);
    // Abandoning a Volume of a Followed Series suggests dropping the Series; the Series page does it.
    const suggest = suggestsDrop(edition, chosen, library) && edition?.series;
    const isbn = page.isbn;
    void save(
      async () => {
        const state = await saveReadingStatus(space, change);
        return follow ? worstState([state, await saveFollow(space, follow)]) : state;
      },
      undefined,
      { action: undo },
    ).then(() => {
      if (suggest) toast(t('series.drop-suggest', suggest.title), { link: { href: seriesHref(isbn), label: t('series.open') } });
    });
  });

  // The reader corrects a day. A finish day before the start day is not
  // saved: the toast says why and the field shows the saved day again.
  function correctDay(field: 'startedAt' | 'finishedAt', input: HTMLInputElement) {
    const current = readingStatus();
    if (!current || current.status === 'unread' || (field === 'finishedAt' && current.status !== 'read')) return;
    const next = dayCorrection(current, field, input.value, new Date());
    if ('problem' in next) {
      toast(t('book.finished-before-started'), { error: true });
      input.value = current[field]?.slice(0, 10) ?? '';
      return;
    }
    void save(() => saveReadingStatus(space, next));
  }

  startedAt.addEventListener('change', () => correctDay('startedAt', startedAt));
  finishedAt.addEventListener('change', () => correctDay('finishedAt', finishedAt));

  async function start() {
    if (!isWorkId(work)) return showNotFound(undefined, { title: t('book.not-found'), text: t('book.bad-link') });
    const own = await openOwnSpace();
    // No session: the gate (AppShell) is sending the visitor to the sign-in screen.
    if (!own) return;
    space = own.space;
    listing = freshListing(
      async () => {
        const loaded = await loadLibrary(space);
        const missing = bookIsbns(work, loaded.library).filter((isbn) => !editions.has(isbn));
        for (const [isbn, edition] of await lookupEditions(missing)) editions.set(isbn, edition);
        return { ...loaded, waiting: await waitingCount(space) };
      },
      (loaded) => {
        // Stale: the PDS did not answer, so this is the copy on this device.
        reportNetwork(!loaded.stale);
        reportWaiting(loaded.waiting);
        library = loaded.library;
        render();
      },
      fail,
    );
    await listing.refresh();
  }

  start().catch(fail);
</script>

<style>
  /*
   * The one look (ADR 0018): tokens of theme.css only. The sizes of this page
