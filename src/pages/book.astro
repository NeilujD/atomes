---
// Book page: one Work of the Library, from the reader's records and the
// Catalog (src/lib/library/model.ts). `?work=<Catalog identifier>`.
import Icon from '../components/Icon.astro';
import AppShell from '../layouts/AppShell.astro';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));

const choices = [
  { value: 'unread', label: t('status.unread') },
  { value: 'reading', label: t('status.reading') },
  { value: 'read', label: t('status.read') },
  { value: 'abandoned', label: t('status.abandoned') },
];
---

<AppShell title={t('book.title')} current="library" detail>
  <div class="book-page" data-page aria-busy="true">
    <!-- Only when there is no book to show (not signed in, not in the Library); results of a change are toasts. -->
    <p class="message" data-message role="status" hidden></p>

    <!-- No Copy and no Reading Status for this Work, or no Work in the link. -->
    <section class="not-found" data-not-found aria-labelledby="not-found-title" hidden>
      <div class="not-found-cover" aria-hidden="true">
        <Icon name="book-plus" size={24} />
      </div>
      <h2 class="not-found-title" id="not-found-title" data-not-found-title>{t('book.not-in-library')}</h2>
      <p class="not-found-text" data-not-found-text>{t('book.not-in-library-text')}</p>
      <div class="not-found-actions">
        <a class="button button-primary" href="/add" data-not-found-add>
          <Icon name="plus" />
          <span data-not-found-add-label>{t('book.add-a-book')}</span>
        </a>
        <a class="button button-quiet" href="/">{t('link.home')}</a>
      </div>
    </section>

    <div class="book" data-skeleton aria-hidden="true">
      <div class="cover skeleton"></div>
      <div class="content">
        <div class="head-text skeleton-text">
          <div class="skeleton skeleton-title"></div>
          <div class="skeleton skeleton-line"></div>
          <div class="skeleton skeleton-line short"></div>
        </div>
      </div>
    </div>

    <article class="book" data-book hidden>
      <div class="cover" data-cover></div>
      <div class="content">
        <div class="head-text">
          <p class="title" data-title aria-hidden="true"></p>
          <p class="line" data-volume-title></p>
          <p class="line strong" data-authors></p>
          <p class="line" data-series></p>
        </div>

        <section class="group" aria-labelledby="status-title">
          <h2 class="group-title" id="status-title">{t('book.reading-status')}</h2>
          <div class="segmented" role="radiogroup" aria-labelledby="status-title" data-status>
            {
              choices.map((choice) => (
                <label class="segment">
                  <input type="radio" name="status" value={choice.value} />
                  <span>{choice.label}</span>
                </label>
              ))
            }
          </div>
          <div class="finished" data-finished hidden>
            <label class="label" for="finished-at">{t('book.finished-on')}</label>
            <input class="field" id="finished-at" type="date" data-finished-at />
            <span class="hint">{t('book.optional')}</span>
          </div>
        </section>

        <section class="group" aria-labelledby="copies-title">
          <h2 class="group-title" id="copies-title">{t('book.copies')}</h2>
          <p class="hint" data-no-copies hidden>{t('book.no-copies')}</p>
          <ul class="copies" data-copies></ul>
          <a class="button" href="/add" data-add-copy>
            <Icon name="plus" />
            <span>{t('book.add-copy')}</span>
          </a>
        </section>
      </div>
    </article>
  </div>

  <template data-copy-template>
    <li class="copy">
      <div class="copy-head">
        <div class="copy-text">
          <p class="strong" data-edition></p>
          <p class="hint" data-isbn></p>
        </div>
        <button class="button button-quiet" type="button" data-remove>
          <Icon name="trash" />
          <span>{t('book.remove')}</span>
        </button>
      </div>
      <form class="lent" data-lent>
        <label class="lent-field">
          <span class="label">{t('book.lent-to')}</span>
          <input
            class="field"
            name="lentTo"
            type="text"
            maxlength="64"
            autocomplete="off"
            placeholder={t('book.lent-to-placeholder')}
          />
        </label>
        <button class="button" type="submit">{t('book.save')}</button>
      </form>
    </li>
  </template>
</AppShell>

<script>
  import { openOwnSpace } from '../lib/auth/browser-client';
  import type { Edition } from '../lib/catalog/catalog';
  import { lookupEditions } from '../lib/catalog/client';
  import { deleteCopy, saveCopy, type Copy } from '../lib/library/copy';
  import { isEditionWork, isWorkId } from '../lib/library/ids';
  import { reportNetwork, reportWaiting } from '../lib/connection';
  import { saveFollow } from '../lib/library/follow';
  import { t } from '../lib/i18n/i18n';
  import { loadLibrary, sendWhenOnline, waitingCount, worstState } from '../lib/library/library';
  import { bookPage, statusChange, type BookPage, type Library } from '../lib/library/model';
  import { followOnRead } from '../lib/library/onboarding';
  import { saveReadingStatus, statuses, type ReadingStatus } from '../lib/library/reading-status';
  import { isNetworkFailure } from '../lib/network';
  import { freshListing } from '../lib/space/fresh-listing';
  import { spaceErrorMessage, type Space, type WriteState } from '../lib/space/space';
  import { toast } from '../lib/toast';

  const pageBox = document.querySelector<HTMLElement>('[data-page]')!;
  const message = document.querySelector<HTMLElement>('[data-message]')!;
  const notFound = document.querySelector<HTMLElement>('[data-not-found]')!;
  const skeleton = document.querySelector<HTMLElement>('[data-skeleton]')!;
  const article = document.querySelector<HTMLElement>('[data-book]')!;
  const statusRadios = article.querySelectorAll<HTMLInputElement>('[data-status] input[name="status"]');
  const finished = article.querySelector<HTMLElement>('[data-finished]')!;
  const finishedAt = article.querySelector<HTMLInputElement>('[data-finished-at]')!;
  const copyList = article.querySelector<HTMLUListElement>('[data-copies]')!;
  const copyTemplate = document.querySelector<HTMLTemplateElement>('[data-copy-template]')!;

  const work = new URLSearchParams(location.search).get('work') ?? '';
  // Catalog answers kept for this visit, so an offline reload of the records keeps the titles.
  const editions = new Map<string, Edition>();
  let library: Library = { copies: [], readingStatuses: [], follows: [] };
  let page: BookPage | undefined;
  let renderedCopies = '';
  let sending = false;

  function loaded() {
    skeleton.hidden = true;
    pageBox.removeAttribute('aria-busy');
  }

  // The page has no book to show: say why, in place of the book.
  function say(text: string, link?: { href: string; label: string }) {
    loaded();
    article.hidden = true;
    notFound.hidden = true;
    message.hidden = false;
    message.replaceChildren(text);
    if (link) {
      const anchor = document.createElement('a');
      anchor.href = link.href;
      anchor.textContent = link.label;
      message.append(' ', anchor);
    }
  }

  // No book to show for this link. With a known ISBN (a book just removed,
  // or a book the Catalog did not know), Quick Add opens on that ISBN.
  function showNotFound(isbn: string | undefined, why = { title: t('book.not-in-library'), text: t('book.not-in-library-text') }) {
    loaded();
    article.hidden = true;
    message.hidden = true;
    notFound.hidden = false;
    document.title = `${why.title} · Atomes`;
    notFound.querySelector('[data-not-found-title]')!.textContent = why.title;
    notFound.querySelector('[data-not-found-text]')!.textContent = why.text;
    const add = notFound.querySelector<HTMLAnchorElement>('[data-not-found-add]')!;
    add.href = isbn ? `/add?isbn=${isbn}` : '/add';
    notFound.querySelector('[data-not-found-add-label]')!.textContent = t(isbn ? 'book.add-this-book' : 'book.add-a-book');
  }

  // No network: the connection status says it, and the listing tries again.
  // Another problem while the book or the Not found screen is shown goes in a
  // toast; before, in place of the book.
  function fail(error: unknown) {
    const network = isNetworkFailure(error);
    if (network) reportNetwork(false);
    if (article.hidden && notFound.hidden) say(spaceErrorMessage(error));
    else if (!network) toast(spaceErrorMessage(error), { error: true });
  }

  function render() {
    const shown = page;
    page = bookPage(work, library, editions);
    if (!page) {
      showNotFound(shown?.isbn ?? (isEditionWork(work) ? work.slice('isbn:'.length) : undefined));
      return;
    }
    loaded();
    message.hidden = true;
    notFound.hidden = true;
    article.hidden = false;

    document.title = `${page.title} · Atomes`;
    document.querySelector('[data-view-title]')!.textContent = page.title;
    const cover = article.querySelector<HTMLElement>('[data-cover]')!;
    if (cover.querySelector('img')?.getAttribute('src') !== page.cover) {
      cover.replaceChildren();
      if (page.cover) {
        const image = document.createElement('img');
        image.src = page.cover;
        image.alt = '';
        cover.append(image);
      }
    }
    article.querySelector('[data-title]')!.textContent = page.title;
    article.querySelector('[data-volume-title]')!.textContent = page.volumeTitle ?? '';
    article.querySelector('[data-authors]')!.textContent = page.authors.join(', ');
    article.querySelector('[data-series]')!.textContent = [
      page.series && page.series !== page.title ? page.series : '',
      page.volume ? t('book.volume', page.volume) : '',
    ]
      .filter(Boolean)
      .join(' · ');

    for (const radio of statusRadios) radio.checked = radio.value === page.status;
    finished.hidden = page.status !== 'read';
    finishedAt.value = page.finishedAt?.slice(0, 10) ?? '';

    article.querySelector<HTMLElement>('[data-no-copies]')!.hidden = page.copies.length > 0;
    // Rebuilt only when they change: a reload while offline must not clear a Lent To being typed.
    const copies = JSON.stringify(page.copies);
    if (copies !== renderedCopies) {
      renderedCopies = copies;
      copyList.replaceChildren(...page.copies.map(copyRow));
    }
    article.querySelector<HTMLAnchorElement>('[data-add-copy]')!.href = `/add?isbn=${page.isbn}`;
  }

  function copyRow(copy: BookPage['copies'][number]): HTMLLIElement {
    const row = copyTemplate.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
    row.querySelector('[data-edition]')!.textContent = copy.edition || t('book.edition-unknown');
    row.querySelector('[data-isbn]')!.textContent = t('book.isbn', copy.isbn);
    const input = row.querySelector<HTMLInputElement>('input[name="lentTo"]')!;
    input.value = copy.lentTo ?? '';
    const lent = row.querySelector<HTMLFormElement>('[data-lent]')!;
    lent.addEventListener('submit', (event) => {
      event.preventDefault();
      void save(() => lend(copy.rkey, input.value.trim()), lent.querySelector('button'));
    });
    const remove = row.querySelector<HTMLButtonElement>('[data-remove]')!;
    remove.setAttribute('aria-label', t('book.remove-copy', copy.isbn));
    remove.addEventListener('click', () => void save((space) => deleteCopy(space, copy.rkey), remove));
    return row;
  }

  // Set by start(): the open Space and its listing.
  let space: Space;
  let listing: { refresh: () => Promise<void> };
  // The toast of a change still waiting for the network; replaced when it is sent.
  let closeWaiting: () => void = () => undefined;

  // One change at a time: the book is inert while it saves (no dimming), and
  // the button that started it, if any, shows a spinner.
  async function save(change: (space: Space) => Promise<WriteState | undefined>, button?: HTMLButtonElement | null) {
    const focused = document.activeElement instanceof HTMLElement ? document.activeElement : undefined;
    article.inert = true;
    button?.setAttribute('aria-busy', 'true');
    try {
      const state = await change(space);
      if (state) {
        closeWaiting();
        const close = toast(t(`saved.${state}`), { error: state === 'refused' });
        if (state === 'waiting') {
          closeWaiting = close;
          sendLater();
        }
      }
    } catch (error) {
      toast(spaceErrorMessage(error), { error: true });
    } finally {
      button?.removeAttribute('aria-busy');
      article.inert = false;
      // Shows what is saved now, also after a refused change.
      await listing.refresh();
      if (focused?.isConnected) focused.focus();
    }
  }

  function sendLater() {
    if (sending) return;
    sending = true;
    sendWhenOnline(
      space,
      () => {
        sending = false;
        reportNetwork(true);
        reportWaiting(0);
        closeWaiting();
        toast(t('saved.sent'));
      },
      (error) => toast(spaceErrorMessage(error), { error: true }),
    );
  }

  async function lend(rkey: string, name: string) {
    const saved = library.copies.find((copy) => copy.rkey === rkey);
    if (!saved) return undefined;
    const copy: Copy = { ...saved.value };
    if (name) copy.lentTo = name;
    else delete copy.lentTo;
    return (await saveCopy(space, copy, rkey)).state;
  }

  function readingStatus(): ReadingStatus | undefined {
    return library.readingStatuses.find(({ rkey }) => rkey === work)?.value;
  }

  for (const radio of statusRadios) {
    radio.addEventListener('change', () => {
      const chosen = statuses.find((status) => status === radio.value);
      if (!page || !chosen) return;
      const now = new Date();
      const change = statusChange(work, page.isbn, chosen, library, now);
      if (!change) return;
      // Marking a Volume read follows its Series (glossary: Followed Series).
      const follow = followOnRead(editions.get(page.isbn), chosen, library, now);
      void save(async () => {
        const state = await saveReadingStatus(space, change);
        return follow ? worstState([state, await saveFollow(space, follow)]) : state;
      });
    });
  }

  finishedAt.addEventListener('change', () => {
    const current = readingStatus();
    if (current?.status !== 'read') return;
    const next: ReadingStatus = { ...current, updatedAt: new Date().toISOString() };
    if (finishedAt.value) next.finishedAt = `${finishedAt.value}T00:00:00.000Z`;
    else delete next.finishedAt;
    void save(() => saveReadingStatus(space, next));
  });

  async function start() {
    if (!isWorkId(work)) return showNotFound(undefined, { title: t('book.not-found'), text: t('book.bad-link') });
    const own = await openOwnSpace();
    if (!own) return say(t('book.sign-in'), { href: '/settings', label: t('link.settings') });
    space = own.space;
    listing = freshListing(
      async () => {
        const loaded = await loadLibrary(space);
        const isbns = [
          ...loaded.library.copies.filter(({ value }) => value.works.includes(work)).map(({ value }) => value.isbn),
          ...loaded.library.readingStatuses.filter(({ rkey }) => rkey === work).map(({ value }) => value.isbn),
        ];
        // An `isbn:` Work is a book the Catalog did not know: the page shows what
        // the reader typed, and asking again only gets a 404 on each load.
        const missing = isEditionWork(work) ? [] : isbns.filter((isbn) => !editions.has(isbn));
        for (const [isbn, edition] of await lookupEditions(missing)) editions.set(isbn, edition);
        return { ...loaded, waiting: await waitingCount(space) };
      },
      (loaded) => {
        // Stale: the PDS did not answer, so this is the copy on this device.
        reportNetwork(!loaded.stale);
        reportWaiting(loaded.waiting);
        library = loaded.library;
        render();
      },
      fail,
    );
    await listing.refresh();
  }

  start().catch(fail);
</script>

<style>
  .book-page {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .skeleton-text {
    gap: 10px;
  }

  .skeleton-title {
    width: 80%;
    height: 26px;
  }

  .skeleton-line {
    width: 55%;
    height: 14px;
  }

  .skeleton-line.short {
    width: 40%;
  }

  .message {
    font-size: 14px;
  }

  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    max-width: 360px;
    margin: 48px auto 0;
    text-align: center;
  }

  .not-found[hidden] {
    display: none;
  }

  /* An empty book, the size of a small cover. */
  .not-found-cover {
    display: grid;
    place-items: center;
    width: 72px;
    aspect-ratio: 2 / 3;
    margin-bottom: 12px;
    border-radius: var(--radius-cover);
    background: var(--soft);
    color: var(--secondary);
  }

  .not-found-title {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .not-found-text {
    margin: 0;
    color: var(--secondary);
    font-size: 14px;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }

  /* Phone: cover and title side by side, then the sections at full width. */
  .book {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 28px 16px;
    align-items: end;
  }

  .content {
    display: contents;
  }

  .content > section {
    grid-column: 1 / -1;
  }

  .cover {
    flex: none;
    width: 96px;
    align-self: flex-start;
    overflow: hidden;
    border-radius: var(--radius-cover);
    box-shadow: 0 0 0 1px var(--cover-edge);
  }

  /* No cover: a book-shaped placeholder. */
  .cover:empty {
    aspect-ratio: 2 / 3;
    background: var(--soft);
  }

  /* The whole cover, at its own ratio: covers are not all 2:3. */
  .cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .head-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .title {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .line {
    color: var(--secondary);
    font-size: 14px;
  }

  .line.strong {
    color: var(--ink);
    font-size: 16px;
  }

  .line:empty {
    display: none;
  }

  .strong {
    font-weight: 600;
  }

  .group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .group-title {
    font-size: 16px;
  }

  .label {
    font-size: 14px;
    font-weight: 600;
  }

  .hint {
    color: var(--secondary);
    font-size: 13px;
  }

  .finished {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .copies {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .copy-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .copy-text {
    min-width: 0;
  }

  .lent {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .lent-field {
    flex: 1 1 200px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lent-field .field {
    flex: 1;
  }

  /* Desktop: cover at the left, the rest beside it; the title is content (ui-direction: Detail). */
  @media (min-width: 960px) {
    .book-page {
      margin: 16px auto 0;
    }

    .skeleton-title {
      height: 36px;
    }

    .book {
      display: flex;
      align-items: flex-start;
      gap: 40px;
    }

    .content {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .cover {
      width: 200px;
    }

    .head-text {
      gap: 6px;
    }

    .title {
      font-size: 36px;
    }

    .group-title {
      display: flex;
      align-items: center;
      align-self: stretch;
      min-height: var(--row);
      border-bottom: 1px solid var(--line);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0;
    }

    .copies {
      border-top: 0;
    }

    .lent-field {
      flex: 0 1 320px;
    }
  }
</style>
