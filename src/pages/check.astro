---
// Check a book: scan the barcode or type the ISBN, see the Shelf Check answer
// (owned, read, missing from a Followed Series, or not in the Library) on the
// result screen (CORE-120), then Quick Add from it. The barcode is read on the
// device (ADR 0003). Offline (CORE-37), the answer comes from this device
// only: the Library copy and the Catalog data kept for it
// (src/lib/catalog/device.ts); no ISBN is sent, and a Copy added waits in the
// write queue. The Atomes server only gets the ISBN to look up, never the
// answer (ADR 0001). An ISBN the Catalog does not know: the reader types the
// book in the form of this page.
import Icon from '../components/Icon.astro';
import AppShell from '../layouts/AppShell.astro';
import '../styles/shelf-check-result.css';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));

const answers = [
  { value: 'unread', label: t('status.unread') },
  { value: 'reading', label: t('status.reading') },
  { value: 'read', label: t('status.read') },
];
---

<AppShell title={t('check.title')} current="check">
  <div class="quick-add">
    <!-- Shown only where the browser can open a camera (HTTPS or loopback). -->
    <button class="button button-primary scan" type="button" data-scan hidden>
      <Icon name="scan-barcode" />
      <span>{t('add.scan')}</span>
    </button>

    <!-- data-state: starting | looking | wrong | found (set by the script, styled below). -->
    <dialog class="camera" data-camera data-state="starting" aria-label={t('add.scan')}>
      <video class="camera-video" data-video muted playsinline></video>
      <div class="viewfinder" aria-hidden="true">
        <span class="scan-line"></span>
        <span class="found-mark"><Icon name="check" size={32} /></span>
      </div>
      <button class="camera-close" type="button" aria-label={t('common.close')} data-camera-close>
        <Icon name="x" size={22} />
      </button>
      <div class="camera-bottom">
        <p class="camera-text" data-camera-text aria-live="polite">{t('add.camera-starting')}</p>
        <!-- A small link: the camera is what the reader came for (CORE-97). -->
        <button class="camera-type" type="button" data-camera-close>{t('add.type-isbn')}</button>
      </div>
    </dialog>

    <!-- The result screen of a book the Catalog knows (src/islands/ShelfCheckResult.tsx). -->
    <dialog class="result" data-result aria-label={t('check.result')}>
      <div class="result-root" data-result-root></div>
    </dialog>

    <form class="isbn-form" data-isbn-form>
      <label class="label" for="isbn">{t('add.isbn')}</label>
      <div class="isbn-row">
        <input
          class="field"
          id="isbn"
          name="isbn"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          placeholder="978 2 7234 7899 1"
          aria-describedby="isbn-hint"
        />
        <button class="button" type="submit">{t('add.look-up')}</button>
      </div>
      <!-- The hint line also says what is wrong with the ISBN: the page does not move. -->
      <p class="hint" id="isbn-hint" data-hint aria-live="polite">{t('add.isbn-hint')}</p>
      <!-- Shown once the Catalog data for Shelf Check offline is on this device. -->
      <p class="hint" data-kept hidden>{t('check.kept')}</p>
    </form>

    <!-- While the book and the Library are read: the result screen opens after. -->
    <div class="book" data-skeleton hidden aria-hidden="true">
      <div class="cover book-cover skeleton"></div>
      <div class="book-text skeleton-text">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-line"></div>
        <div class="skeleton skeleton-line short"></div>
      </div>
    </div>

    <!-- A book the Catalog does not know: the reader types it. -->
    <form class="preview" data-add-form hidden>
      <!-- The Shelf Check answer (src/islands/ShelfCheckAnswer.tsx), first: a
           placeholder holds its place until the Library is read. -->
      <div class="answer" data-answer hidden></div>

      <!-- maxlength keeps each field inside the Copy lexicon (bookDetails). -->
      <fieldset class="details" data-details>
        <legend class="details-title">{t('add.type-book')}</legend>
        <p class="hint" data-details-isbn></p>
        <label class="details-field">
          <span class="label">{t('add.field-title')}</span>
          <input class="field" name="title" type="text" maxlength="300" autocomplete="off" required />
        </label>
        <label class="details-field">
          <span class="label">{t('add.field-authors')}</span>
          <input class="field" name="authors" type="text" maxlength="1300" autocomplete="off" aria-describedby="authors-hint" />
          <span class="hint" id="authors-hint">{t('add.authors-hint')}</span>
        </label>
        <div class="details-row">
          <label class="details-field">
            <span class="label">{t('add.field-series')}</span>
            <input class="field" name="series" type="text" maxlength="300" autocomplete="off" />
          </label>
          <label class="details-field volume">
            <span class="label">{t('add.field-volume')}</span>
            <input class="field" name="volume" type="text" maxlength="16" autocomplete="off" />
          </label>
        </div>
        <p class="hint" data-details-problem data-error aria-live="polite"></p>
        <!-- Find the Series or Work in BnF by the typed title (src/islands/FindInBnf.tsx). -->
        <div data-find></div>
      </fieldset>

      <div class="question">
        <label class="label" for="read-status">{t('add.read-question')}</label>
        <span class="status-chip">
          <select id="read-status" name="status">
            {answers.map((answer) => <option value={answer.value}>{answer.label}</option>)}
          </select>
          <Icon name="chevron-down" />
        </span>
      </div>

      <!-- Main action when the reader does not own the book; Add another Copy when they do. -->
      <button class="button button-accent add" type="submit">
        <Icon name="book-plus" />
        <span data-add-label>{t('add.submit')}</span>
      </button>

      <!-- One quiet line: a Copy is never Shared, so there is nothing to change yet. -->
      <p class="private-line">
        <Icon name="lock" size={14} />
        <span>{t('add.private')}</span>
      </p>
    </form>
  </div>
</AppShell>

<script>
  import { h, render } from 'preact';
  import { FindInBnf } from '../islands/FindInBnf';
  import { ShelfCheckAnswer } from '../islands/ShelfCheckAnswer';
  import { ShelfCheckResult } from '../islands/ShelfCheckResult';
  import { openOwnSpace } from '../lib/auth/server-client';
  import type { Edition } from '../lib/catalog/catalog';
  import { coverUrl, lookupEdition, lookupVolumes } from '../lib/catalog/client';
  import { deviceCatalog } from '../lib/catalog/device';
  import { saveCopy, typedDetails, type BookDetails, type TypedFields } from '../lib/library/copy';
  import { editionWork, readIsbn } from '../lib/library/ids';
  import { cameraProblem, loadReader, openCamera, watchBarcodes } from '../lib/scan/barcode';
  import { reportNetwork, reportWaiting } from '../lib/connection';
  import { t } from '../lib/i18n/i18n';
  import { saveFollow } from '../lib/library/follow';
  import { loadLibrary, savedText, sendWhenOnline, waitingCount, worstState } from '../lib/library/library';
  import { addedOn, bookHref, currentStatus, statusChange, type Library } from '../lib/library/model';
  import { followOnRead, noOnboarding } from '../lib/library/onboarding';
  import { saveReadingStatus, statuses, type Status } from '../lib/library/reading-status';
  import { catalogAnswer, deviceShelfCheck, followedLine, keptOnDevice, readerLine, shelfCheck, type ShelfCheck } from '../lib/library/shelf-check';
  import { followSeries } from '../lib/library/series';
  import { latestOnly } from '../lib/latest';
  import { lockWhileSaving } from '../lib/save-lock';
  import { spaceErrorMessage, type Space, type WriteState } from '../lib/space/space';
  import { toast } from '../lib/toast';

  const isbnForm = document.querySelector<HTMLFormElement>('[data-isbn-form]')!;
  const isbnInput = isbnForm.querySelector<HTMLInputElement>('input[name="isbn"]')!;
  const lookUpButton = isbnForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const hint = isbnForm.querySelector<HTMLElement>('[data-hint]')!;
  const defaultHint = hint.textContent.trim();
  const skeleton = document.querySelector<HTMLElement>('[data-skeleton]')!;
  const addForm = document.querySelector<HTMLFormElement>('[data-add-form]')!;
  const addButton = addForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const answer = addForm.querySelector<HTMLElement>('[data-answer]')!;
  const kept = isbnForm.querySelector<HTMLElement>('[data-kept]')!;
  const statusSelect = addForm.querySelector<HTMLSelectElement>('select[name="status"]')!;
  // The reader can answer before the Library has loaded: that answer wins over the Library's.
  let statusChosen = false;
  statusSelect.addEventListener('change', () => (statusChosen = true));
  const details = addForm.querySelector<HTMLFieldSetElement>('[data-details]')!;
  const detailsProblem = details.querySelector<HTMLElement>('[data-details-problem]')!;
  const detail = (name: keyof TypedFields) => details.querySelector<HTMLInputElement>(`input[name="${name}"]`)!;
  const typed = () =>
    typedDetails({ title: detail('title').value, authors: detail('authors').value, series: detail('series').value, volume: detail('volume').value });
  const find = details.querySelector<HTMLElement>('[data-find]')!;
  const scanButton = document.querySelector<HTMLButtonElement>('[data-scan]')!;
  const camera = document.querySelector<HTMLDialogElement>('[data-camera]')!;
  const video = camera.querySelector<HTMLVideoElement>('[data-video]')!;
  const cameraText = camera.querySelector<HTMLElement>('[data-camera-text]')!;
  const resultDialog = document.querySelector<HTMLDialogElement>('[data-result]')!;
  const resultRoot = resultDialog.querySelector<HTMLElement>('[data-result-root]')!;

  // The Space opens once; undefined when signed out.
  const own = openOwnSpace();
  // The Catalog data this device keeps for Shelf Check offline.
  const device = deviceCatalog({});
  // Lookups can answer out of order (offline ones too): only the latest shows.
  const startLookUp = latestOnly();
  // Where a lookup came from: after Add, the reader goes back there.
  type Origin = 'scan' | 'typed';
  // The book looked up: a Catalog Edition, or an ISBN the Catalog does not
  // know, which the reader types (its Work is then `isbn:<isbn>`, ADR 0010).
  interface Book {
    isbn: string;
    work: string;
    edition?: Edition;
  }
  let book: Book | undefined;
  // An answer made offline from this device, and the Library it read.
  interface OnDevice {
    check: ShelfCheck;
    library: Library;
  }
  // The result screen: the book, its answer, and where its actions stand.
  interface Result {
    book: Book;
    // The title with no Edition (offline, no Catalog data here).
    title: string;
    from: Origin;
    check: ShelfCheck;
    offline: boolean;
    cover: string | null;
    seriesLoading: boolean;
    following: boolean;
    saving?: 'add' | 'read';
  }
  let result: Result | undefined;
  const noLibrary = (): Library => ({ copies: [], readingStatuses: [], follows: [], loans: [], toBuy: [] });
  let library = noLibrary();
  let sending = false;

  // A problem, in the hint line; no argument puts the hint back. Only a wrong
  // ISBN marks the field invalid, not a camera that did not open.
  function problem(text?: string, fieldIsWrong = Boolean(text)) {
    hint.textContent = text ?? defaultHint;
    hint.toggleAttribute('data-error', Boolean(text));
    isbnInput.toggleAttribute('aria-invalid', fieldIsWrong);
  }

  function busy(button: HTMLButtonElement, on: boolean) {
    button.disabled = on;
    if (on) button.setAttribute('aria-busy', 'true');
    else button.removeAttribute('aria-busy');
  }

  async function lookUp(from: Origin) {
    const current = startLookUp();
    const read = readIsbn(isbnInput.value);
    addForm.hidden = true;
    book = undefined;
    if ('problem' in read) return problem(t(`isbn.${read.problem}`));
    const { isbn } = read;
    problem();
    busy(lookUpButton, true);
    skeleton.hidden = false;
    let asked: Awaited<ReturnType<typeof catalogAnswer>>;
    try {
      // Offline, the Catalog is not asked: the ISBN stays on this device.
      asked = await catalogAnswer(isbn, navigator.onLine, lookupEdition);
    } catch {
      return problem(t('add.lookup-failed'));
    } finally {
      busy(lookUpButton, false);
      skeleton.hidden = true;
    }
    // Another ISBN was looked up meanwhile: its answer is the one to show.
    if (!current()) return;
    if ('offline' in asked) {
      reportNetwork(false);
      return lookUpOnDevice(isbn, from, current);
    }
    if ('unavailable' in asked) return problem(t('add.sources-down'));
    reportNetwork(true);
    // notFound: no book source knows this ISBN, so the reader types the book.
    await ('found' in asked ? show(asked.found, from) : showUnknown(isbn));
  }

  // The Shelf Check with no network, from this device only (shelf-check.ts).
  async function lookUpOnDevice(isbn: string, from: Origin, current: () => boolean) {
    const space = await openSpaceOrSay();
    if (!space) return;
    let onDevice: Library;
    try {
      onDevice = (await loadLibrary(space)).library;
    } catch {
      // No copy of the Library on this device: nothing to answer from.
      if (current()) problem(t('check.no-library'));
      return;
    }
    const { check, edition } = await deviceShelfCheck(isbn, onDevice, device);
    if (!current()) return;
    const given = { check, library: onDevice };
    if (edition) return show(edition, from, given, current);
    // No Catalog data for this ISBN here: the answer only, with what the reader typed on a Copy, if any.
    const title = onDevice.copies.find(({ value }) => value.isbn === isbn && value.details)?.value.details?.title ?? t('book.isbn', isbn);
    await showResult({ isbn, work: editionWork(isbn) }, from, { title, cover: null, onDevice: given });
  }

  async function show(found: Edition, from: Origin, onDevice?: OnDevice, current = () => true) {
    // Offline, only a cover this device has: asking for another would send the ISBN.
    const cover = !onDevice || (await device.hasCover(found.isbn));
    if (!current()) return;
    await showResult({ isbn: found.isbn, work: found.work.id, edition: found }, from, { title: found.title, cover: cover ? coverUrl(found) : null, onDevice });
  }

  // The result screen for a book the Catalog knows, once the Library tells
  // the answer: the screen opens in its colour. `onDevice`: the answer
  // offline, already made from this device.
  async function showResult(next: Book, from: Origin, { title, cover, onDevice }: { title: string; cover: string | null; onDevice?: OnDevice }) {
    book = next;
    addForm.hidden = true;
    render(null, find);
    let check: ShelfCheck;
    let seriesLoading = false;
    if (onDevice) {
      library = onDevice.library;
      check = onDevice.check;
    } else {
      skeleton.hidden = false;
      const read = await readLibrary();
      library = read ?? noLibrary();
      // A Followed Series: its Edition Line tells whether this Volume is missing.
      const anchor = read && followedLine(next.edition, library);
      const line = anchor ? await editionLine(anchor) : undefined;
      if (book !== next) return;
      skeleton.hidden = true;
      // No Library to read (no copy on this device and no network): this device cannot tell.
      check = read ? shelfCheck(next.isbn, next.edition, library, line) : { kind: 'unknown', status: 'unread', followed: null };
      seriesLoading = read !== undefined && seriesLineComes(next);
    }
    result = { book: next, title, from, check, offline: onDevice !== undefined, cover, seriesLoading, following: false };
    showResultScreen();
    openResult();
    if (seriesLoading) await addSeriesLine(next);
  }

  // Draws the result screen again, with `change`.
  function showResultScreen(change: Partial<Result> = {}) {
    if (!result) return;
    const shown = (result = { ...result, ...change });
    render(
      h(ShelfCheckResult, {
        // A new book: a new screen, its motion from the start.
        key: shown.book.isbn,
        book: { ...shown.book, title: shown.title },
        check: shown.check,
        cover: shown.cover,
        addedAt: addedOn({ isbn: shown.book.isbn, work: { id: shown.book.work, title: '' } }, library),
        seriesLoading: shown.seriesLoading,
        following: shown.following,
        saving: shown.saving,
        canScan: !scanButton.hidden,
        onClose: () => resultDialog.close(),
        onScan: () => {
          resultDialog.close();
          void scan();
        },
        onAdd: (read: boolean) => void addFromResult(shown, read),
        onFollow: () => void follow(shown),
      }),
      resultRoot,
    );
  }

  // Over Check a book, as a modal (Escape closes it). Browser Back closes it
  // too: it has its own history entry.
  let resultEntry = false;
  function openResult() {
    if (!resultDialog.open) resultDialog.showModal();
    toastsInto(resultDialog);
    if (!resultEntry) {
      history.pushState({ shelfCheck: true }, '');
      resultEntry = true;
    }
    // Screen readers say the answer first.
    resultDialog.querySelector<HTMLElement>('[data-result-answer]')?.focus();
  }

  resultDialog.addEventListener('cancel', (event) => {
    if (result?.saving) event.preventDefault();
  });
  resultDialog.addEventListener('close', () => {
    result = undefined;
    render(null, resultRoot);
    toastsBack();
    if (resultEntry) {
      resultEntry = false;
      history.back();
    }
  });
  addEventListener('popstate', () => {
    if (!resultEntry) return;
    resultEntry = false;
    resultDialog.close();
  });
  // Back from Series Onboarding can show the page again from the browser cache, mid-save.
  addEventListener('pageshow', (event) => {
    if (event.persisted && result?.saving) resultDialog.close();
  });

  // A modal dialog makes the page under it inert and hides it: while the
  // result screen or the camera is open, the toasts show in it.
  const toasts = document.querySelector<HTMLElement>('[data-toasts]');
  const toastsHome = toasts?.parentElement;
  const toastsNext = toasts?.nextSibling ?? null;
  function toastsInto(dialog: HTMLDialogElement) {
    if (toasts) dialog.append(toasts);
  }
  function toastsBack() {
    if (!toasts || !toastsHome) return;
    const open = [resultDialog, camera].find((each) => each.open);
    if (open) open.append(toasts);
    else toastsHome.insertBefore(toasts, toastsNext);
  }

  // A book the Catalog does not know: the form where the reader types it,
  // under the Shelf Check answer for its ISBN.
  async function showUnknown(isbn: string) {
    details.querySelector('[data-details-isbn]')!.textContent = t('add.unknown-isbn', isbn);
    fillDetails({ title: '' });
    // A new search for each ISBN: nothing stays from the one before.
    render(null, find);
    render(h(FindInBnf, { isbn, typed, onChosen: (edition) => void show(edition, 'typed'), onTyped: fillDetails }), find);
    const next: Book = { isbn, work: editionWork(isbn) };
    book = next;
    statusSelect.value = 'unread';
    statusChosen = false;
    // Its place is kept while the Library loads: the form below does not jump.
    render(h('div', { class: 'skeleton answer-skeleton', 'aria-hidden': 'true' }), answer);
    answer.hidden = false;
    showAction(false);
    addForm.hidden = false;
    detail('title').focus();

    const read = await readLibrary();
    library = read ?? noLibrary();
    if (book !== next) return;
    // No Library to read: the status starts at "Not yet", and no answer.
    if (!read) {
      answer.hidden = true;
      return;
    }
    const check = shelfCheck(isbn, undefined, library, undefined);
    answer.dataset.kind = check.kind;
    render(h(ShelfCheckAnswer, { check, work: next.work }), answer);
    showAction(check.kind === 'owned');
    // Abandoned is not an answer here: no choice keeps it (no option selected).
    if (!statusChosen) statusSelect.value = currentStatus(next.work, library);
    // Another Copy of a book typed before: start from what the reader typed then.
    const before = library.copies.find(({ value }) => value.isbn === isbn && value.details)?.value.details;
    if (before && !detail('title').value) fillDetails(before);
  }

  function fillDetails(typed: BookDetails) {
    detail('title').value = typed.title;
    detail('authors').value = typed.authors?.join(', ') ?? '';
    detail('series').value = typed.series ?? '';
    detail('volume').value = typed.volume ?? '';
    detailsProblem.textContent = '';
  }

  // The Library, read again (and what the connection status says of it);
  // undefined signed out, or with no copy on this device and no network.
  async function readLibrary(): Promise<Library | undefined> {
    const space = await openSpaceOrSay();
    if (!space) return undefined;
    try {
      const loaded = await loadLibrary(space);
      reportNetwork(!loaded.stale);
      reportWaiting(await waitingCount(space));
      return loaded.library;
    } catch {
      return undefined;
    }
  }

  // The Edition Line of `anchor` (`/volumes`); the one kept on this device
  // when the Catalog cannot say now.
  async function editionLine(anchor: string): Promise<Edition[] | undefined> {
    return (await lookupVolumes(anchor).catch(() => undefined))?.volumes ?? (await device.line(anchor));
  }

  // A Series not followed: its Series card comes after the answer, which
  // does not need its Edition Line. Asking it online also leaves it in the
  // service worker cache of a built app: the same check offline shows it too.
  // Its place is kept from the first answer (seriesLoading).
  async function addSeriesLine(shown: Book) {
    const line = await editionLine(readerLine(shown.edition, library)!);
    if (result?.book === shown) showResultScreen({ check: shelfCheck(shown.isbn, shown.edition, library, line), seriesLoading: false });
  }

  function seriesLineComes(shown: Book): boolean {
    return readerLine(shown.edition, library) !== undefined && followedLine(shown.edition, library) === undefined;
  }

  // Follow from the Series card: the Series in the Edition Line of this book,
  // then the check again (the book can now be a Missing Volume).
  async function follow({ book: shown, check, offline }: Result) {
    const change = shown.edition && followSeries(shown.edition, undefined, new Date());
    const space = await openSpaceOrSay();
    if (!change || !space) return;
    const still = () => result?.book === shown;
    showResultScreen({ following: true });
    try {
      const state = await saveFollow(space, change);
      if (state !== 'refused') reportNetwork(state === 'sent');
      reportWaiting(await waitingCount(space));
      if (state !== 'sent') toast(await savedText(space, state), { error: state === 'refused' });
      if (state === 'waiting') sendLater(space);
      const loaded = (await loadLibrary(space)).library;
      if (!still()) return;
      library = loaded;
      const again = offline
        ? (await deviceShelfCheck(shown.isbn, library, device)).check
        : shelfCheck(shown.isbn, shown.edition, library, await editionLine(change.anchorIsbn));
      if (still()) showResultScreen({ check: again, following: false });
    } catch (error) {
      toast(spaceErrorMessage(error), { error: true });
      if (still()) showResultScreen({ check, following: false });
    }
  }

  // Sends the waiting saves once the PDS can be reached; `sent` says so.
  function sendLater(space: Space, sent: () => void = () => toast(t('saved.sent'))) {
    if (sending) return;
    sending = true;
    sendWhenOnline(
      space,
      () => {
        sending = false;
        reportNetwork(true);
        reportWaiting(0);
        sent();
      },
      (error) => toast(spaceErrorMessage(error), { error: true }),
    );
  }

  // Add to Library is the main action; for a book the reader owns, Add another Copy is secondary.
  function showAction(owned: boolean) {
    addButton.classList.toggle('button-accent', !owned);
    addButton.querySelector('[data-add-label]')!.textContent = t(owned ? 'book.add-copy' : 'add.submit');
  }

  async function openSpaceOrSay(): Promise<Space | undefined> {
    try {
      // Undefined with no session: the gate (AppShell) is sending the visitor to the sign-in screen.
      return (await own)?.space;
    } catch (error) {
      toast(spaceErrorMessage(error), { error: true });
    }
    return undefined;
  }

  // Saves a Copy of `current`, and the Reading Status `chosen` (with the
  // follow it brings, followOnRead). 'leave' when Series Onboarding opens;
  // 'saved' once a toast says it; undefined when nothing was saved.
  async function saveCopyOf(current: Book, chosen: Status | undefined, typedBook?: BookDetails): Promise<'leave' | 'saved' | undefined> {
    const title = current.edition?.title ?? typedBook?.title ?? t('book.isbn', current.isbn);
    const space = await openSpaceOrSay();
    if (!space) return;
    try {
      const now = new Date();
      const { isbn, work } = current;
      const copy = { isbn, works: [work], ...(typedBook && { details: typedBook }), createdAt: now.toISOString() };
      const states: WriteState[] = [];
      states.push((await saveCopy(space, copy)).state);
      const change = chosen && statusChange(work, isbn, chosen, library, now);
      if (change) states.push(await saveReadingStatus(space, change));
      const follow = chosen && followOnRead(current.edition, chosen, library, now);
      if (follow) states.push(await saveFollow(space, follow));
      const state = worstState(states);
      if (state !== 'refused') reportNetwork(state === 'sent');
      reportWaiting(await waitingCount(space));

      // A Series with no follow: ask which other Volumes the reader has. Series
      // Onboarding asks the Catalog for them. Only after a sent save: offline
      // or refused, the Copy is enough. A followed Series with no Volume in
      // the Library yet (Follow tapped before Add) still asks.
      const anchor = followedLine(current.edition, library);
      const line = state === 'sent' && anchor ? await editionLine(anchor) : undefined;
      const why = state === 'sent' && current.edition ? noOnboarding(current.edition, library, line) : 'no-series';
      if (why === undefined) {
        location.assign(`/onboarding?isbn=${isbn}`);
        return 'leave';
      }
      const seriesTitle = current.edition?.series?.title ?? '';
      const note = why === 'no-series' ? '' : t(`add.no-onboarding.${why}`, seriesTitle);

      const link = { href: bookHref(work), label: t('link.book-page') };
      const close = toast([t('add.added', title), await savedText(space, state), note].filter(Boolean).join(' '), {
        link,
        error: state === 'refused',
      });
      if (state === 'waiting') {
        sendLater(space, () => {
          close();
          toast(`${t('add.added', title)} ${t('saved.sent')}`, { link });
        });
      }
      return 'saved';
    } catch (error) {
      toast(spaceErrorMessage(error), { error: true });
    }
  }

  // The typed form, with the screen locked (lockWhileSaving): 'leave' when
  // Series Onboarding opens, else the element to focus once the screen is back.
  async function add(): Promise<'leave' | HTMLElement | undefined> {
    const current = book;
    if (!current) return;
    const fields = typed();
    if ('problem' in fields) {
      detailsProblem.textContent = fields.problem;
      return;
    }
    const chosen = statuses.find((status) => status === statusSelect.value);
    const done = await saveCopyOf(current, chosen, fields.details);
    if (done !== 'saved') return done;
    addForm.hidden = true;
    book = undefined;
    isbnInput.value = '';
    return isbnInput;
  }

  // Add to Library, Add and mark as read (`read`), Add another Copy. Once
  // saved, with no Series Onboarding, the screen closes and the reader goes
  // back to where the lookup came from: the camera, or the ISBN field.
  async function addFromResult(shown: Result, read: boolean) {
    if (result?.book !== shown.book || result.saving) return;
    showResultScreen({ saving: read ? 'read' : 'add' });
    const done = await saveCopyOf(shown.book, read ? 'read' : undefined);
    if (done === 'leave') return;
    if (done !== 'saved') {
      if (result?.book === shown.book) showResultScreen({ saving: undefined });
      return;
    }
    book = undefined;
    isbnInput.value = '';
    resultDialog.close();
    if (shown.from === 'scan' && !scanButton.hidden) void scan();
    else isbnInput.focus();
  }

  // Aborted when the camera view closes, for any reason (Close, Escape, a book found).
  let scanning = new AbortController();
  let later: ReturnType<typeof setTimeout> | undefined;

  type ScanState = 'starting' | 'looking' | 'wrong' | 'found';
  const lookingText = t('scan.looking');
  // A detector returns only barcodes it could decode, so "nothing yet" is all
  // the reader knows. After a while, say what usually helps.
  const stuckText = t('scan.stuck');

  // What the camera view shows: the frame (styled by data-state) and one line.
  // `then` runs after `delay` unless the view shows something else first.
  function showScan(state: ScanState, text: string, then?: () => void, delay = 0) {
    clearTimeout(later);
    camera.dataset.state = state;
    if (cameraText.textContent !== text) cameraText.textContent = text; // no repeat for screen readers
    if (then) later = setTimeout(then, delay);
  }

  const looking = () => showScan('looking', lookingText, () => showScan('looking', stuckText), 8000);

  // The camera view over the whole screen; the first good ISBN fills the field
  // and looks the book up. Any failure goes back to typing, with the reason.
  async function scan() {
    problem();
    showScan('starting', t('add.camera-starting'));
    scanning = new AbortController();
    const { signal } = scanning;
    camera.showModal();
    toastsInto(camera);
    let stream: MediaStream;
    try {
      stream = await openCamera();
    } catch (error) {
      camera.close();
      return typeInstead(t(`camera.${cameraProblem(error)}`));
    }
    const stop = () => stream.getTracks().forEach((track) => track.stop());
    if (signal.aborted) return stop(); // closed while the permission prompt was open
    signal.addEventListener('abort', stop);
    video.srcObject = stream;
    try {
      await video.play();
      await loadReader();
      if (signal.aborted) return;
      looking();
      await watchBarcodes(video, found, signal);
    } catch {
      if (signal.aborted) return;
      camera.close();
      typeInstead(t('scan.no-barcodes'));
    }
  }

  function found(text: string): boolean {
    const read = readIsbn(text);
    if ('isbn' in read) {
      // Show the read before the view goes away: the reader sees it worked.
      showScan('found', t('book.isbn', read.isbn));
      navigator.vibrate?.(40);
      const { signal } = scanning;
      setTimeout(() => {
        if (signal.aborted) return; // closed by hand in the meantime
        camera.close();
        isbnInput.value = read.isbn;
        void lookUp('scan');
      }, 600);
      return true;
    }
    // A wrong check digit is a misread: keep reading without a word. While the
    // wrong barcode stays in view the state stays (no new shake); 2.5 s after
    // it leaves, back to looking.
    if (read.problem !== 'check-digit') showScan('wrong', t(`isbn.${read.problem}`), looking, 2500);
    return false;
  }

  function typeInstead(reason?: string) {
    if (reason) problem(reason, false);
    isbnInput.focus();
  }

  // `mediaDevices` exists only in a secure context (HTTPS or loopback).
  if ('mediaDevices' in navigator) scanButton.hidden = false;
  scanButton.addEventListener('click', () => void scan());
  for (const button of camera.querySelectorAll('[data-camera-close]')) {
    button.addEventListener('click', () => {
      camera.close();
      typeInstead();
    });
  }
  camera.addEventListener('close', () => {
    clearTimeout(later);
    scanning.abort();
    video.srcObject = null;
    toastsBack();
  });

  // From the Check tab or "Check a book" (CORE-97): in a shop, the scanner is
  // what the reader wants, so the camera opens with no other tap. `scan=1`
  // leaves the address at once: a reload or a Back does not open it again.
  // No tap is needed to ask for the camera, in Safari as in Chrome
  // (getUserMedia needs no user gesture, unlike sound); still to check in the
  // installed app on an iPhone.
  const address = new URL(location.href);
  if (address.searchParams.get('scan') === '1') {
    address.searchParams.delete('scan');
    history.replaceState(history.state, '', address);
    whenScreenShows(() => (scanButton.hidden ? typeInstead(t('camera.failed')) : void scan()));
  }

  // The gate (src/lib/auth/gate-boot.ts) may still hide the screen: a modal
  // camera view would show over it, maybe before the sign-in screen.
  function whenScreenShows(then: () => void) {
    const root = document.documentElement;
    if (!root.dataset.gate) return then();
    const gate = new MutationObserver(() => {
      if (root.dataset.gate) return;
      gate.disconnect();
      then();
    });
    gate.observe(root, { attributes: true, attributeFilter: ['data-gate'] });
  }

  isbnForm.addEventListener('submit', (event) => {
    event.preventDefault();
    void lookUp('typed');
  });
  isbnInput.addEventListener('input', () => {
    if (hint.hasAttribute('data-error')) problem();
  });
  details.addEventListener('input', () => {
    detailsProblem.textContent = '';
  });
  lockWhileSaving(addForm, document.querySelector<HTMLElement>('.quick-add')!, add);

  // Online, keeps on this device the Catalog data Shelf Check needs offline
  // (keptOnDevice), and asks the Edition Lines again: they grow. Every screen
  // that reads the Library keeps what is not kept yet (loadLibrary). Only
  // ISBNs go to the Atomes server, never the Library.
  async function keepForOffline() {
    if (!navigator.onLine) return;
    const space = await openSpaceOrSay();
    if (!space) return;
    try {
      // This keep, not the one every Library read starts.
      const loaded = await loadLibrary(space, () => undefined);
      if (loaded.stale) return;
      const { isbns, anchors } = keptOnDevice(loaded.library);
      kept.hidden = !(await device.keep(isbns, anchors, { refreshLines: true }));
    } catch {
      // Offline after all: the device keeps what it had.
    }
  }
  void keepForOffline();

  // From the Book page ("Add another Copy") or an old Quick Add link (/add): the ISBN is already known.
  const given = new URLSearchParams(location.search).get('isbn');
  if (given) {
    isbnInput.value = given;
    void lookUp('typed');
  }
</script>

