---
// Check a book: scan the barcode or type the ISBN, see the Shelf Check answer
// (owned, read, missing from a Followed Series, or not in the Library), then
// Quick Add: say if it is read, add it. The barcode is read on the device
// (ADR 0003). Offline (CORE-37), the answer comes from this device only: the
// Library copy and the Catalog data kept for it (src/lib/catalog/device.ts);
// no ISBN is sent, and a Copy added waits in the write queue. The Atomes
// server only gets the ISBN to look up, never the answer (ADR 0001).
import Icon from '../components/Icon.astro';
import AppShell from '../layouts/AppShell.astro';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));

const answers = [
  { value: 'unread', label: t('status.unread') },
  { value: 'reading', label: t('status.reading') },
  { value: 'read', label: t('status.read') },
];
---

<AppShell title={t('check.title')} current="check">
  <div class="quick-add">
    <!-- Shown only where the browser can open a camera (HTTPS or loopback). -->
    <button class="button button-primary scan" type="button" data-scan hidden>
      <Icon name="scan-barcode" />
      <span>{t('add.scan')}</span>
    </button>

    <!-- data-state: starting | looking | wrong | found (set by the script, styled below). -->
    <dialog class="camera" data-camera data-state="starting" aria-label={t('add.scan')}>
      <video class="camera-video" data-video muted playsinline></video>
      <div class="viewfinder" aria-hidden="true">
        <span class="scan-line"></span>
        <span class="found-mark"><Icon name="check" size={32} /></span>
      </div>
      <button class="camera-close" type="button" aria-label={t('common.close')} data-camera-close>
        <Icon name="x" size={22} />
      </button>
      <div class="camera-bottom">
        <p class="camera-text" data-camera-text aria-live="polite">{t('add.camera-starting')}</p>
        <button class="camera-type" type="button" data-camera-close>
          <Icon name="keyboard" />
          <span>{t('add.type-isbn')}</span>
        </button>
      </div>
    </dialog>

    <form class="isbn-form" data-isbn-form>
      <label class="label" for="isbn">{t('add.isbn')}</label>
      <div class="isbn-row">
        <input
          class="field"
          id="isbn"
          name="isbn"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          placeholder="978 2 7234 7899 1"
          aria-describedby="isbn-hint"
        />
        <button class="button" type="submit">{t('add.look-up')}</button>
      </div>
      <!-- The hint line also says what is wrong with the ISBN: the page does not move. -->
      <p class="hint" id="isbn-hint" data-hint aria-live="polite">{t('add.isbn-hint')}</p>
      <!-- Shown once the Catalog data for Shelf Check offline is on this device. -->
      <p class="hint" data-kept hidden>{t('check.kept')}</p>
    </form>

    <div class="book" data-skeleton hidden aria-hidden="true">
      <div class="cover book-cover skeleton"></div>
      <div class="book-text skeleton-text">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-line"></div>
        <div class="skeleton skeleton-line short"></div>
      </div>
    </div>

    <form class="preview" data-add-form hidden>
      <div class="book" data-preview>
        <div class="cover book-cover" data-cover></div>
        <div class="book-text">
          <h2 class="book-title" data-title>{t('add.book')}</h2>
          <p class="book-line" data-authors></p>
          <p class="book-line" data-series></p>
          <p class="book-meta" data-edition></p>
        </div>
      </div>

      <!-- A book the Catalog does not know: the reader types it. Disabled (so not
           required) while a Catalog book is shown. maxlength keeps each field
           inside the Copy lexicon (bookDetails). -->
      <fieldset class="details" data-details hidden disabled>
        <legend class="details-title">{t('add.type-book')}</legend>
        <p class="hint" data-details-isbn></p>
        <label class="details-field">
          <span class="label">{t('add.field-title')}</span>
          <input class="field" name="title" type="text" maxlength="300" autocomplete="off" required />
        </label>
        <label class="details-field">
          <span class="label">{t('add.field-authors')}</span>
          <input class="field" name="authors" type="text" maxlength="1300" autocomplete="off" aria-describedby="authors-hint" />
          <span class="hint" id="authors-hint">{t('add.authors-hint')}</span>
        </label>
        <div class="details-row">
          <label class="details-field">
            <span class="label">{t('add.field-series')}</span>
            <input class="field" name="series" type="text" maxlength="300" autocomplete="off" />
          </label>
          <label class="details-field volume">
            <span class="label">{t('add.field-volume')}</span>
            <input class="field" name="volume" type="text" maxlength="16" autocomplete="off" />
          </label>
        </div>
        <p class="hint" data-details-problem data-error aria-live="polite"></p>
        <!-- Find the Series or Work in BnF by the typed title (src/islands/FindInBnf.tsx). -->
        <div data-find></div>
      </fieldset>

      <!-- The Shelf Check answer (src/islands/ShelfCheckAnswer.tsx), once the Library is read. -->
      <div class="answer" data-answer hidden></div>

      <!-- Hidden offline for a book this device has no Catalog data for: check online later. -->
      <div class="add-actions" data-add-actions>
        <fieldset class="question">
          <legend class="label">{t('add.read-question')}</legend>
          <div class="segmented">
            {
              answers.map((answer) => (
                <label class="segment">
                  <input type="radio" name="status" value={answer.value} checked={answer.value === 'unread'} />
                  <span>{answer.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="private">
          <Icon name="lock" size={18} />
          <div>
            <p class="private-title">{t('add.private')}</p>
            <p class="hint">{t('add.private-hint')}</p>
          </div>
        </div>

        <!-- Main action when the reader does not own the book; Add another Copy when they do. -->
        <button class="button button-primary add" type="submit">
          <Icon name="book-plus" />
          <span data-add-label>{t('add.submit')}</span>
        </button>
      </div>
    </form>
  </div>
</AppShell>

<script>
  import { h, render } from 'preact';
  import { FindInBnf } from '../islands/FindInBnf';
  import { ShelfCheckAnswer } from '../islands/ShelfCheckAnswer';
  import { openOwnSpace } from '../lib/auth/server-client';
  import type { Edition } from '../lib/catalog/catalog';
  import { coverUrl, lookupEdition, lookupVolumes } from '../lib/catalog/client';
  import { deviceCatalog } from '../lib/catalog/device';
  import { showCover } from '../lib/cover';
  import { saveCopy, typedDetails, type BookDetails, type TypedFields } from '../lib/library/copy';
  import { editionWork, readIsbn } from '../lib/library/ids';
  import { cameraProblem, loadReader, openCamera, watchBarcodes } from '../lib/scan/barcode';
  import { reportNetwork, reportWaiting } from '../lib/connection';
  import { t } from '../lib/i18n/i18n';
  import { saveFollow } from '../lib/library/follow';
  import { loadLibrary, savedText, sendWhenOnline, waitingCount, worstState } from '../lib/library/library';
  import { bookHref, currentStatus, editionLabel, statusChange, type Library } from '../lib/library/model';
  import { followOnRead, noOnboarding } from '../lib/library/onboarding';
  import { saveReadingStatus, statuses } from '../lib/library/reading-status';
  import { catalogAnswer, deviceShelfCheck, followedLine, keptOnDevice, shelfCheck, type ShelfCheck } from '../lib/library/shelf-check';
  import { latestOnly } from '../lib/latest';
  import { lockWhileSaving } from '../lib/save-lock';
  import { spaceErrorMessage, type Space, type WriteState } from '../lib/space/space';
  import { toast } from '../lib/toast';

  const isbnForm = document.querySelector<HTMLFormElement>('[data-isbn-form]')!;
  const isbnInput = isbnForm.querySelector<HTMLInputElement>('input[name="isbn"]')!;
  const lookUpButton = isbnForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const hint = isbnForm.querySelector<HTMLElement>('[data-hint]')!;
  const defaultHint = hint.textContent.trim();
  const skeleton = document.querySelector<HTMLElement>('[data-skeleton]')!;
  const addForm = document.querySelector<HTMLFormElement>('[data-add-form]')!;
  const addButton = addForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const answer = addForm.querySelector<HTMLElement>('[data-answer]')!;
  const addActions = addForm.querySelector<HTMLElement>('[data-add-actions]')!;
  const kept = isbnForm.querySelector<HTMLElement>('[data-kept]')!;
  const radios = addForm.querySelectorAll<HTMLInputElement>('input[name="status"]');
  const preview = addForm.querySelector<HTMLElement>('[data-preview]')!;
  const details = addForm.querySelector<HTMLFieldSetElement>('[data-details]')!;
  const detailsProblem = details.querySelector<HTMLElement>('[data-details-problem]')!;
  const detail = (name: keyof TypedFields) => details.querySelector<HTMLInputElement>(`input[name="${name}"]`)!;
  const typed = () =>
    typedDetails({ title: detail('title').value, authors: detail('authors').value, series: detail('series').value, volume: detail('volume').value });
  const find = details.querySelector<HTMLElement>('[data-find]')!;

  // The Space opens once; undefined when signed out.
  const own = openOwnSpace();
  // The Catalog data this device keeps for Shelf Check offline.
  const device = deviceCatalog({});
  // Lookups can answer out of order (offline ones too): only the latest shows.
  const startLookUp = latestOnly();
  // The book on the form: a Catalog Edition, or an ISBN the Catalog does not
  // know, which the reader types (its Work is then `isbn:<isbn>`, ADR 0010).
  interface Book {
    isbn: string;
    work: string;
    edition?: Edition;
  }
  let book: Book | undefined;
  // An answer made offline from this device, and the Library it read.
  interface OnDevice {
    check: ShelfCheck;
    library: Library;
  }
  let library: Library = { copies: [], readingStatuses: [], follows: [], loans: [], toBuy: [] };
  let sending = false;

  // A problem, in the hint line; no argument puts the hint back. Only a wrong
  // ISBN marks the field invalid, not a camera that did not open.
  function problem(text?: string, fieldIsWrong = Boolean(text)) {
    hint.textContent = text ?? defaultHint;
    hint.toggleAttribute('data-error', Boolean(text));
    isbnInput.toggleAttribute('aria-invalid', fieldIsWrong);
  }

  function busy(button: HTMLButtonElement, on: boolean) {
    button.disabled = on;
    if (on) button.setAttribute('aria-busy', 'true');
    else button.removeAttribute('aria-busy');
  }

  async function lookUp() {
    const current = startLookUp();
    const read = readIsbn(isbnInput.value);
    addForm.hidden = true;
    book = undefined;
    if ('problem' in read) return problem(t(`isbn.${read.problem}`));
    const { isbn } = read;
    problem();
    busy(lookUpButton, true);
    skeleton.hidden = false;
    let asked: Awaited<ReturnType<typeof catalogAnswer>>;
    try {
      // Offline, the Catalog is not asked: the ISBN stays on this device.
      asked = await catalogAnswer(isbn, navigator.onLine, lookupEdition);
    } catch {
      return problem(t('add.lookup-failed'));
    } finally {
      busy(lookUpButton, false);
      skeleton.hidden = true;
    }
    // Another ISBN was looked up meanwhile: its answer is the one to show.
    if (!current()) return;
    if ('offline' in asked) {
      reportNetwork(false);
      return lookUpOnDevice(isbn, current);
    }
    if ('unavailable' in asked) return problem(t('add.sources-down'));
    reportNetwork(true);
    // notFound: no book source knows this ISBN, so the reader types the book.
    await ('found' in asked ? show(asked.found) : showUnknown(isbn));
  }

  // The Shelf Check with no network, from this device only (shelf-check.ts).
  async function lookUpOnDevice(isbn: string, current: () => boolean) {
    const space = await openSpaceOrSay();
    if (!space) return;
    let onDevice: Library;
    try {
      onDevice = (await loadLibrary(space)).library;
    } catch {
      // No copy of the Library on this device: nothing to answer from.
      if (current()) problem(t('check.no-library'));
      return;
    }
    const { check, edition } = await deviceShelfCheck(isbn, onDevice, device);
    if (!current()) return;
    const given = { check, library: onDevice };
    if (edition) return show(edition, given, current);
    // No Catalog data for this ISBN here: the answer only, with what the reader typed on a Copy, if any.
    const title = onDevice.copies.find(({ value }) => value.isbn === isbn && value.details)?.value.details?.title ?? t('book.isbn', isbn);
    showCover(addForm.querySelector<HTMLElement>('[data-cover]')!, { src: null, title, series: null, volumeTitle: null, volume: '' });
    fillPreview(title, '', '', '');
    await ready({ isbn, work: editionWork(isbn) }, given);
  }

  function fillPreview(title: string, authors: string, series: string, edition: string) {
    addForm.querySelector('[data-title]')!.textContent = title;
    addForm.querySelector('[data-authors]')!.textContent = authors;
    addForm.querySelector('[data-series]')!.textContent = series;
    addForm.querySelector('[data-edition]')!.textContent = edition;
  }

  async function show(found: Edition, onDevice?: OnDevice, current = () => true) {
    // Offline, only a cover this device has: asking for another would send the ISBN.
    const cover = !onDevice || (await device.hasCover(found.isbn));
    if (!current()) return;
    showCover(addForm.querySelector<HTMLElement>('[data-cover]')!, {
      src: cover ? coverUrl(found) : null,
      title: found.title,
      series: found.series?.title ?? null,
      volumeTitle: found.volumeTitle,
      volume: found.volumes.length > 0 ? t('book.volumes', found.volumes) : '',
    });
    fillPreview(
      found.title,
      found.authors.join(', '),
      [
        found.series && found.series.title !== found.title ? found.series.title : '',
        found.volumes.length > 0 ? t('book.volumes', found.volumes) : '',
        found.volumeTitle ?? '',
      ]
        .filter(Boolean)
        .join(' · '),
      [editionLabel(found), t('book.isbn', found.isbn)].filter(Boolean).join(' · '),
    );
    await ready({ isbn: found.isbn, work: found.work.id, edition: found }, onDevice);
  }

  async function showUnknown(isbn: string) {
    details.querySelector('[data-details-isbn]')!.textContent = t('add.unknown-isbn', isbn);
    fillDetails({ title: '' });
    // A new search for each ISBN: nothing stays from the one before.
    render(null, find);
    render(h(FindInBnf, { isbn, typed, onChosen: (edition) => void show(edition), onTyped: fillDetails }), find);
    await ready({ isbn, work: editionWork(isbn) });
  }

  function fillDetails(typed: BookDetails) {
    detail('title').value = typed.title;
    detail('authors').value = typed.authors?.join(', ') ?? '';
    detail('series').value = typed.series ?? '';
    detail('volume').value = typed.volume ?? '';
    detailsProblem.textContent = '';
  }

  // Shows the form for this book, then starts from what the Library already
  // has. `onDevice`: the answer offline, already made from this device.
  async function ready(next: Book, onDevice?: OnDevice) {
    book = next;
    // Offline with no Catalog data: the answer only, nothing to type or add.
    const answerOnly = !next.edition && onDevice !== undefined;
    const typing = !next.edition && !answerOnly;
    if (!typing) render(null, find);
    preview.hidden = typing;
    details.hidden = !typing;
    details.disabled = !typing;
    addActions.hidden = answerOnly;
    for (const radio of radios) radio.checked = radio.value === 'unread';
    answer.hidden = true;
    showAction(false);
    addForm.hidden = false;
    if (!answerOnly) (typing ? detail('title') : addButton).focus();

    let check: ShelfCheck;
    if (onDevice) {
      library = onDevice.library;
      check = onDevice.check;
    } else {
      // Already in the Library: start from its Reading Status, and say so.
      const space = await openSpaceOrSay();
      if (!space) return;
      let line: Edition[] | undefined;
      try {
        const loaded = await loadLibrary(space);
        library = loaded.library;
        reportNetwork(!loaded.stale);
        reportWaiting(await waitingCount(space));
        // A Followed Series: its Edition Line tells whether this Volume is
        // missing; the one kept on this device when the Catalog cannot say now.
        const anchor = followedLine(next.edition, library);
        line = anchor ? ((await lookupVolumes(anchor).catch(() => undefined))?.volumes ?? (await device.line(anchor))) : undefined;
      } catch {
        // No copy on this device and no network: the status starts at "Not yet", and no answer.
        library = { copies: [], readingStatuses: [], follows: [], loans: [], toBuy: [] };
        return;
      }
      if (book !== next) return;
      check = shelfCheck(next.isbn, next.edition, library, line);
    }
    showAnswer(check, next);
    // Abandoned is not an answer here: no choice keeps it.
    const status = currentStatus(next.work, library);
    for (const radio of radios) radio.checked = radio.value === status;
    // Another Copy of a book typed before: start from what the reader typed then.
    const before = library.copies.find(({ value }) => value.isbn === next.isbn && value.details)?.value.details;
    if (typing && before && !detail('title').value) fillDetails(before);
  }

  // The Shelf Check answer, and the action that fits it.
  function showAnswer(check: ShelfCheck, shown: Book) {
    answer.dataset.kind = check.kind;
    render(h(ShelfCheckAnswer, { check, work: shown.work, volumes: shown.edition?.volumes ?? [] }), answer);
    answer.hidden = false;
    showAction(check.kind === 'owned');
  }

  // Add to Library is the main action; for a book the reader owns, Add another Copy is secondary.
  function showAction(owned: boolean) {
    addButton.classList.toggle('button-primary', !owned);
    addButton.querySelector('[data-add-label]')!.textContent = t(owned ? 'book.add-copy' : 'add.submit');
  }

  async function openSpaceOrSay(): Promise<Space | undefined> {
    try {
      // Undefined with no session: the gate (AppShell) is sending the visitor to the sign-in screen.
      return (await own)?.space;
    } catch (error) {
      toast(spaceErrorMessage(error), { error: true });
    }
    return undefined;
  }

  // Runs with the screen locked (lockWhileSaving): 'leave' when Series
  // Onboarding opens, else the element to focus once the screen is back.
  async function add(): Promise<'leave' | HTMLElement | undefined> {
    const current = book;
    if (!current) return;
    const fields = current.edition ? undefined : typed();
    if (fields && 'problem' in fields) {
      detailsProblem.textContent = fields.problem;
      return;
    }
    const typedBook = fields?.details;
    const title = current.edition?.title ?? typedBook?.title ?? t('book.isbn', current.isbn);
    const checked = [...radios].find((radio) => radio.checked)?.value;
    const chosen = statuses.find((status) => status === checked);
    const space = await openSpaceOrSay();
    if (!space) return;
    try {
      const now = new Date();
      const { isbn, work } = current;
      const copy = { isbn, works: [work], ...(typedBook && { details: typedBook }), createdAt: now.toISOString() };
      const states: WriteState[] = [];
      states.push((await saveCopy(space, copy)).state);
      const change = chosen && statusChange(work, isbn, chosen, library, now);
      if (change) states.push(await saveReadingStatus(space, change));
      const follow = chosen && followOnRead(current.edition, chosen, library, now);
      if (follow) states.push(await saveFollow(space, follow));
      const state = worstState(states);
      if (state !== 'refused') reportNetwork(state === 'sent');
      reportWaiting(await waitingCount(space));

      // A Series with no follow: ask which other Volumes the reader has. Series
      // Onboarding asks the Catalog for them. Only after a sent save: offline
      // or refused, the Copy is enough.
      const why = state === 'sent' && current.edition ? noOnboarding(current.edition, library) : 'no-series';
      if (why === undefined) {
        location.assign(`/onboarding?isbn=${isbn}`);
        return 'leave';
      }
      const seriesTitle = current.edition?.series?.title ?? '';
      const note = why === 'no-series' ? '' : t(`add.no-onboarding.${why}`, seriesTitle);

      addForm.hidden = true;
      book = undefined;
      isbnInput.value = '';
      const link = { href: bookHref(work), label: t('link.book-page') };
      const close = toast([t('add.added', title), await savedText(space, state), note].filter(Boolean).join(' '), {
        link,
        error: state === 'refused',
      });
      if (state === 'waiting' && !sending) {
        sending = true;
        sendWhenOnline(
          space,
          () => {
            sending = false;
            reportNetwork(true);
            reportWaiting(0);
            close();
            toast(`${t('add.added', title)} ${t('saved.sent')}`, { link });
          },
          (error) => toast(spaceErrorMessage(error), { error: true }),
        );
      }
      return isbnInput;
    } catch (error) {
      toast(spaceErrorMessage(error), { error: true });
    }
  }

  const scanButton = document.querySelector<HTMLButtonElement>('[data-scan]')!;
  const camera = document.querySelector<HTMLDialogElement>('[data-camera]')!;
  const video = camera.querySelector<HTMLVideoElement>('[data-video]')!;
  const cameraText = camera.querySelector<HTMLElement>('[data-camera-text]')!;
  // Aborted when the camera view closes, for any reason (Close, Escape, a book found).
  let scanning = new AbortController();
  let later: ReturnType<typeof setTimeout> | undefined;

  type ScanState = 'starting' | 'looking' | 'wrong' | 'found';
  const lookingText = t('scan.looking');
  // A detector returns only barcodes it could decode, so "nothing yet" is all
  // the reader knows. After a while, say what usually helps.
  const stuckText = t('scan.stuck');

  // What the camera view shows: the frame (styled by data-state) and one line.
  // `then` runs after `delay` unless the view shows something else first.
  function showScan(state: ScanState, text: string, then?: () => void, delay = 0) {
    clearTimeout(later);
    camera.dataset.state = state;
    if (cameraText.textContent !== text) cameraText.textContent = text; // no repeat for screen readers
    if (then) later = setTimeout(then, delay);
  }

  const looking = () => showScan('looking', lookingText, () => showScan('looking', stuckText), 8000);

  // The camera view over the whole screen; the first good ISBN fills the field
  // and looks the book up. Any failure goes back to typing, with the reason.
  async function scan() {
    problem();
    showScan('starting', t('add.camera-starting'));
    scanning = new AbortController();
    const { signal } = scanning;
    camera.showModal();
    let stream: MediaStream;
    try {
      stream = await openCamera();
    } catch (error) {
      camera.close();
      return typeInstead(t(`camera.${cameraProblem(error)}`));
    }
    const stop = () => stream.getTracks().forEach((track) => track.stop());
    if (signal.aborted) return stop(); // closed while the permission prompt was open
    signal.addEventListener('abort', stop);
    video.srcObject = stream;
    try {
      await video.play();
      await loadReader();
      if (signal.aborted) return;
      looking();
      await watchBarcodes(video, found, signal);
    } catch {
      if (signal.aborted) return;
      camera.close();
      typeInstead(t('scan.no-barcodes'));
    }
  }

  function found(text: string): boolean {
    const read = readIsbn(text);
    if ('isbn' in read) {
      // Show the read before the view goes away: the reader sees it worked.
      showScan('found', t('book.isbn', read.isbn));
      navigator.vibrate?.(40);
      const { signal } = scanning;
      setTimeout(() => {
        if (signal.aborted) return; // closed by hand in the meantime
        camera.close();
        isbnInput.value = read.isbn;
        void lookUp();
      }, 600);
      return true;
    }
    // A wrong check digit is a misread: keep reading without a word. While the
    // wrong barcode stays in view the state stays (no new shake); 2.5 s after
    // it leaves, back to looking.
    if (read.problem !== 'check-digit') showScan('wrong', t(`isbn.${read.problem}`), looking, 2500);
    return false;
  }

  function typeInstead(reason?: string) {
    if (reason) problem(reason, false);
    isbnInput.focus();
  }

  // `mediaDevices` exists only in a secure context (HTTPS or loopback).
  if ('mediaDevices' in navigator) scanButton.hidden = false;
  scanButton.addEventListener('click', () => void scan());
  for (const button of camera.querySelectorAll('[data-camera-close]')) {
    button.addEventListener('click', () => {
      camera.close();
      typeInstead();
    });
  }
  camera.addEventListener('close', () => {
    clearTimeout(later);
    scanning.abort();
    video.srcObject = null;
  });

  isbnForm.addEventListener('submit', (event) => {
    event.preventDefault();
    void lookUp();
  });
  isbnInput.addEventListener('input', () => {
    if (hint.hasAttribute('data-error')) problem();
  });
  details.addEventListener('input', () => {
    detailsProblem.textContent = '';
  });
  lockWhileSaving(addForm, document.querySelector<HTMLElement>('.quick-add')!, add);

  // Online, keeps on this device the Catalog data Shelf Check needs offline
  // (keptOnDevice), and asks the Edition Lines again: they grow. Every screen
  // that reads the Library keeps what is not kept yet (loadLibrary). Only
  // ISBNs go to the Atomes server, never the Library.
  async function keepForOffline() {
    if (!navigator.onLine) return;
    const space = await openSpaceOrSay();
    if (!space) return;
    try {
      // This keep, not the one every Library read starts.
      const loaded = await loadLibrary(space, () => undefined);
      if (loaded.stale) return;
      const { isbns, anchors } = keptOnDevice(loaded.library);
      kept.hidden = !(await device.keep(isbns, anchors, { refreshLines: true }));
    } catch {
      // Offline after all: the device keeps what it had.
    }
  }
  void keepForOffline();

  // From the Book page ("Add another Copy") or an old Quick Add link (/add): the ISBN is already known.
  const given = new URLSearchParams(location.search).get('isbn');
  if (given) {
    isbnInput.value = given;
    void lookUp();
  }
</script>

