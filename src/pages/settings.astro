---
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icons';
import AppShell from '../layouts/AppShell.astro';
import type { Appearance } from '../lib/appearance';
import { languageCookie, parseLanguage, requestLanguage, translator, type Language } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));

const options: { value: Appearance; label: string; icon: IconName }[] = [
  { value: 'system', label: t('appearance.system'), icon: 'monitor' },
  { value: 'light', label: t('appearance.light'), icon: 'sun' },
  { value: 'dark', label: t('appearance.dark'), icon: 'moon' },
];

// '' follows the browser's language. Each language is named in itself.
const languageOptions: { value: Language | ''; label: string }[] = [
  { value: '', label: t('language.browser') },
  { value: 'fr', label: t('language.fr') },
  { value: 'en', label: t('language.en') },
];
const chosenLanguage = parseLanguage(Astro.cookies.get(languageCookie)?.value) ?? '';
---

<AppShell title={t('settings.title')} current="settings">
  <div class="settings">
    <section class="group" data-auth>
      <h2 class="group-title">{t('settings.account')}</h2>
      <div class="row">
        <div>
          <p class="row-label">{t('settings.atproto-account')}</p>
          <p class="row-hint" data-auth-status aria-live="polite">{t('settings.checking')}</p>
        </div>
        <button class="button" type="button" data-sign-out hidden>{t('settings.sign-out')}</button>
      </div>
      <p class="row-error" data-auth-error role="alert" hidden></p>
    </section>

    <section class="group">
      <h2 class="group-title">{t('settings.display')}</h2>
      <div class="row">
        <div>
          <p class="row-label" id="appearance-label">{t('settings.appearance')}</p>
          <p class="row-hint" id="appearance-hint">{t('settings.on-this-device')}</p>
        </div>
        <div
          class="segmented"
          role="radiogroup"
          aria-labelledby="appearance-label"
          aria-describedby="appearance-hint"
          data-appearance-picker
        >
          {
            options.map((option) => (
              <label class="segment">
                <input type="radio" name="appearance" value={option.value} checked={option.value === 'system'} />
                <Icon name={option.icon} />
                <span>{option.label}</span>
              </label>
            ))
          }
        </div>
      </div>
      <div class="row">
        <div>
          <p class="row-label" id="language-label">{t('settings.language')}</p>
          <p class="row-hint" id="language-hint">{t('settings.on-this-device')}</p>
        </div>
        <div
          class="segmented"
          role="radiogroup"
          aria-labelledby="language-label"
          aria-describedby="language-hint"
          data-language-picker
        >
          {
            languageOptions.map((option) => (
              <label class="segment">
                <input type="radio" name="language" value={option.value} checked={option.value === chosenLanguage} />
                <span lang={option.value || undefined}>{option.label}</span>
              </label>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</AppShell>

<script>
  import { applyAppearance, parseAppearance, readAppearance, saveAppearance } from '../lib/appearance';
  import { checkedAccount, signOutHere } from '../lib/auth/server-client';
  import { parseLanguage, saveLanguage, t } from '../lib/i18n/i18n';
  import { loadSession, type AuthState } from '../lib/auth/session';

  const auth = document.querySelector<HTMLElement>('[data-auth]')!;
  const status = auth.querySelector<HTMLElement>('[data-auth-status]')!;
  const signOutButton = auth.querySelector<HTMLButtonElement>('[data-sign-out]')!;
  const error = auth.querySelector<HTMLElement>('[data-auth-error]')!;

  let state: AuthState = { status: 'signed-out' };

  // Signed out with no message: the gate (AppShell) sends the visitor to the sign-in screen.
  function render(next: AuthState) {
    state = next;
    const signedIn = next.status === 'signed-in';
    status.textContent = signedIn ? t('settings.signed-in-as', next.account.handle) : '';
    signOutButton.hidden = !signedIn;
    error.textContent = signedIn ? '' : (next.message ?? '');
    error.hidden = !error.textContent;
  }

  function busy(on: boolean) {
    for (const control of auth.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button, input')) control.disabled = on;
  }

  void loadSession({ init: checkedAccount }).then(render);
  // Signed out: the sign-in screen, unless something went wrong that the reader must read first.
  signOutButton.addEventListener('click', () => {
    if (state.status !== 'signed-in') return;
    busy(true);
    void signOutHere()
      .then((message) => render({ status: 'signed-out', message }))
      .finally(() => busy(false));
  });


  const radios = document.querySelectorAll<HTMLInputElement>('[data-appearance-picker] input[name="appearance"]');
  const stored = readAppearance();
  for (const radio of radios) {
    radio.checked = radio.value === stored;
    radio.addEventListener('change', () => {
      const appearance = parseAppearance(radio.value);
      saveAppearance(appearance);
      applyAppearance(document, appearance, matchMedia('(prefers-color-scheme: dark)').matches);
    });
  }

  // The server renders each page in the language: reload to show this one in it.
  for (const radio of document.querySelectorAll<HTMLInputElement>('[data-language-picker] input[name="language"]')) {
    radio.addEventListener('change', () => {
      saveLanguage(parseLanguage(radio.value));
      location.reload();
    });
  }
</script>

<style>
  .settings {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .group-title {
    font-size: 18px;
  }

  .row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .row-label {
    font-size: 14px;
    font-weight: 600;
  }

  .row-hint {
    color: var(--secondary);
    font-size: 13px;
  }

  .row-error {
    color: var(--ink);
    font-size: 13px;
  }

  /* Desktop: list group on a hairline, label left and control right. */
  @media (min-width: 960px) {
    .settings {
      gap: 28px;
    }

    .group-title {
      display: flex;
      align-items: center;
      min-height: var(--row);
      border-bottom: 1px solid var(--line);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0;
    }

    .row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
  }
</style>
