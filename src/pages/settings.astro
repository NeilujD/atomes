---
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icons';
import AppShell from '../layouts/AppShell.astro';
import type { Appearance } from '../lib/appearance';

const options: { value: Appearance; label: string; icon: IconName }[] = [
  { value: 'system', label: 'System', icon: 'monitor' },
  { value: 'light', label: 'Light', icon: 'sun' },
  { value: 'dark', label: 'Dark', icon: 'moon' },
];
---

<AppShell title="Settings" current="settings">
  <div class="settings">
    <section class="group" data-auth>
      <h2 class="group-title">Account</h2>
      <div class="row">
        <div>
          <p class="row-label">AT Protocol account</p>
          <p class="row-hint" data-auth-status aria-live="polite">Checking…</p>
        </div>
        <form class="sign-in" data-sign-in hidden>
          <label class="visually-hidden" for="handle">Your handle</label>
          <input
            class="field"
            id="handle"
            name="handle"
            type="text"
            inputmode="url"
            autocomplete="username"
            autocapitalize="none"
            spellcheck="false"
            placeholder="alice.bsky.social"
          />
          <button class="button" type="submit">Sign in</button>
        </form>
        <button class="button" type="button" data-sign-out hidden>Sign out</button>
      </div>
      <p class="row-error" data-auth-error role="alert" hidden></p>
    </section>

    <section class="group">
      <h2 class="group-title">Display</h2>
      <div class="row">
        <div>
          <p class="row-label" id="appearance-label">Appearance</p>
          <p class="row-hint" id="appearance-hint">Kept on this device.</p>
        </div>
        <div
          class="segmented"
          role="radiogroup"
          aria-labelledby="appearance-label"
          aria-describedby="appearance-hint"
          data-appearance-picker
        >
          {
            options.map((option) => (
              <label class="segment">
                <input type="radio" name="appearance" value={option.value} checked={option.value === 'system'} />
                <Icon name={option.icon} />
                <span>{option.label}</span>
              </label>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</AppShell>

<script>
  import { applyAppearance, parseAppearance, readAppearance, saveAppearance } from '../lib/appearance';
  import { createAuthClient } from '../lib/auth/browser-client';
  import { errorMessage, loadSession, signIn, signOut, type AuthClient, type AuthState } from '../lib/auth/session';

  const auth = document.querySelector<HTMLElement>('[data-auth]')!;
  const status = auth.querySelector<HTMLElement>('[data-auth-status]')!;
  const form = auth.querySelector<HTMLFormElement>('[data-sign-in]')!;
  const handleInput = form.querySelector<HTMLInputElement>('input[name="handle"]')!;
  const signOutButton = auth.querySelector<HTMLButtonElement>('[data-sign-out]')!;
  const error = auth.querySelector<HTMLElement>('[data-auth-error]')!;

  let state: AuthState = { status: 'signed-out' };

  function render(next: AuthState) {
    state = next;
    const signedIn = next.status === 'signed-in';
    status.textContent = signedIn
      ? `Signed in as @${next.account.handle}`
      : 'Sign in on your PDS page. Atomes never sees your password.';
    form.hidden = signedIn;
    signOutButton.hidden = !signedIn;
    error.textContent = signedIn ? '' : (next.message ?? '');
    error.hidden = !error.textContent;
  }

  function busy(on: boolean) {
    for (const control of auth.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button, input')) control.disabled = on;
  }

  createAuthClient().then(
    async (client: AuthClient) => {
      render(await loadSession(client));
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        busy(true);
        void signIn(client, handleInput.value)
          .then(render)
          .finally(() => busy(false));
      });
      signOutButton.addEventListener('click', () => {
        if (state.status !== 'signed-in') return;
        busy(true);
        void signOut(client, state.account)
          .then(render)
          .finally(() => busy(false));
      });
    },
    (cause: unknown) => render({ status: 'signed-out', message: errorMessage(cause) }),
  );


  const radios = document.querySelectorAll<HTMLInputElement>('[data-appearance-picker] input[name="appearance"]');
  const stored = readAppearance();
  for (const radio of radios) {
    radio.checked = radio.value === stored;
    radio.addEventListener('change', () => {
      const appearance = parseAppearance(radio.value);
      saveAppearance(appearance);
      applyAppearance(document, appearance, matchMedia('(prefers-color-scheme: dark)').matches);
    });
  }
</script>

<style>
  .settings {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .group-title {
    font-size: 18px;
  }

  .row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .row-label {
    font-size: 14px;
    font-weight: 600;
  }

  .row-hint {
    color: var(--secondary);
    font-size: 13px;
  }

  .segmented {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border-radius: var(--radius-control);
    background: var(--soft);
  }

  .segment {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: calc(var(--row) - 4px);
    padding: 0 12px;
    border-radius: calc(var(--radius-control) - 2px);
    color: var(--secondary);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }

  .segment input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .segment:has(input:checked) {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 0 0 1px var(--line);
  }

  .segment:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sign-in {
    display: flex;
    gap: 8px;
    width: 100%;
    max-width: 360px;
  }

  .field {
    flex: 1;
    min-width: 0;
    min-height: var(--row);
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
  }

  .button {
    min-height: var(--row);
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .button:hover:not(:disabled) {
    background: var(--soft);
  }

  .button:disabled,
  .field:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .row-error {
    color: var(--ink);
    font-size: 13px;
  }

  /* Desktop: list group on a hairline, label left and control right. */
  @media (min-width: 960px) {
    .settings {
      gap: 28px;
    }

    .group-title {
      display: flex;
      align-items: center;
      min-height: var(--row);
      border-bottom: 1px solid var(--line);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0;
    }

    .row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
  }
</style>
