---
import Icon from '../components/Icon.astro';
import AppShell from '../layouts/AppShell.astro';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));

// Home before sign-in and storage exist: every section shows its empty state.
const sections = [
  { title: t('home.new'), empty: t('home.new-empty') },
  { title: t('home.reading'), empty: t('home.reading-empty') },
  { title: t('home.owned-unread'), empty: t('home.owned-unread-empty') },
];
---

<AppShell title={t('home.title')} current="home">
  <a slot="actions" class="button" href="/add">
    <Icon name="keyboard" />
    <span>{t('home.type-isbn')}</span>
  </a>
  <div class="home">
    {
      sections.map((section) => (
        <section class="group">
          <h2 class="group-title">{section.title}</h2>
          <p class="empty">{section.empty}</p>
        </section>
      ))
    }
  </div>
</AppShell>

<style>
  .home {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .group-title {
    font-size: 18px;
  }

  .empty {
    color: var(--secondary);
    font-size: 14px;
  }

  /* Desktop: sections read as list groups (header row on a hairline), not as cards. */
  @media (min-width: 960px) {
    .home {
      gap: 28px;
    }

    .group-title {
      display: flex;
      align-items: center;
      min-height: var(--row);
      border-bottom: 1px solid var(--line);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0;
    }
  }
</style>
