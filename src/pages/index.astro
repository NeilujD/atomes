---
// Home: the books the reader owns and has not read, then the books being read
// (src/islands/Home.tsx). Rendered on the device: it reads the Library.
// The cobalt glow behind the top of the screen is drawn here, on the server,
// so it shows before the island (ui-direction Q9).
import AppShell from '../layouts/AppShell.astro';
import Home, { HomeSkeleton } from '../islands/Home';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));
---

<AppShell title={t('home.title')} current="home">
  <div class="home-page">
    <div class="home-glow" aria-hidden="true">
      <div class="home-blob home-b1"></div>
      <div class="home-blob home-b2"></div>
      <div class="home-blob home-b3"></div>
    </div>
    <Home client:only="preact">
      <HomeSkeleton slot="fallback" />
    </Home>
  </div>
</AppShell>

<style is:global>
  /* Global: the island renders on the device, outside this page's scoped styles. */
  .home-page {
    position: relative;
  }

  /*
   * The glow (Q9): cobalt blobs behind the title and the first section, faded
   * out before the covers. Phone: it reaches up behind the large title, under
   * it in the page (z-index -1). Desktop: the view header stays as it is
   * (Q13), so the glow starts at the top of the panel body.
   */
  .home-glow {
    position: absolute;
    z-index: -1;
    inset: calc(var(--glow-unit) * -14) calc(var(--space-20) * -1) auto;
    height: calc(var(--glow-unit) * 34);
    overflow: hidden;
    pointer-events: none;
    /* Only the alpha of a mask counts: full ink is opaque in both themes. */
    mask-image: linear-gradient(var(--ink) var(--glow-stop-3), transparent);
  }

  /* As on the Shelf Check result: soft edges from a radial gradient on a padded box, never a blur. */
  .home-blob {
    --blob: var(--accent-fill);
    --glow: light-dark(color-mix(in oklab, var(--blob) var(--glow-light), transparent), var(--blob));
    position: absolute;
    box-sizing: content-box;
    margin: calc(var(--glow-pad-blob) * -1);
    padding: var(--glow-pad-blob);
    background: radial-gradient(
      circle closest-side,
      color-mix(in oklab, var(--glow) var(--glow-alpha-1), transparent),
      color-mix(in oklab, var(--glow) var(--glow-alpha-2), transparent) var(--glow-stop-2),
      color-mix(in oklab, var(--glow) var(--glow-alpha-3), transparent) var(--glow-stop-3),
      color-mix(in oklab, var(--glow) var(--glow-alpha-4), transparent) var(--glow-stop-4),
      transparent
    );
    will-change: transform;
  }

  .home-b1 {
    left: calc(var(--glow-unit) * -9);
    top: calc(var(--glow-unit) * -6);
    width: calc(var(--glow-unit) * 30);
    height: calc(var(--glow-unit) * 30);
    opacity: var(--glow-opacity-1);
    animation: homeDrift1 var(--motion-drift-1) ease-in-out infinite;
  }

  .home-b2 {
    right: calc(var(--glow-unit) * -10);
    top: calc(var(--glow-unit) * 2);
    width: calc(var(--glow-unit) * 24);
    height: calc(var(--glow-unit) * 24);
    opacity: var(--glow-opacity-2);
    animation: homeDrift2 var(--motion-drift-2) ease-in-out infinite;
  }

  .home-b3 {
    --blob: var(--accent);
    left: calc(var(--glow-unit) * 12);
    top: calc(var(--glow-unit) * 10);
    width: calc(var(--glow-unit) * 18);
    height: calc(var(--glow-unit) * 18);
    opacity: var(--glow-opacity-3);
    animation: homeDrift3 var(--motion-drift-3) ease-in-out infinite;
  }

  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-28);
  }

  .home-message {
    color: var(--text-quiet);
  }

  .home-empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
  }

  .home-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .home-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-20) var(--space-14);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The width of a cell is the width of its cover: the corners follow it. */
  .home-grid > li {
    container-type: inline-size;
  }

  .home-book {
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }

  .home-cover {
    width: 100%;
    margin-bottom: var(--space-8);
  }

  /* A cover 120 px wide or more takes the large corners (CSS reads no variable in a condition). */
  @container (width >= 120px) {
    .home-grid .home-cover,
    .home-grid .home-cover[data-cover='loaded'] img {
      border-radius: var(--radius-cover-large);
    }
  }

  .home-book-title,
  .home-book-line {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .home-book-title {
    font-size: var(--type-small);
    font-weight: 600;
  }

  .home-book-line {
    color: var(--text-quiet);
    font-size: var(--type-chip);
    font-variant-numeric: tabular-nums;
  }

  .home-book:hover .home-book-title {
    text-decoration: underline;
  }

  @media (min-width: 960px) {
    /* Over the panel: its own stacking context, so the glow stays on the panel and under the sticky view header. */
    .home-page {
      isolation: isolate;
    }

    .home-glow {
      inset: calc(var(--space-24) * -1) calc(var(--space-24) * -1) auto;
      height: calc(var(--glow-unit) * 28);
    }

    .home-grid {
      grid-template-columns: repeat(auto-fill, minmax(var(--home-cover), 1fr));
      gap: var(--space-28) var(--space-24);
    }
  }

  @keyframes homeDrift1 {
    50% {
      transform: translate(50px, 30px) scale(1.2);
    }
  }

  @keyframes homeDrift2 {
    50% {
      transform: translate(-60px, 20px) scale(0.9);
    }
  }

  @keyframes homeDrift3 {
    50% {
      transform: translate(30px, -20px) scale(1.15);
    }
  }

  /* The glow stays still. */
  @media (prefers-reduced-motion: reduce) {
    .home-blob {
      animation: none;
    }
  }
</style>
