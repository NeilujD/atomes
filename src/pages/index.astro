---
// Home: the books the reader owns and has not read, then the books being read
// (src/islands/Home.tsx). Rendered on the device: it reads the Library.
import AppShell from '../layouts/AppShell.astro';
import Home, { HomeSkeleton } from '../islands/Home';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));
---

<AppShell title={t('home.title')} current="home">
  <Home client:only="preact">
    <HomeSkeleton slot="fallback" />
  </Home>
</AppShell>

<style is:global>
  /* Global: the island renders on the device, outside this page's scoped styles. */
  .home {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .home-message {
    font-size: 14px;
  }

  .home-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .home-group-title {
    font-size: 18px;
  }

  .home-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-book {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }

  .home-cover {
    width: 100%;
    margin-bottom: 6px;
  }

  .home-book-title,
  .home-book-line {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .home-book-title {
    font-size: 13px;
    font-weight: 600;
  }

  .home-book-line {
    color: var(--secondary);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .home-book:hover .home-book-title {
    text-decoration: underline;
  }

  /* Desktop: sections read as list groups (header row on a hairline), not as cards. */
  @media (min-width: 960px) {
    .home {
      gap: 28px;
    }

    .home-group-title {
      display: flex;
      align-items: center;
      min-height: var(--row);
      border-bottom: 1px solid var(--line);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0;
    }

    .home-grid {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 28px 24px;
    }
  }
</style>
