---
// The sign-in screen (ADR 0013, amendment 2026-11-12; ADR 0016): every other
// app screen sends a visitor with no session here (the gate in AppShell), with
// the screen asked as `?next=`. A Flow screen (ui-direction): no sidebar or tab
// bar. First the email address, then its Sign-in Code (email-sign-in.ts).
// "Bluesky or another AT Protocol account" opens the handle field below: only
// there does the text name a PDS or a handle.
// The server sends a failed sign-in back here with `?auth=<result>`. An Invite
// link opens it as `/sign-in#invite=<token>`: the fragment never reaches a
// server, and the script sends the token to /api/invite, then drops it from
// the address. The service worker keeps this page by path: the script reads the query.
import Mark from '../components/Mark.astro';
import AppShell from '../layouts/AppShell.astro';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));
---

<AppShell title={t('signin.title')} flow>
  <section class="card" aria-labelledby="sign-in-title">
    <Mark size={48} />
    <h1 class="title" id="sign-in-title">{t('signin.heading')}</h1>
    <form class="step" data-email-form>
      <p class="hint">{t('signin.email-hint')}</p>
      <label class="visually-hidden" for="email">{t('signin.email')}</label>
      <div class="row">
        <input
          class="field"
          id="email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          autocapitalize="none"
          spellcheck="false"
          enterkeyhint="send"
          placeholder="alice@example.org"
        />
        <button class="button button-primary" type="submit">{t('signin.send-code')}</button>
      </div>
    </form>
    <form class="step" data-code-form hidden>
      <p class="hint" data-code-sent></p>
      <label class="visually-hidden" for="code">{t('signin.code')}</label>
      <div class="row">
        <input
          class="field code"
          id="code"
          name="code"
          type="text"
          inputmode="numeric"
          autocomplete="one-time-code"
          enterkeyhint="go"
          placeholder="123456"
        />
        <button class="button button-primary" type="submit">{t('signin.submit')}</button>
      </div>
      <!-- Shown only where the browser can read the clipboard. -->
      <button class="button" type="button" data-paste-code hidden>{t('signin.paste-code')}</button>
      <button class="button button-quiet" type="button" data-other-address>{t('signin.other-address')}</button>
    </form>
    <button class="button other" type="button" data-atproto aria-expanded="false" aria-controls="atproto">{t('signin.atproto')}</button>
    <div class="step" id="atproto" hidden>
      <p class="hint">{t('signin.hint')}</p>
      <!-- The reason for the permission the PDS asks for (CORE-38). -->
      <p class="hint">{t('signin.sharing')}</p>
      <form class="row" data-sign-in>
        <label class="visually-hidden" for="handle">{t('signin.handle')}</label>
        <input
          class="field"
          id="handle"
          name="handle"
          type="text"
          inputmode="url"
          autocomplete="username"
          autocapitalize="none"
          spellcheck="false"
          enterkeyhint="go"
          placeholder="alice.bsky.social"
        />
        <button class="button button-primary" type="submit">{t('signin.submit')}</button>
      </form>
    </div>
    <p class="error" data-error role="alert" hidden></p>
    <a class="privacy" href="/privacy">{t('signin.privacy')}</a>
  </section>
</AppShell>

<script>
  import { returnTarget } from '../lib/auth/return-to';
  import { createAuthClient } from '../lib/auth/server-client';
  import { t } from '../lib/i18n/i18n';
  import { askSignInCode, codeIn, keepInvite, loadSession, signIn, signInResultMessage, signInWithCode } from '../lib/auth/session';

  const emailForm = document.querySelector<HTMLFormElement>('[data-email-form]')!;
  const codeForm = document.querySelector<HTMLFormElement>('[data-code-form]')!;
  const emailInput = emailForm.querySelector<HTMLInputElement>('input[name="email"]')!;
  const codeInput = codeForm.querySelector<HTMLInputElement>('input[name="code"]')!;
  const codeSent = codeForm.querySelector<HTMLElement>('[data-code-sent]')!;
  const atprotoButton = document.querySelector<HTMLButtonElement>('[data-atproto]')!;
  const atproto = document.querySelector<HTMLElement>('#atproto')!;
  const form = document.querySelector<HTMLFormElement>('[data-sign-in]')!;
  const handleInput = form.querySelector<HTMLInputElement>('input[name="handle"]')!;
  const error = document.querySelector<HTMLElement>('[data-error]')!;
  const send = (input: string, init?: RequestInit) => fetch(input, init);

  // `?auth=` and `#invite=` are read once, then dropped from the address, so a
  // reload does not show them again and the Invite is in no history entry.
  const url = new URL(location.href);
  const result = url.searchParams.get('auth');
  const invite = new URLSearchParams(url.hash.slice(1)).get('invite');
  const next = returnTarget(url.searchParams.get('next'));
  url.searchParams.delete('auth');
  url.hash = '';
  history.replaceState(history.state, '', url);
  const inviteSaid = invite ? keepInvite(send, invite) : Promise.resolve(undefined);

  // The address the code was sent to, while the code step shows.
  let email = '';

  function say(message: string | undefined) {
    error.textContent = message ?? '';
    error.hidden = !message;
  }

  // Disables the controls of a form while its request runs.
  async function busy<T>(target: HTMLFormElement, run: () => Promise<T>): Promise<T> {
    const controls = [...target.querySelectorAll<HTMLInputElement | HTMLButtonElement>('input, button')];
    const submit = target.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    for (const control of controls) control.disabled = true;
    submit.setAttribute('aria-busy', 'true');
    try {
      return await run();
    } finally {
      for (const control of controls) control.disabled = false;
      submit.setAttribute('aria-busy', 'false');
    }
  }

  function showCodeStep(address: string | undefined) {
    email = address ?? '';
    emailForm.hidden = address !== undefined;
    codeForm.hidden = address === undefined;
    codeSent.textContent = address ? t('signin.code-sent', address) : '';
    codeInput.value = '';
    (address ? codeInput : emailInput).focus();
  }

  function openAtproto() {
    atproto.hidden = false;
    atprotoButton.hidden = true;
    atprotoButton.setAttribute('aria-expanded', 'true');
  }

  // A result of the AT Protocol sign-in (the server sends it back here) opens
  // its part of the screen; the Account deleted messages do not.
  if (result && !result.startsWith('deleted')) openAtproto();

  // Signed in already (on this device, or offline with a saved account): back to the screen asked.
  void Promise.all([loadSession(createAuthClient()), inviteSaid]).then(([state, inviteMessage]) => {
    if (state.status === 'signed-in') return location.replace(next);
    say(state.message ?? inviteMessage ?? signInResultMessage(result));
  });

  emailForm.addEventListener('submit', (event) => {
    event.preventDefault();
    say(undefined);
    void busy(emailForm, () => askSignInCode(send, emailInput.value)).then((answer) => {
      if ('email' in answer) showCodeStep(answer.email);
      else say(answer.message);
    });
  });

  codeForm.addEventListener('submit', (event) => {
    event.preventDefault();
    void busy(codeForm, () => signInWithCode(send, email, codeInput.value)).then((message) => {
      if (message === undefined) location.replace(next);
      else say(message);
    });
  });

  // A whole code, typed, pasted or suggested by the keyboard, signs in at once.
  codeInput.addEventListener('input', () => {
    const code = codeIn(codeInput.value);
    if (code === undefined) return;
    codeInput.value = code;
    codeForm.requestSubmit();
  });

  const pasteButton = codeForm.querySelector<HTMLButtonElement>('[data-paste-code]')!;
  pasteButton.hidden = typeof navigator.clipboard?.readText !== 'function';
  pasteButton.addEventListener('click', () => {
    say(undefined);
    navigator.clipboard.readText().then(
      (text) => {
        const code = codeIn(text);
        if (code === undefined) return say(t('signin.no-code-copied'));
        codeInput.value = code;
        codeForm.requestSubmit();
      },
      () => say(t('signin.paste-refused')),
    );
  });

  codeForm.querySelector('[data-other-address]')!.addEventListener('click', () => {
    say(undefined);
    showCodeStep(undefined);
  });

  atprotoButton.addEventListener('click', () => {
    openAtproto();
    handleInput.focus();
  });

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    void busy(form, () => signIn(createAuthClient(), handleInput.value, next)).then((state) =>
      say(state.status === 'signed-out' ? state.message : undefined),
    );
  });
</script>

<style>
  .card {
    width: min(100%, 400px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .title {
    margin-top: 8px;
    font-size: 26px;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hint {
    width: 100%;
    color: var(--secondary);
    font-size: 14px;
    text-wrap: pretty;
  }

  .step {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .step[hidden] {
    display: none;
  }

  .row {
    width: 100%;
    display: flex;
    gap: 8px;
  }

  .row .field {
    flex: 1;
  }

  .code {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.2em;
  }

  .other {
    width: 100%;
    margin-top: 8px;
  }

  .privacy {
    margin-top: 8px;
    font-size: 13px;
  }

  .error {
    font-size: 14px;
    font-weight: 500;
    text-wrap: pretty;
  }

  /* Desktop: the screen is a card on the ground colour. */
  @media (min-width: 960px) {
    .card {
      padding: 40px;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: var(--surface);
    }
  }
</style>
