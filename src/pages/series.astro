---
// Series page: where the reader stands in one Series; follow, switch Edition
// Line, stop following; each spine opens a Volume sheet (src/islands/Series.tsx). `?isbn=<an Edition of the
// Series>` (seriesHref). Rendered on the device: it reads the Library.
import AppShell from '../layouts/AppShell.astro';
import Series, { SeriesSkeleton } from '../islands/Series';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));
const isbn = Astro.url.searchParams.get('isbn') ?? '';
---

<AppShell title={t('series.title')} current="library" detail>
  <Series client:only="preact" isbn={isbn}>
    <SeriesSkeleton slot="fallback" />
  </Series>
</AppShell>

<style is:global>
  /* Global: the island renders on the device, outside this page's scoped styles. */
  .series {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .series-message {
    font-size: 14px;
  }

  .series-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 32px;
  }

  .series-cover {
    flex: none;
    width: 160px;
  }

  .series-text {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .series-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .series-tag {
    padding: 2px 8px;
    border-radius: var(--radius-control);
    background: var(--soft);
    color: var(--secondary);
    font-size: 12px;
    font-weight: 600;
  }

  /* Ink, not cobalt: cobalt is for New and Upcoming Volumes, links and focus (ui-direction). */
  .series-tag[data-following] {
    color: var(--ink);
  }

  .series-title {
    font-size: 40px;
    line-height: 1.1;
  }

  .series-authors {
    font-size: 15px;
  }

  .series-counts {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin: 12px 0 8px;
  }

  /* The number above its label; the markup keeps the term first. */
  .series-count {
    display: flex;
    flex-direction: column-reverse;
  }

  .series-count dd {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .series-count dt {
    color: var(--secondary);
    font-size: 13px;
  }

  .series-actions,
  .series-switch-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .series-switch {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .series-label {
    font-size: 14px;
    font-weight: 600;
  }

  .series-switch-row .field {
    flex: 1;
    max-width: 280px;
  }

  .series-hint {
    color: var(--secondary);
    font-size: 13px;
  }

  .series-hint[data-error] {
    color: var(--ink);
    font-weight: 600;
  }

  .series-missing {
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
  }

  .series-missing-title {
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }

  .series-group-title {
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 600;
  }

  /* The spine row: filled = read, outlined = owned not read, dashed grey = not owned. */
  .series-spines {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .series-spine {
    position: relative;
  }

  /* A tap target of at least 24 px wide (WCAG 2.5.8) around the 14 px spine. */
  .series-spine-button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 24px;
    /* 6 px on top: room for the 4 px lift inside the button and its focus ring. */
    padding: 6px 5px 2px;
    border: 0;
    border-radius: var(--radius-control);
    background: none;
    color: var(--secondary);
    font: inherit;
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }

  /*
   * Mouse hover only (the island shows it for a mouse pointer): the cover just
   * above the lifted spine, over the row above. Centred, or lined up with the
   * end of the spine row it would pass (data-align, Series.tsx).
   */
  .series-peek {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    z-index: 2;
    width: 96px;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .series-peek[data-align='start'] {
    left: 0;
    transform: none;
  }

  .series-peek[data-align='end'] {
    left: auto;
    right: 0;
    transform: none;
  }

  .series-peek-cover {
    width: 100%;
  }

  .series-spine-bar {
    width: 14px;
    height: 44px;
    border-radius: 2px;
    border: 1.5px solid var(--ink);
    transition: transform 0.15s ease-out;
  }

  /* A book pulled a little off the shelf, with a mouse or the keyboard: the only hover sign (no fill). */
  @media (hover: hover) {
    .series-spine-button:hover .series-spine-bar {
      transform: translateY(-4px);
    }
  }

  .series-spine-button:focus-visible .series-spine-bar {
    transform: translateY(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .series-spine-bar {
      transition: none;
    }
  }

  .series-spine[data-state='read'] .series-spine-bar {
    background: var(--ink);
  }

  .series-spine[data-state='not-owned'] .series-spine-bar {
    border: 1.5px dashed var(--off);
  }

  /* The Volume sheet: from the bottom on the phone, a card on desktop. */
  .series-sheet {
    inset: auto 0 0;
    width: 100%;
    max-width: none;
    max-height: 85dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-top: 1px solid var(--line);
    border-radius: var(--radius-panel) var(--radius-panel) 0 0;
    background: var(--surface);
    color: var(--ink);
  }

  .series-sheet-body {
    padding: 20px 20px max(20px, env(safe-area-inset-bottom));
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 16px 20px;
    align-items: start;
  }

  .series-sheet::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  .series-sheet-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
  }

  .series-sheet-title {
    font-size: 20px;
    line-height: 1.2;
  }

  .series-sheet .series-actions {
    margin-top: 12px;
  }

  .series-sheet-close {
    grid-column: 1 / -1;
    justify-self: end;
  }

  @media (min-width: 960px) {
    .series-sheet-body {
      padding: 24px;
    }

    .series-sheet {
      inset: 0;
      width: 440px;
      margin: auto;
      border: 1px solid var(--line);
      border-radius: var(--radius-panel);
    }
  }

  .series-skeleton-title {
    width: 50%;
    height: 32px;
  }

  .series-skeleton-line {
    width: 30%;
    height: 14px;
  }

  @media (max-width: 959px) {
    .series-cover {
      width: 106px;
    }

    .series-title {
      font-size: 28px;
    }
  }
</style>
