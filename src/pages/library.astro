---
// The Library in Grid mode, with the shared toolbar (src/islands/Library.tsx).
// Rendered on the device: it reads the Library, so it opens offline.
import AppShell from '../layouts/AppShell.astro';
import Library, { LibrarySkeleton } from '../islands/Library';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));
---

<AppShell title={t('library.title')} current="library">
  <Library client:only="preact">
    <LibrarySkeleton slot="fallback" />
  </Library>
</AppShell>

<style is:global>
  /* Global: the island renders on the device, outside this page's scoped styles. */
  .library {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .library-message {
    font-size: 14px;
  }

  .library-add {
    align-self: flex-start;
  }

  .library-toolbar {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .library-search-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .library-search {
    flex: 1;
    min-width: 0;
  }

  .library-search .field {
    width: 100%;
  }

  .library-count {
    color: var(--secondary);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .library-clear {
    flex: none;
  }

  .library-count-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: var(--row);
  }

  .library-filters {
    flex: none;
  }

  .library-badge {
    display: inline-grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    background: var(--ink);
    color: var(--surface);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .library-controls {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .library-selects {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .library-select {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .library-select label {
    color: var(--secondary);
    font-size: 12px;
    font-weight: 600;
  }

  .library-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Pressed: ink, not cobalt (cobalt is for New Volumes, links and focus). */
  .library-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--row);
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: calc(var(--row) / 2);
    background: var(--surface);
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .library-chip:hover {
    background: var(--soft);
  }

  .library-chip[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--surface);
  }

  .library-chip-count {
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  .library-no-match {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 48px 16px;
    font-size: 15px;
    font-weight: 600;
    text-align: center;
  }

  /* Phone: three covers a row. */
  .library-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .library-book {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }

  .library-cover {
    width: 100%;
    margin-bottom: 6px;
  }

  .library-book-title,
  .library-book-line {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .library-book-title {
    font-size: 13px;
    font-weight: 600;
  }

  .library-book-line {
    color: var(--secondary);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .library-book:hover .library-book-title {
    text-decoration: underline;
  }

  /* Phone: the controls in a sheet from the bottom. */
  .library-sheet {
    inset: auto 0 0;
    width: 100%;
    max-width: none;
    max-height: 85dvh;
    margin: 0;
    padding: 20px 20px max(20px, env(safe-area-inset-bottom));
    border: 0;
    border-top: 1px solid var(--line);
    border-radius: var(--radius-panel) var(--radius-panel) 0 0;
    background: var(--surface);
    color: var(--ink);
  }

  .library-sheet[open] {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .library-sheet::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  .library-sheet .library-selects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .library-sheet .field {
    width: 100%;
  }

  /* Desktop: the toolbar is a second header row, under the view header (ui-direction). */
  @media (min-width: 960px) {
    .library-toolbar {
      position: sticky;
      top: 48px;
      z-index: 1;
      margin: -24px -24px 0;
      padding: 12px 24px;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
    }

    .library-search {
      max-width: 420px;
    }

    .library-search-row .library-count {
      margin-left: auto;
    }

    .library-select .field {
      min-width: 160px;
    }

    .library-grid {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 28px 24px;
    }
  }
</style>
