---
// The Library in Grid, List and Cover flow, with the shared toolbar (src/islands/Library.tsx).
// Rendered on the device: it reads the Library, so it opens offline.
import AppShell from '../layouts/AppShell.astro';
import '../styles/correction.css';
import '../styles/selection.css';
import Library, { LibrarySkeleton } from '../islands/Library';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));
---

<AppShell title={t('library.title')} current="library">
  <Library client:only="preact">
    <LibrarySkeleton slot="fallback" />
  </Library>
</AppShell>

<style is:global>
  /* Global: the island renders on the device, outside this page's scoped styles. */
  .library {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .library-message {
    font-size: 14px;
  }

  .library-add {
    align-self: flex-start;
  }

  .library-toolbar {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .library-search-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .library-search {
    flex: 1;
    min-width: 0;
  }

  .library-search .field {
    width: 100%;
  }

  /* The Books / Series switch and the Grid / List / Cover flow switch (Segmented).
     Desktop: both in the search row. Phone: Books / Series is a row of its own,
     as wide as the screen; the mode is one icon in the search row (.library-view). */
  .library-toolbar > .library-switch {
    display: flex;
  }

  .library-toolbar > .library-switch .segment {
    flex: 1;
    justify-content: center;
  }

  .library-search-row .library-switch {
    flex: none;
  }

  /* Phone: the mode as one square button with the icon of the mode on. The
     native select lies over it, unseen, so a tap opens the system menu. */
  .library-view {
    position: relative;
    flex: none;
    display: inline-grid;
    place-items: center;
    width: var(--row);
    height: var(--row);
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
  }

  .library-view select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    /* 16 px: iOS zooms into a smaller field it focuses. */
    font-size: 16px;
    cursor: pointer;
  }

  .library-view:has(select:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .library-count {
    color: var(--secondary);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .library-clear {
    flex: none;
  }

  .library-count-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: var(--row);
  }

  .library-filters {
    flex: none;
  }

  .library-badge {
    display: inline-grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    background: var(--ink);
    color: var(--surface);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .library-controls {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .library-selects {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .library-select {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .library-select label {
    color: var(--secondary);
    font-size: 12px;
    font-weight: 600;
  }

  .library-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Pressed: ink, not cobalt (cobalt is for New Volumes, links and focus). */
  .library-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--row);
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: calc(var(--row) / 2);
    background: var(--surface);
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    max-width: 100%;
  }

  /* A long Label name stays on one line and ends with "…": the chip is never wider than its row. */
  .library-chip-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .library-chip:hover {
    background: var(--soft);
  }

  .library-chip[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--surface);
  }

  .library-chip-count {
    flex: none;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  .library-no-match {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 48px 16px;
    font-size: 15px;
    font-weight: 600;
    text-align: center;
  }

  /* Phone: three covers a row. */
  .library-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .library-book {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }

  .library-cover {
    width: 100%;
    margin-bottom: 6px;
  }

  .library-book-title,
  .library-book-line {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .library-book-title {
    font-size: 13px;
    font-weight: 600;
  }

  .library-book-line {
    color: var(--secondary);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .library-book:hover .library-book-title {
    text-decoration: underline;
  }

  /* A Work read with no Copy (CORE-100), in Grid, List and Cover flow: a grey,
     faint cover and the quiet "Not owned" words, no colour role. Only the
     cover fades, so the text keeps its contrast. */
  .library-not-owned .book-cover {
    filter: grayscale(1);
    opacity: 0.6;
  }

  /* Phone: the controls in a sheet from the bottom. */
  .library-sheet {
    inset: auto 0 0;
    width: 100%;
    max-width: none;
    max-height: 85dvh;
    margin: 0;
    padding: 20px 20px max(20px, env(safe-area-inset-bottom));
    border: 0;
    border-top: 1px solid var(--line);
    border-radius: var(--radius-panel) var(--radius-panel) 0 0;
    background: var(--surface);
    color: var(--ink);
  }

  .library-sheet[open] {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .library-sheet::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  .library-sheet .library-selects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .library-sheet .field {
    width: 100%;
  }

  /* Desktop: the toolbar is a second header row, under the view header (ui-direction). */
  @media (min-width: 960px) {
    .library-toolbar {
      position: sticky;
      top: 48px;
      z-index: 1;
      margin: -24px -24px 0;
      padding: 12px 24px;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
    }

    /* The search keeps a width to type in. When the row is too long (a filter
       on, in a narrow window), the mode switch goes to a second line, still at the right. */
    .library-search-row {
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .library-search {
      flex: 1 1 200px;
      min-width: 200px;
      max-width: 420px;
    }

    .library-search-row .library-count {
      margin-left: auto;
    }

    /* 160 px each; in a narrow window the four get narrower, down to 130 px, to stay on one line. */
    .library-select {
      flex: 1 1 130px;
      max-width: 160px;
    }

    .library-select .field {
      width: 100%;
    }

    .library-grid {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 28px 24px;
    }
  }
</style>

<style is:global>
  /* List and Cover flow (src/islands/LibraryList.tsx, LibraryCoverFlow.tsx). */

  /* List: letter groups on hairlines (ui-direction: list with groups). */
  .library-list {
    display: flex;
    flex-direction: column;
  }

  .library-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Phone: the letter stays on top while its books scroll. */
  .library-letter {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 1;
    padding: 10px 0 6px;
    border-bottom: 1px solid var(--line);
    background: var(--ground);
    color: var(--secondary);
    font-size: 13px;
    letter-spacing: 0;
  }

  /* Phone: the author under the title. */
  .library-row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    grid-template-areas:
      'cover main status'
      'cover author status';
    align-content: center;
    column-gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .library-row-cover {
    grid-area: cover;
    align-self: center;
  }

  .library-row-main {
    grid-area: main;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .library-row-title,
  .library-row-line,
  .library-row-author {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .library-row-title {
    font-size: 15px;
    font-weight: 600;
  }

  .library-row-line,
  .library-row-author {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .library-row-author {
    grid-area: author;
    color: var(--secondary);
  }

  .library-row-status {
    grid-area: status;
    align-self: center;
    color: var(--secondary);
    font-size: 12px;
    white-space: nowrap;
  }

  .library-row:hover .library-row-title {
    text-decoration: underline;
  }

  /* The A to Z index. Phone: a rail on the right edge, in the margin of the
     page, 16 px a letter, shorter on a short screen. */
  .library-index {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    max-height: min(432px, 100dvh - 200px);
    transform: translateY(-50%);
  }

  .library-index button {
    flex: 0 1 16px;
    width: 20px;
    min-height: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
  }

  /* Cover flow: one cover in front, the covers nearby turned on each side.
     `--flow-cover` is the widest the cover in front gets; `--flow-near` and
     `--flow-step` place the covers on the sides, as shares of its width. */
  .library-flow {
    --flow-cover: 170px;
    --flow-near: 0.75;
    --flow-step: 0.2;
    /* Over and under the cover in front: its shadow. */
    --flow-room: 52px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Cover flow takes the height the frame leaves, so Previous, the slider and
     Next show with no scroll: the stage gets what the toolbar, the text and
     the controls do not use, and the covers follow its height. */
  .panel:has(.library-flow) {
    display: flex;
    flex-direction: column;
  }

  .view-body:has(.library-flow) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .library:has(.library-flow) {
    flex: 1;
  }

  /* Phone: the page is as high as the screen; the tab bar is over its bottom padding. */
  @media (max-width: 959.98px) {
    .panel:has(.library-flow) {
      min-height: 100dvh;
    }
  }

  /* As wide as the panel: the covers on the sides go under its edges. On a
     small screen it keeps a height to see the covers, and the page scrolls. */
  .library-flow-stage {
    container-type: size;
    position: relative;
    flex: 1 1 0;
    min-height: 200px;
    max-height: calc(var(--flow-cover) * 1.5 + var(--flow-room));
    margin: 0 -20px;
    overflow: hidden;
    perspective: 1100px;
  }

  /* `--side` is -1, 0 or 1; `--away` counts the covers from the one in front.
     No underline: the default cover is text inside this link. */
  .library-flow-cover {
    --cover: min(var(--flow-cover), (100cqh - var(--flow-room)) * 2 / 3);
    position: absolute;
    top: 20px;
    left: 50%;
    z-index: calc(10 - var(--away));
    width: var(--cover);
    margin-left: calc(var(--cover) / -2);
    text-decoration: none;
    transform: translateX(calc(var(--side) * var(--cover) * (var(--flow-near) + (var(--away) - 1) * var(--flow-step)))) rotateY(calc(var(--side) * -58deg))
      scale(calc(1 - 0.2 * min(var(--away), 1)));
    transition:
      transform 360ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 220ms;
  }

  /* A cover that comes in from the edge fades in, where the browser can. */
  @starting-style {
    .library-flow-cover {
      opacity: 0;
    }
  }

  /* Phone (CORE-106): every cover in a strip the reader swipes. It snaps on a
     cover, which comes to the front; the covers on the sides turn and stack
     as on desktop. The covers stand 3/4 of a cover apart (--flow-near), so
     the two next to the middle one need no shift. The spacers at each end
     let the first and the last cover reach the middle. */
  .library-flow-strip {
    display: flex;
    gap: 0;
    overflow: auto hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .library-flow-strip::-webkit-scrollbar {
    display: none;
  }

  .library-flow-strip::before,
  .library-flow-strip::after,
  .library-flow-strip .library-flow-cover {
    --cover: min(var(--flow-cover), (100cqh - var(--flow-room)) * 2 / 3);
  }

  .library-flow-strip::before,
  .library-flow-strip::after {
    content: '';
    flex: none;
    width: calc(50% - var(--cover) * var(--flow-near) / 2);
  }

  .library-flow-strip .library-flow-cover {
    position: relative;
    top: auto;
    left: auto;
    flex: none;
    align-self: flex-start;
    margin: 20px calc(var(--cover) * (var(--flow-near) - 1) / 2) 0;
    transform: none;
    transition: none;
    scroll-snap-align: center;
    /* The face turns, the link stays: a tap goes to the face it sees. WebKit snaps on the transformed box. */
    pointer-events: none;
  }

  .library-flow-strip .library-flow-face {
    pointer-events: auto;
  }

  /* The turn and the stack follow the scroll in the browser's own scroll
     thread (Chrome 115, Safari 26), so the faces never lag the finger.
     Elsewhere the island sets the same transform as the strip scrolls
     (src/islands/LibraryCoverFlow.tsx, flowStand in src/lib/library/flow.ts).
     Each link and its face follow their own view of the strip (`cover` range:
     0% as it comes in at the right, 50% in the middle, 100% as it leaves at
     the left), widened by two strip widths on each side (inset -200%), so the
     covers packed at the edges get their shift too. Between the two covers
     next to the middle (--step on each side): turn and scale. Past them: a
     shift that packs the covers to --flow-step of a cover apart. The nearer
     cover is on top (z-index). Anonymous timelines: Safari 26 does not attach
     the face to a timeline its link names. */
  @supports (animation-timeline: view()) {
    .library-flow-strip .library-flow-cover {
      --step: calc(var(--cover) * var(--flow-near));
      animation: library-flow-order linear both;
      animation-timeline: view(inline -200%);
    }

    .library-flow-strip .library-flow-face {
      animation:
        library-flow-turn linear both,
        library-flow-pack-in linear none,
        library-flow-pack-out linear none;
      animation-timeline: view(inline -200%), view(inline -200%), view(inline -200%);
      animation-range:
        cover calc(50% - var(--step)) cover calc(50% + var(--step)),
        cover 0% cover calc(50% - var(--step)),
        cover calc(50% + var(--step)) cover 100%;
    }
  }

  @keyframes library-flow-order {
    0%,
    100% {
      z-index: 0;
    }

    50% {
      z-index: 1000;
    }
  }

  @keyframes library-flow-turn {
    from {
      transform: perspective(1100px) rotateY(-58deg) scale(0.8);
    }

    50% {
      transform: perspective(1100px) rotateY(0) scale(1);
    }

    to {
      transform: perspective(1100px) rotateY(58deg) scale(0.8);
    }
  }

  /* A cover `n` steps from the middle (n > 1) moves (n - 1) * (--flow-near - --flow-step)
     covers toward it. At the start of its range, n * --step is half of five strip widths
     (the strip and two on each side) plus half a cover. */
  @keyframes library-flow-pack-in {
    from {
      translate: calc(((500cqw + var(--cover)) / 2 - var(--step)) * (var(--flow-step) - var(--flow-near)) / var(--flow-near)) 0;
    }

    to {
      translate: 0 0;
    }
  }

  @keyframes library-flow-pack-out {
    from {
      translate: 0 0;
    }

    to {
      translate: calc(((500cqw + var(--cover)) / 2 - var(--step)) * (var(--flow-near) - var(--flow-step)) / var(--flow-near)) 0;
    }
  }

  /* A tap on a side cover scrolls it to the middle. */
  @media (prefers-reduced-motion: no-preference) {
    .library-flow-strip {
      scroll-behavior: smooth;
    }
  }

  .library-flow-cover .library-flow-face {
    width: 100%;
    box-shadow:
      0 0 0 1px var(--cover-edge),
      0 12px 28px -12px var(--scrim);
  }

  .library-flow-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 14px;
    text-align: center;
  }

  /* One line each, and an empty line keeps its place: the controls under it do not move. */
  .library-flow-info > * {
    max-width: 100%;
    min-height: 1.5em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .library-flow-position,
  .library-flow-line {
    color: var(--secondary);
    font-variant-numeric: tabular-nums;
  }

  .library-flow-position {
    font-size: 13px;
  }

  .library-flow-title {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .library-flow-title:hover {
    text-decoration: underline;
  }

  .library-flow-controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .library-flow-controls input {
    flex: 1;
    min-width: 0;
    min-height: var(--row);
    margin: 0;
    accent-color: var(--ink);
  }

  .library-flow-controls .button[aria-disabled='true'] {
    opacity: 0.6;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .library-flow-cover {
      transition: none;
    }
  }

  @media (min-width: 960px) {
    /* The toolbar sticks at a height that changes, so the letters do not stick under it. */
    .library-letter {
      position: static;
      padding: 18px 0 8px;
      background: none;
      color: var(--ink);
      font-size: 15px;
    }

    .library-row {
      grid-template-columns: 44px minmax(0, 2.4fr) minmax(0, 1.4fr) minmax(0, 1fr);
      grid-template-areas: 'cover main author status';
      align-items: center;
      column-gap: 16px;
    }

    .library-row-author {
      color: var(--ink);
      font-size: 14px;
    }

    .library-row-status {
      font-size: 13px;
    }

    /* The index is the last row of the toolbar, so it stays in reach while the list scrolls. */
    .library-index {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 2px;
      max-height: none;
      transform: none;
    }

    .library-index button {
      flex: none;
      width: 24px;
      height: var(--row);
      border-radius: var(--radius-control);
      font-size: 13px;
    }

    .library-index button:hover {
      background: var(--soft);
    }

    .library-flow {
      --flow-cover: 240px;
      --flow-near: 0.96;
      --flow-step: 0.29;
    }

    .library-flow-stage {
      margin: 0 -24px;
    }

    .library-flow-title {
      font-size: 24px;
    }

    .library-flow-controls {
      align-self: center;
      width: 100%;
      max-width: 560px;
    }
  }
</style>
