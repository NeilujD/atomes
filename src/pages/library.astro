---
// The Library in Grid, List and Cover flow, with the shared toolbar (src/islands/Library.tsx).
// Rendered on the device: it reads the Library, so it opens offline.
import AppShell from '../layouts/AppShell.astro';
import '../styles/correction.css';
import '../styles/glow.css';
import '../styles/selection.css';
import Library, { LibrarySkeleton } from '../islands/Library';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));
---

<AppShell title={t('library.title')} current="library">
  <Library client:only="preact">
    <LibrarySkeleton slot="fallback" />
  </Library>
</AppShell>

<style is:global>
  /* Global: the island renders on the device, outside this page's scoped styles.
     The one look (ADR 0018): the look comes from theme.css tokens and shared
     parts; the sizes of the Library's own boxes are named once, here. */
  .library {
    /* A cover in a List row. */
    --library-row-cover: 40px;
    /* Desktop toolbar: the search field, and each select of the controls. */
    --library-search: 200px;
    --library-search-max: 420px;
    --library-select-min: 130px;
    --library-select-max: 160px;
    /* The height of the view header the desktop toolbar sticks under (AppShell). */
    --library-header: 48px;
    /* The select over the phone mode icon: 16 px, as iOS zooms into a smaller field it focuses. */
    --library-select-text: 16px;
    --library-sheet-height: 85dvh;
    /* Phone: the A to Z rail, one letter. */
    --library-rail-letter: 16px;
    --library-rail-width: 20px;
    --library-rail-height: min(432px, 100dvh - 200px);
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .library-message {
    font-size: var(--type-body);
  }

  .library-add {
    align-self: flex-start;
  }

  /* Phone: the box of the glow (desktop: sticky, below). */
  .library-toolbar {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  /*
   * Cobalt blobs drift behind the top of the screen (ui-direction Q9): the
   * title and the toolbar, never the books or the Cover flow strip. Behind the
   * page content (z-index -1). Phone: from the bottom of the toolbar up past
   * the top of the page, fading out toward the books. Soft edges come from
   * radial gradients on a padded box, never a blur filter.
   */
  .library-glow {
    --tone: var(--accent);
    --tone-deep: var(--accent-fill);
    z-index: -1;
    inset: auto calc(var(--space-20) * -1) 0;
    height: calc(var(--glow-unit) * 40);
    overflow: hidden;
    mask-image: linear-gradient(black 85%, transparent);
  }

  /* The blobs (glow.css): where each sits. */
  .library-b1 {
    left: calc(var(--glow-unit) * -8);
    bottom: calc(var(--glow-unit) * -2);
    width: calc(var(--glow-unit) * 26);
    height: calc(var(--glow-unit) * 26);
  }

  .library-b2 {
    right: calc(var(--glow-unit) * -10);
    bottom: calc(var(--glow-unit) * -8);
    width: calc(var(--glow-unit) * 24);
    height: calc(var(--glow-unit) * 24);
  }

  .library-b3 {
    left: 30%;
    bottom: calc(var(--glow-unit) * -8);
    width: calc(var(--glow-unit) * 20);
    height: calc(var(--glow-unit) * 20);
  }

  .library-search-row {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .library-search {
    flex: 1;
    min-width: 0;
  }

  .library-search .field {
    width: 100%;
  }

  /* The Books / Series switch and the Grid / List / Cover flow switch (Segmented).
     Desktop: both in the search row. Phone: Books / Series is a row of its own,
     as wide as the screen; the mode is one icon in the search row (.library-view). */
  .library-toolbar > .library-switch {
    display: flex;
  }

  .library-toolbar > .library-switch .segment {
    flex: 1;
    justify-content: center;
  }

  .library-search-row .library-switch {
    flex: none;
  }

  /* Phone: the search toggle and the mode, round icon buttons (theme.css) as
     high as "Sort and filter". The mode shows the icon of the mode on; its
     native select lies over it, unseen, so a tap opens the system menu. */
  .library-view,
  .library-search-toggle,
  .library-filters,
  .library-select-start {
    position: relative;
    width: var(--row);
    height: var(--row);
  }

  .library-view select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    font-size: var(--library-select-text);
    cursor: pointer;
  }

  .library-view:has(select:focus-visible) {
    outline: var(--stroke) solid var(--accent);
    outline-offset: var(--stroke);
  }

  .library-count {
    color: var(--text-quiet);
    font-size: var(--type-small);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .library-clear {
    flex: none;
  }

  .library-count-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    min-height: var(--row);
  }

  /* "Sort and filter": a round icon button; the count of filters on sits on its top right corner. */
  .library-filters .library-badge {
    position: absolute;
    top: calc(var(--space-4) * -1);
    right: calc(var(--space-4) * -1);
  }

  .library-badge {
    display: inline-grid;
    place-items: center;
    min-width: var(--badge-height);
    height: var(--badge-height);
    padding: 0 var(--space-6);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--surface);
    font-size: var(--type-badge);
    font-variant-numeric: tabular-nums;
  }

  .library-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .library-selects {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
  }

  .library-select {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .library-select label {
    color: var(--text-quiet);
    font-size: var(--type-chip);
    font-weight: 600;
  }

  .library-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  /* A filter chip is the shared .chip (theme.css): pressed, it fills with ink, not cobalt. */
  .library-chip {
    max-width: 100%;
  }

  /* A long Label name stays on one line and ends with "…": the chip is never wider than its row. */
  .library-chip-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .library-chip-count {
    flex: none;
    opacity: var(--alpha-text-quiet);
    font-variant-numeric: tabular-nums;
  }

  .library-no-match {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    padding: calc(var(--space-24) * 2) var(--space-16);
    font-size: var(--type-body);
    font-weight: 600;
    text-align: center;
  }

  /* Phone: three covers a row. */
  .library-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-20) var(--space-14);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .library-book {
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }

  .library-cover {
    width: 100%;
    margin-bottom: var(--space-8);
  }

  .library-book-title,
  .library-book-line {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .library-book-title {
    font-size: var(--type-small);
    font-weight: 600;
  }

  .library-book-line {
    color: var(--text-quiet);
    font-size: var(--type-chip);
    font-variant-numeric: tabular-nums;
  }

  .library-book:hover .library-book-title {
    text-decoration: underline;
  }

  /* Series mode: each Series is a card (theme.css), padded little so the cover stays big. */
  .library-series {
    height: 100%;
    padding: var(--space-8);
  }

  /* A Work read with no Copy (CORE-100), in Grid, List and Cover flow: a grey,
     faint cover, and the shared "Not owned" chip (theme.css, Q8). Only the
     cover fades, so the text keeps its contrast. Picked in bulk select, it
     keeps its colours, so its ring stays cobalt (the filter would grey it). */
  .library-not-owned:not([aria-pressed='true']) .book-cover {
    filter: grayscale(1);
    opacity: var(--alpha-faded);
  }

  /* In the Grid: under the text, as wide as its words. A phone column (107 px
     at 390 px) is narrower than the chip: tighter padding, so "Non possédé"
     fits on one line at 390 px; narrower still, the words wrap inside it. */
  .library-book-mark {
    align-self: flex-start;
    gap: var(--space-4);
    max-width: 100%;
    margin-top: var(--space-4);
    padding: var(--space-4) var(--space-6);
    white-space: normal;
  }

  /* Phone: the controls in a sheet from the bottom. */
  .library-sheet {
    inset: auto 0 0;
    width: 100%;
    max-width: none;
    max-height: var(--library-sheet-height);
    margin: 0;
    padding: var(--space-20) var(--space-20) max(var(--space-20), env(safe-area-inset-bottom));
    border: 0;
    border-top: var(--hairline) solid var(--line);
    border-radius: var(--radius-panel) var(--radius-panel) 0 0;
    background: var(--surface);
    color: var(--ink);
  }

  .library-sheet[open] {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .library-sheet::backdrop {
    background: var(--scrim);
  }

  .library-sheet .library-selects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .library-sheet .field {
    width: 100%;
  }

  /* Desktop: the toolbar is a second header row, under the view header (ui-direction). */
  @media (min-width: 960px) {
    .library-toolbar {
      position: sticky;
      top: var(--library-header);
      z-index: 1;
      margin: calc(var(--space-24) * -1) calc(var(--space-24) * -1) 0;
      padding: var(--space-12) var(--space-24);
      background: var(--surface);
      border-bottom: var(--hairline) solid var(--line);
    }

    /* The glow fills the toolbar, behind its controls, and stops at its edge. */
    .library-glow {
      inset: 0;
      height: auto;
      mask-image: none;
    }

    /* The search keeps a width to type in. When the row is too long (a filter
       on, in a narrow window), the mode switch goes to a second line, still at the right. */
    .library-search-row {
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .library-search {
      flex: 1 1 var(--library-search);
      min-width: var(--library-search);
      max-width: var(--library-search-max);
    }

    .library-search-row .library-count {
      margin-left: auto;
    }

    /* In a narrow window the four selects get narrower, to stay on one line. */
    .library-select {
      flex: 1 1 var(--library-select-min);
      max-width: var(--library-select-max);
    }

    .library-select .field {
      width: 100%;
    }

    .library-grid {
      grid-template-columns: repeat(auto-fill, minmax(var(--grid-cover), 1fr));
      gap: var(--space-28) var(--space-24);
    }
  }
</style>

<style is:global>
  /* List and Cover flow (src/islands/LibraryList.tsx, LibraryCoverFlow.tsx). */

  /* List: letter groups on hairlines (ui-direction: list with groups). */
  .library-list {
    display: flex;
    flex-direction: column;
  }

  .library-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The letter is a small heading (theme.css). Phone: it stays on top while its books scroll. */
  .library-letter {
    position: sticky;
    top: env(safe-area-inset-top, 0);
    z-index: 1;
    padding: var(--space-10) 0 var(--space-6);
    border-bottom: var(--hairline) solid var(--line-card);
    background: var(--ground);
  }

  /* Phone: the author under the title. */
  .library-row {
    display: grid;
    grid-template-columns: var(--library-row-cover) minmax(0, 1fr) auto;
    grid-template-areas:
      'cover main status'
      'cover author status';
    align-content: center;
    column-gap: var(--space-12);
    padding: var(--space-8) 0;
    border-bottom: var(--hairline) solid var(--line-card);
    color: var(--ink);
    text-decoration: none;
  }

  .library-row-cover {
    grid-area: cover;
    align-self: center;
  }

  .library-row-main {
    grid-area: main;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .library-row-title,
  .library-row-line,
  .library-row-author {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .library-row-title {
    font-size: var(--type-body);
    font-weight: 600;
  }

  .library-row-line,
  .library-row-author {
    font-size: var(--type-small);
    font-variant-numeric: tabular-nums;
  }

  .library-row-author {
    grid-area: author;
    color: var(--text-quiet);
  }

  .library-row-status {
    grid-area: status;
    align-self: center;
    color: var(--text-quiet);
    font-size: var(--type-chip);
    white-space: nowrap;
  }

  .library-row:hover .library-row-title {
    text-decoration: underline;
  }

  /* The A to Z index. Phone: a rail on the right edge, in the margin of the
     page, one --library-rail-letter a letter, shorter on a short screen. */
  .library-index {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    max-height: var(--library-rail-height);
    transform: translateY(-50%);
  }

  .library-index button {
    flex: 0 1 var(--library-rail-letter);
    width: var(--library-rail-width);
    min-height: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-size: var(--type-badge);
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
  }

  /* Cover flow: one cover in front, the covers nearby turned on each side.
     `--flow-cover` is the widest the cover in front gets. */
  .library-flow {
    --flow-cover: 170px;
    /* Over and under the cover in front: its shadow. */
    --flow-room: 52px;
    /* The least height of the stage on a small screen, and the depth of the turn. */
    --flow-stage: 200px;
    --flow-depth: 900px;
    --flow-shadow: 0 12px 28px -12px var(--scrim);
    /* Phone: the track under the covers, and its thumb. */
    --flow-track: 160px;
    --flow-thumb: 24px;
    --flow-controls: 560px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  /* Cover flow takes the height the frame leaves, so Previous, the slider and
     Next show with no scroll: the stage gets what the toolbar, the text and
     the controls do not use, and the covers follow its height. */
  .panel:has(.library-flow) {
    display: flex;
    flex-direction: column;
  }

  .view-body:has(.library-flow) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .library:has(.library-flow) {
    flex: 1;
  }

  /* Phone: the page is as high as the screen; the tab bar is over its bottom padding. */
  @media (max-width: 959.98px) {
    .panel:has(.library-flow) {
      min-height: 100dvh;
    }
  }

  /* As wide as the panel: the covers on the sides go under its edges. On a
     small screen it keeps a height to see the covers, and the page scrolls.
     Every cover stands in the middle; the island turns and stacks each one as
     the reader drags (src/islands/LibraryCoverFlow.tsx). A drag across moves
     the covers; up or down, the page scrolls (pan-y). */
  .library-flow-stage {
    container-type: size;
    position: relative;
    flex: 1 1 0;
    min-height: var(--flow-stage);
    max-height: calc(var(--flow-cover) * 1.5 + var(--flow-room));
    margin: 0 calc(var(--space-20) * -1);
    overflow: hidden;
    perspective: var(--flow-depth);
    perspective-origin: 50% 40%;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    cursor: grab;
  }

  .library-flow-stage:active {
    cursor: grabbing;
  }

  .library-flow-cover,
  .library-flow-floor {
    --cover: min(var(--flow-cover), (100cqh - var(--flow-room)) * 2 / 3);
  }

  /* No underline: the default cover is text inside this link. */
  .library-flow-cover {
    position: absolute;
    top: var(--space-20);
    left: 50%;
    width: var(--cover);
    margin-left: calc(var(--cover) / -2);
    text-decoration: none;
    will-change: transform, opacity;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .library-flow-cover .library-flow-face {
    position: relative;
    width: 100%;
    -webkit-user-drag: none;
  }

  /* A big cover: --radius-cover-large corners, on the box with no image, on
     the image once it loads (theme.css), and on the shade below. */
  .library-flow-cover .library-flow-face:not([data-cover='loaded']),
  .library-flow-cover .library-flow-face[data-cover='loaded'] img {
    border-radius: var(--radius-cover-large);
    box-shadow:
      0 0 0 var(--hairline) var(--cover-edge),
      var(--flow-shadow);
  }

  /* The covers on the sides sink into the ground as they leave the front
     (`--shade`, set by the island). Over the image only, as the image is drawn
     in the cover box (theme.css). */
  .library-flow-face::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: min(100%, 150cqi * var(--cover-ratio, 2 / 3));
    aspect-ratio: var(--cover-ratio, 2 / 3);
    translate: -50% 0;
    border-radius: var(--radius-cover-large);
    background: var(--ground);
    opacity: var(--shade, 0);
    pointer-events: none;
  }

  /* The shadow the cover in front casts on the floor. */
  .library-flow-floor {
    position: absolute;
    top: calc(var(--cover) * 1.5);
    left: 50%;
    width: calc(var(--cover) * 1.33);
    height: calc(var(--space-20) * 2);
    margin-left: calc(var(--cover) * -0.665);
    border-radius: 50%;
    background: radial-gradient(ellipse, var(--scrim) 0%, transparent 70%);
    pointer-events: none;
  }

  /* Phone: where the book in front stands, a thumb on a track (no slider). */
  .library-flow-track {
    position: relative;
    align-self: center;
    width: var(--flow-track);
    height: var(--stroke);
    border-radius: var(--radius-pill);
    background: var(--shade-faint);
    overflow: hidden;
  }

  .library-flow-track span {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--flow-thumb);
    border-radius: var(--radius-pill);
    background: var(--ink);
    transform: translateX(calc(var(--flow-at) * (var(--flow-track) - var(--flow-thumb))));
    transition: transform var(--motion-slide) ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .library-flow-track span {
      transition: none;
    }
  }

  .library-flow-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: var(--type-body);
    text-align: center;
  }

  /* One line each, and an empty line keeps its place: the controls under it do not move. */
  .library-flow-info > * {
    max-width: 100%;
    min-height: 1lh;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .library-flow-position,
  .library-flow-line {
    color: var(--text-quiet);
    font-variant-numeric: tabular-nums;
  }

  .library-flow-position {
    font-size: var(--type-small);
  }

  /* As tall as the "Not owned" chip it may hold, so the controls under it do not move. */
  .library-flow-line {
    min-height: var(--chip-height);
  }

  /* The "Not owned" chip on a line of text (List, Cover flow): centred on the line. */
  .library-row-status .chip-not-owned,
  .library-flow-line .chip-not-owned {
    vertical-align: middle;
  }

  .library-flow-title {
    font-size: var(--type-heading);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }

  .library-flow-title:hover {
    text-decoration: underline;
  }

  .library-flow-controls {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .library-flow-controls input {
    flex: 1;
    min-width: 0;
    min-height: var(--row);
    margin: 0;
    accent-color: var(--ink);
  }

  @media (min-width: 960px) {
    .library {
      --library-row-cover: 44px;
    }

    /* The toolbar sticks at a height that changes, so the letters do not stick under it. */
    .library-letter {
      position: static;
      padding: var(--space-18) 0 var(--space-8);
      background: none;
    }

    .library-row {
      grid-template-columns: var(--library-row-cover) minmax(0, 2.4fr) minmax(0, 1.4fr) minmax(0, 1fr);
      grid-template-areas: 'cover main author status';
      align-items: center;
      column-gap: var(--space-16);
    }

    .library-row-author {
      color: var(--ink);
    }

    .library-row-status {
      font-size: var(--type-small);
    }

    /* The index is the last row of the toolbar, so it stays in reach while the list scrolls. */
    .library-index {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-4);
      max-height: none;
      transform: none;
    }

    .library-index button {
      flex: none;
      width: var(--space-24);
      height: var(--row);
      border-radius: var(--radius-control);
      font-size: var(--type-small);
    }

    .library-index button:hover {
      background: var(--fill-chip);
    }

    .library-flow {
      --flow-cover: 240px;
    }

    .library-flow-stage {
      margin: 0 calc(var(--space-24) * -1);
    }

    .library-flow-title {
      font-size: var(--type-title);
    }

    .library-flow-controls {
      align-self: center;
      width: 100%;
      max-width: var(--flow-controls);
    }
  }
</style>
