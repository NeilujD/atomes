---
// To Buy: the Volumes of the Followed Series the reader does not own and the
// Editions added by hand (src/islands/ToBuy.tsx). Rendered on the device: it
// reads the Library.
import AppShell from '../layouts/AppShell.astro';
import '../styles/glow.css';
import Icon from '../components/Icon.astro';
import ToBuy, { ToBuySkeleton } from '../islands/ToBuy';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));
---

<AppShell title={t('tobuy.title')} current="to-buy">
  <!-- The "+" opens Search, where the reader finds a book by its title or
       types its ISBN: a link, so it works before the scripts run. -->
  <a slot="actions" class="icon-button" href="/search" aria-label={t('tobuy.add-open')}>
    <Icon name="plus" />
  </a>
  <!-- Green blobs behind the top of the screen (Q9): nothing on To Buy is owned. -->
  <div class="glow to-buy-glow" aria-hidden="true">
    <span class="glow-blob glow-b1 to-buy-b1"></span>
    <span class="glow-blob glow-b2 to-buy-b2"></span>
    <span class="glow-blob glow-b3 to-buy-b3"></span>
  </div>
  <ToBuy client:only="preact">
    <ToBuySkeleton slot="fallback" />
  </ToBuy>
</AppShell>

<style is:global>
  /* Global: the island renders on the device, outside this page's scoped styles. */
  .to-buy {
    /* The size of this screen that has no token: the row thumbnail. */
    --to-buy-cover: 40px;
    max-width: var(--page-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-28);
  }

  .to-buy-message {
    font-size: var(--type-body);
  }

  .to-buy-hint {
    color: var(--text-quiet);
    font-size: var(--type-small);
  }

  .to-buy-hint[data-error] {
    color: var(--ink);
    font-weight: 600;
  }

  /*
   * The glow (Q9): it holds to the panel, so it scrolls away with the top of
   * the screen, and sits under the content (the panel isolates it). Soft
   * edges from radial gradients on padded boxes, as on Shelf Check; it fades
   * out before the lists.
   */
  [data-frame='panel']:has(.to-buy-glow) {
    position: relative;
    isolation: isolate;
  }

  .to-buy-glow {
    --tone: var(--not-owned);
    --tone-deep: var(--not-owned-deep);
    inset: 0 0 auto;
    z-index: -1;
    height: calc(var(--glow-unit) * 32);
    overflow: hidden;
    mask-image: linear-gradient(black var(--glow-stop-3), transparent);
  }

  /* The blobs (glow.css): where each sits. */
  .to-buy-b1 {
    left: calc(var(--glow-unit) * -8);
    top: calc(var(--glow-unit) * -10);
    width: calc(var(--glow-unit) * 30);
    height: calc(var(--glow-unit) * 30);
  }

  .to-buy-b2 {
    right: calc(var(--glow-unit) * -10);
    top: calc(var(--glow-unit) * -6);
    width: calc(var(--glow-unit) * 26);
    height: calc(var(--glow-unit) * 26);
  }

  .to-buy-b3 {
    left: calc(var(--glow-unit) * 10);
    top: calc(var(--glow-unit) * 2);
    width: calc(var(--glow-unit) * 20);
    height: calc(var(--glow-unit) * 20);
  }

  /* Groups: a small heading over cards (Q11, CORE-122). */
  .to-buy-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .to-buy-card {
    padding: var(--space-4) var(--space-16);
  }

  .to-buy-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .to-buy-item {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-12) 0;
  }

  .to-buy-item + .to-buy-item {
    border-top: var(--hairline) solid var(--line-card);
  }

  .to-buy-cover {
    flex: none;
    width: var(--to-buy-cover);
  }

  .to-buy-series {
    display: flex;
    flex-direction: column;
  }

  .to-buy-series-title {
    font-size: var(--type-body);
    font-weight: 600;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }

  /* One row per Series: a chevron, then "One Piece · 63 Volumes (51–113)". */
  .to-buy-series-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    width: calc(100% + 2 * var(--space-8));
    min-height: var(--row);
    margin: var(--space-4) calc(var(--space-8) * -1);
    padding: 0 var(--space-8);
    border: 0;
    border-radius: var(--radius-control);
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .to-buy-series-toggle:hover {
    background: var(--fill-chip);
  }

  .to-buy-chevron {
    flex: none;
    width: var(--icon-size-inline);
    height: var(--icon-size-inline);
    stroke-width: var(--icon-stroke);
    color: var(--text-quiet);
  }

  .to-buy-series-toggle[aria-expanded='true'] .to-buy-chevron {
    rotate: 90deg;
  }

  .to-buy-series-volumes {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-4);
  }

  .to-buy-series-link {
    align-self: flex-start;
    margin-top: var(--space-4);
    color: var(--text-quiet);
    font-size: var(--type-small);
    text-decoration-color: var(--line-link);
    text-underline-offset: var(--space-4);
  }

  .to-buy-more {
    align-self: flex-start;
    margin-bottom: var(--space-8);
  }

  .to-buy-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .to-buy-title {
    font-size: var(--type-body);
    font-weight: 600;
  }

  .to-buy-line {
    font-size: var(--type-small);
    font-variant-numeric: tabular-nums;
  }

  .to-buy-actions {
    flex: none;
    display: flex;
    gap: var(--space-4);
  }

  .to-buy-skeleton-title {
    width: 50%;
    height: var(--space-14);
  }

  .to-buy-skeleton-line {
    width: 30%;
    height: var(--space-12);
  }

  /* Phone: the actions go under the text, so long titles keep their room. */
  @media (max-width: 959px) {
    .to-buy-item {
      flex-wrap: wrap;
    }

    .to-buy-actions {
      width: 100%;
      padding-left: calc(var(--to-buy-cover) + var(--space-12));
    }
  }
</style>
