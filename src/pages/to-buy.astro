---
// To Buy: the Volumes of the Followed Series the reader does not own and the
// Editions added by hand (src/islands/ToBuy.tsx). Rendered on the device: it
// reads the Library.
import AppShell from '../layouts/AppShell.astro';
import ToBuy, { ToBuySkeleton } from '../islands/ToBuy';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));
---

<AppShell title={t('tobuy.title')} current="to-buy">
  <ToBuy client:only="preact">
    <ToBuySkeleton slot="fallback" />
  </ToBuy>
</AppShell>

<style is:global>
  /* Global: the island renders on the device, outside this page's scoped styles. */
  .to-buy {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .to-buy-message {
    font-size: 14px;
  }

  .to-buy-hint,
  .to-buy-empty {
    color: var(--secondary);
    font-size: 13px;
  }

  .to-buy-hint[data-error] {
    color: var(--ink);
    font-weight: 600;
  }

  .to-buy-add {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .to-buy-label {
    font-size: 14px;
    font-weight: 600;
  }

  .to-buy-add-row {
    display: flex;
    gap: 8px;
  }

  .to-buy-add-row .field {
    flex: 1;
    max-width: 280px;
  }

  .to-buy-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .to-buy-group-title {
    font-size: 18px;
  }

  .to-buy-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .to-buy-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }

  .to-buy-cover {
    flex: none;
    width: 40px;
  }

  .to-buy-series {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .to-buy-series + .to-buy-series {
    margin-top: 2px;
  }

  .to-buy-series-title {
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* One row per Series: a chevron, then "One Piece · 63 Volumes (51–113)". */
  .to-buy-series-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    min-height: var(--row);
    padding: 0 4px;
    border: 0;
    border-radius: var(--radius-control);
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .to-buy-series-toggle:hover {
    background: var(--soft);
  }

  .to-buy-series-toggle::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s ease-out;
  }

  .to-buy-series-toggle[aria-expanded='true']::before {
    transform: rotate(45deg);
  }

  .to-buy-series-volumes {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .to-buy-series-volumes[hidden] {
    display: none;
  }

  .to-buy-series-link {
    align-self: flex-start;
    font-size: 13px;
  }

  .to-buy-more {
    align-self: flex-start;
  }

  @media (prefers-reduced-motion: reduce) {
    .to-buy-series-toggle::before {
      transition: none;
    }
  }

  .to-buy-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .to-buy-title {
    font-size: 14px;
    font-weight: 600;
  }

  .to-buy-line {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .to-buy-actions {
    flex: none;
    display: flex;
    gap: 4px;
  }

  .to-buy-skeleton-title {
    width: 50%;
    height: 14px;
  }

  .to-buy-skeleton-line {
    width: 30%;
    height: 12px;
  }

  /* Phone: the actions go under the text, so long titles keep their room. */
  @media (max-width: 959px) {
    .to-buy-item {
      flex-wrap: wrap;
    }

    .to-buy-actions {
      width: 100%;
      padding-left: 52px;
    }
  }

  /* Desktop: groups read as list groups on a hairline (ui-direction). */
  @media (min-width: 960px) {
    .to-buy-group-title {
      display: flex;
      align-items: center;
      min-height: var(--row);
      border-bottom: 1px solid var(--line);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0;
    }
  }
</style>
