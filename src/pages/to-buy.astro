---
// To Buy: the Volumes of the Followed Series the reader does not own and the
// Editions added by hand (src/islands/ToBuy.tsx). Rendered on the device: it
// reads the Library.
import AppShell from '../layouts/AppShell.astro';
import Icon from '../components/Icon.astro';
import ToBuy, { ToBuySkeleton } from '../islands/ToBuy';
import { requestLanguage, translator } from '../lib/i18n/i18n';

const t = translator(requestLanguage(Astro.request));
---

<AppShell title={t('tobuy.title')} current="to-buy">
  <!-- The "+" opens the island's "Add by ISBN" sheet. Disabled until the list
       has loaded and the island has drawn the sheet; the island also wires the
       tap (ToBuy.tsx), so a tap before the scripts run is never lost. -->
  <button
    slot="actions"
    class="icon-button"
    type="button"
    disabled
    aria-label={t('tobuy.add-open')}
    aria-haspopup="dialog"
    aria-controls="to-buy-add-sheet"
    data-to-buy-open
  >
    <Icon name="plus" />
  </button>
  <!-- Green blobs behind the top of the screen (Q9): nothing on To Buy is owned. -->
  <div class="to-buy-glow" aria-hidden="true">
    <span class="to-buy-blob to-buy-b1"></span>
    <span class="to-buy-blob to-buy-b2"></span>
    <span class="to-buy-blob to-buy-b3"></span>
  </div>
  <ToBuy client:only="preact">
    <ToBuySkeleton slot="fallback" />
  </ToBuy>
</AppShell>

<style is:global>
  /* Global: the island renders on the device, outside this page's scoped styles. */
  .to-buy {
    /* The sizes of this screen that have no token: the column and the row thumbnail. */
    --to-buy-width: 880px;
    --to-buy-cover: 40px;
    max-width: var(--to-buy-width);
    display: flex;
    flex-direction: column;
    gap: var(--space-28);
  }

  .to-buy-message {
    font-size: var(--type-body);
  }

  .to-buy-hint,
  .to-buy-empty {
    color: var(--text-quiet);
    font-size: var(--type-small);
  }

  .to-buy-hint[data-error] {
    color: var(--ink);
    font-weight: 600;
  }

  /*
   * The glow (Q9): it holds to the panel, so it scrolls away with the top of
   * the screen, and sits under the content (the panel isolates it). Soft
   * edges from radial gradients on padded boxes, as on Shelf Check; it fades
   * out before the lists.
   */
  [data-frame='panel']:has(.to-buy-glow) {
    position: relative;
    isolation: isolate;
  }

  .to-buy-glow {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: calc(var(--glow-unit) * 32);
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(black var(--glow-stop-3), transparent);
  }

  /* In light, a glow shows at --glow-light of its colour. */
  .to-buy-blob {
    --blob: var(--not-owned);
    --glow: light-dark(color-mix(in oklab, var(--blob) var(--glow-light), transparent), var(--blob));
    position: absolute;
    box-sizing: content-box;
    margin: calc(var(--glow-pad-blob) * -1);
    padding: var(--glow-pad-blob);
    background: radial-gradient(
      circle closest-side,
      color-mix(in oklab, var(--glow) var(--glow-alpha-1), transparent),
      color-mix(in oklab, var(--glow) var(--glow-alpha-2), transparent) var(--glow-stop-2),
      color-mix(in oklab, var(--glow) var(--glow-alpha-3), transparent) var(--glow-stop-3),
      color-mix(in oklab, var(--glow) var(--glow-alpha-4), transparent) var(--glow-stop-4),
      transparent
    );
    will-change: transform;
  }

  .to-buy-b1 {
    left: calc(var(--glow-unit) * -8);
    top: calc(var(--glow-unit) * -10);
    width: calc(var(--glow-unit) * 30);
    height: calc(var(--glow-unit) * 30);
    opacity: var(--glow-opacity-1);
    animation: toBuyDrift1 var(--motion-drift-1) ease-in-out infinite;
  }

  .to-buy-b2 {
    right: calc(var(--glow-unit) * -10);
    top: calc(var(--glow-unit) * -6);
    width: calc(var(--glow-unit) * 26);
    height: calc(var(--glow-unit) * 26);
    opacity: var(--glow-opacity-2);
    animation: toBuyDrift2 var(--motion-drift-2) ease-in-out infinite;
  }

  .to-buy-b3 {
    --blob: var(--not-owned-deep);
    left: calc(var(--glow-unit) * 10);
    top: calc(var(--glow-unit) * 2);
    width: calc(var(--glow-unit) * 20);
    height: calc(var(--glow-unit) * 20);
    opacity: var(--glow-opacity-3);
    animation: toBuyDrift3 var(--motion-drift-3) ease-in-out infinite;
  }

  /* Groups: a small heading over cards (Q11, CORE-122). */
  .to-buy-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .to-buy-card {
    padding: var(--space-4) var(--space-16);
  }

  .to-buy-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .to-buy-item {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-12) 0;
  }

  .to-buy-item + .to-buy-item {
    border-top: var(--hairline) solid var(--line-card);
  }

  .to-buy-cover {
    flex: none;
    width: var(--to-buy-cover);
  }

  .to-buy-series {
    display: flex;
    flex-direction: column;
  }

  .to-buy-series-title {
    font-size: var(--type-body);
    font-weight: 600;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }

  /* One row per Series: a chevron, then "One Piece · 63 Volumes (51–113)". */
  .to-buy-series-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    width: calc(100% + 2 * var(--space-8));
    min-height: var(--row);
    margin: var(--space-4) calc(var(--space-8) * -1);
    padding: 0 var(--space-8);
    border: 0;
    border-radius: var(--radius-control);
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .to-buy-series-toggle:hover {
    background: var(--fill-chip);
  }

  .to-buy-chevron {
    flex: none;
    width: var(--icon-size-inline);
    height: var(--icon-size-inline);
    stroke-width: var(--icon-stroke);
    color: var(--text-quiet);
  }

  .to-buy-series-toggle[aria-expanded='true'] .to-buy-chevron {
    rotate: 90deg;
  }

  .to-buy-series-volumes {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-4);
  }

  .to-buy-series-link {
    align-self: flex-start;
    margin-top: var(--space-4);
    color: var(--text-quiet);
    font-size: var(--type-small);
    text-decoration-color: var(--line-link);
    text-underline-offset: var(--space-4);
  }

  .to-buy-more {
    align-self: flex-start;
    margin-bottom: var(--space-8);
  }

  .to-buy-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .to-buy-title {
    font-size: var(--type-body);
    font-weight: 600;
  }

  .to-buy-line {
    font-size: var(--type-small);
    font-variant-numeric: tabular-nums;
  }

  /* "Not owned" (Q8): green, with a check. */
  .to-buy-mark {
    background: color-mix(in srgb, var(--not-owned) var(--alpha-tone-fill), transparent);
    color: var(--not-owned-text);
  }

  .to-buy-mark svg {
    flex: none;
    width: var(--icon-size-inline);
    height: var(--icon-size-inline);
    stroke-width: var(--icon-stroke);
  }

  .to-buy-actions {
    flex: none;
    display: flex;
    gap: var(--space-4);
  }

  .to-buy-skeleton-title {
    width: 50%;
    height: var(--space-14);
  }

  .to-buy-skeleton-line {
    width: 30%;
    height: var(--space-12);
  }

  /* Phone: the actions go under the text, so long titles keep their room. */
  @media (max-width: 959px) {
    .to-buy-item {
      flex-wrap: wrap;
    }

    .to-buy-actions {
      width: 100%;
      padding-left: calc(var(--to-buy-cover) + var(--space-12));
    }
  }

  /* The "Add by ISBN" sheet: a raised card from the bottom on the phone, in the middle on desktop. */
  .to-buy-sheet {
    inset: auto 0 0;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: var(--space-24) var(--space-20) max(var(--space-20), env(safe-area-inset-bottom));
    border: var(--hairline) solid var(--line-card);
    border-bottom: 0;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background: linear-gradient(var(--fill-card), var(--fill-card)), var(--surface);
    color: var(--ink);
  }

  .to-buy-sheet::backdrop {
    background: var(--scrim);
  }

  .to-buy-add {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .to-buy-label {
    font-size: var(--type-heading);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
  }

  .to-buy-add-row {
    display: flex;
    gap: var(--space-8);
  }

  .to-buy-add-row .field {
    flex: 1;
  }

  @media (min-width: 960px) {
    .to-buy-sheet {
      inset: 0;
      width: min(100% - 2 * var(--space-16), var(--confirm-width));
      margin: auto;
      padding: var(--space-24);
      border-bottom: var(--hairline) solid var(--line-card);
      border-radius: var(--radius-card);
    }
  }

  @keyframes toBuyDrift1 {
    50% {
      transform: translate(50px, 30px) scale(1.15);
    }
  }

  @keyframes toBuyDrift2 {
    50% {
      transform: translate(-50px, 20px) scale(0.9);
    }
  }

  @keyframes toBuyDrift3 {
    50% {
      transform: translate(30px, -20px) scale(1.15);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .to-buy-blob {
      animation: none;
    }
  }
</style>
