---
// The <head> parts every page shares: the app frame (AppShell) and the
// Landing page (Landing.astro). `boot` runs before first paint; the CSP
// (ADR 0013) allows it by its hash. A page adds its own tags in the slot.
import { createHash } from 'node:crypto';
import { appIcons } from '../lib/environment';
import { appEnvironment, rybbit } from '../lib/server/settings';

interface Props {
  title: string;
  boot: string;
}

const { title, boot } = Astro.props;
// Astro hashes its own scripts, not `is:inline` ones. No CSP in `astro dev`, so no `Astro.csp`.
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(boot).digest('base64')}`);
// Outside production, the favicon and home screen icon are orange (src/lib/environment.ts).
const icons = appIcons(appEnvironment(process.env));
// Audience measurement, where the instance sets it (RYBBIT_*, settings.ts): the
// CSP lets the script load from its host and send its events there.
const analytics = rybbit(process.env);
if (analytics) {
  Astro.csp?.insertScriptResource(analytics.origin);
  Astro.csp?.insertDirective(`connect-src 'self' ${analytics.origin}`);
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" data-theme="light" media="(prefers-color-scheme: light)" content="#f6f6f3" />
<meta name="theme-color" data-theme="dark" media="(prefers-color-scheme: dark)" content="#121317" />
<script is:inline set:html={boot} />
<link rel="icon" type="image/svg+xml" href={icons.favicon} />
<link rel="icon" type="image/png" sizes="32x32" href={icons.favicon32} />
<link rel="apple-touch-icon" href={icons.appleTouch} />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
{analytics && <script is:inline src={analytics.scriptUrl} data-site-id={analytics.siteId} defer />}
<slot />
