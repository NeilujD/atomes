---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 16 } = Astro.props;
const LucideIcon = icons[name];
// Stroke 2, the lucide default, is --icon-stroke (theme.css); a round icon button sets 20 px from CSS.
---

<LucideIcon size={size} aria-hidden="true" />
