---
// "staging", "preview" or "local": a grey pill outside production, so the
// reader never changes production data by mistake (ui-direction: Environment
// badge). Nothing in production. AppShell puts one next to the wordmark
// (desktop), one at the top of the phone screen, and one on Flow screens.
import { requestLanguage, translator } from '../lib/i18n/i18n';
import { appEnvironment } from '../lib/server/settings';

interface Props {
  place: 'sidebar' | 'top' | 'flow';
}

const { place } = Astro.props;
const appEnv = appEnvironment(process.env);
const t = translator(requestLanguage(Astro.request));
---

{
  appEnv !== 'production' && (
    <p class:list={['environment', place]}>
      <span class="pill">{t(`environment.${appEnv}`)}</span>
    </p>
  )
}

<style>
  /*
   * Grey, not a colour role: cobalt is for New Volumes and links. Lowercase in the strings themselves, in the tech font,
   * with no letter spacing.
   */
  .pill {
    display: inline-block;
    padding: 0 var(--space-8);
    border-radius: var(--radius-pill);
    background: var(--soft);
    color: var(--secondary);
    font-family: var(--font-tech);
    font-size: var(--type-badge);
    font-weight: 500;
    line-height: var(--badge-height);
    white-space: nowrap;
  }

  .sidebar {
    margin-right: auto;
    margin-left: var(--space-8);
  }

  /* Phone: above the large title, in the safe area. Desktop: the sidebar has its own. */
  .top {
    display: flex;
    justify-content: center;
    padding: max(var(--space-8), env(safe-area-inset-top)) var(--space-20) 0;
  }

  @media (min-width: 960px) {
    .top {
      display: none;
    }
  }

  /* Flow (no chrome, content centred): in its own row above the content
     (AppShell), so it scrolls away with the page and covers nothing. */
  .flow {
    display: flex;
    justify-content: center;
    margin: 0 0 var(--space-16);
  }
</style>
