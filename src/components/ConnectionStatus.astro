---
// "Offline", the saves that wait on this device, and Reconnect as an icon (src/lib/connection.ts).
// Shown only while offline. AppShell puts one in the sidebar (desktop) and one
// above the tab bar (phone); the other one is not displayed, so it is not read out.
import { requestLanguage, translator } from '../lib/i18n/i18n';
import Icon from './Icon.astro';

interface Props {
  place: 'sidebar' | 'bar';
}

const { place } = Astro.props;
const t = translator(requestLanguage(Astro.request));
---

<div class:list={['connection', place]} data-connection role="status">
  <div class="body" data-connection-body hidden>
    <p class="state">
      <Icon name="wifi-off" />
      <span>{t('connection.offline')}</span>
    </p>
    <p class="waiting" data-connection-waiting></p>
    <button
      class="button reconnect"
      type="button"
      data-reconnect
      aria-label={t('connection.reconnect')}
      title={t('connection.reconnect')}
    >
      <Icon name="refresh-cw" />
    </button>
  </div>
</div>

<style>
  /* Grey and quiet, not a colour role: offline, Atomes still works, partly. */
  .body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: var(--fill-card);
    color: var(--secondary);
  }

  .state {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font-size: 13px;
    font-weight: 500;
  }

  .waiting {
    margin-right: auto;
    font-size: 13px;
    font-weight: 500;
  }

  .waiting:empty {
    display: none;
  }

  .waiting::before {
    content: '· ';
  }

  /* The icon alone: a square as tall as a button; its name is the label and the tooltip. */
  .reconnect,
  .reconnect:hover:not(:disabled) {
    width: var(--button-height);
    padding: 0;
    border-color: transparent;
    background: transparent;
    color: var(--secondary);
    --busy-ink: var(--secondary);
  }

  .reconnect:hover:not(:disabled) {
    background: var(--fill-chip);
    color: var(--ink);
  }

  /* Busy: the spinner alone (theme.css), whatever order the styles load in. */
  .reconnect[aria-busy='true'] {
    color: transparent;
  }

  /*
   * Desktop: over the free space at the bottom of the sidebar, right above
   * Settings, so nothing in the sidebar moves when it shows.
   */
  .sidebar {
    position: absolute;
    inset: auto 0 100%;
    margin-bottom: 8px;
  }

  .state :global(svg) {
    flex: none;
  }

  .sidebar .body {
    flex-wrap: wrap;
    row-gap: 0;
    padding: 2px 0 2px 8px;
    border-radius: var(--radius-control);
  }

  /* The sidebar is narrow: the waiting saves go on a second line, under "Offline". */
  .sidebar .waiting {
    order: 1;
    flex-basis: 100%;
    margin: -6px 0 4px;
    padding-left: 24px;
  }

  .sidebar .waiting::before {
    content: none;
  }

  /* Phone: a strip on top of the tab bar, under the thumb, never over the content. */
  .bar .body {
    padding: 0 12px 0 20px;
    border-top: var(--hairline) solid var(--line);
  }
</style>
